#!/usr/bin/env python3
"""Local-stats + live-limit Codex usage collector for the Aurelia agents panel.

Token totals come from the per-turn `token_count` events in Codex rollout
transcripts under $CODEX_HOME/sessions. The rolling rate-limit meters and the
plan come from the Codex app-server's `account/rateLimits/read` RPC, which
queries the account live — rollout files only ever carry a snapshot from the
last session and go stale the moment a window resets.

Prints one display-ready JSON record (the same contract as the other
ai-usage-* collectors).
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import select
import shutil
import subprocess
import time
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import ai_usage_common as common  # noqa: E402

AGENT_ID = "codex"
AGENT_NAME = "Codex"
AUTH_HELP = "Run `codex login` to enable live Codex rate limits."


def codex_home() -> Path:
    value = os.environ.get("CODEX_HOME") or "~/.codex"
    return Path(os.path.expandvars(os.path.expanduser(value)))


def number(value) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def local_date_string() -> str:
    return dt.datetime.now().strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
    today = dt.datetime.now().date()
    return [(today - dt.timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def local_date_from_timestamp(value) -> str:
    text = str(value or "").strip()
    if text:
        try:
            parsed = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
            if parsed.tzinfo is not None:
                parsed = parsed.astimezone()
            return parsed.strftime("%Y-%m-%d")
        except Exception:
            pass
    return local_date_string()


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


# ---------------------------------------------------------------- live limits


def find_command(name: str) -> str:
    found = shutil.which(name)
    if found:
        return found
    candidate = Path.home() / ".local" / "bin" / name
    return str(candidate) if candidate.is_file() else ""


def rpc_request(proc, request_id: int, method: str, params=None, timeout: float = 8) -> dict:
    proc.stdin.write(json.dumps({"id": request_id, "method": method, "params": params or {}}) + "\n")
    proc.stdin.flush()
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        ready, _, _ = select.select([proc.stdout], [], [], 0.25)
        if not ready:
            continue
        line = proc.stdout.readline()
        if not line:
            break
        try:
            message = json.loads(line)
        except Exception:
            continue
        if message.get("id") == request_id:
            return message
    raise TimeoutError(method)


def limit_window(window) -> dict | None:
    if not isinstance(window, dict):
        return None
    used = window.get("usedPercent")
    if used is None:
        return None
    minutes = number(window.get("windowDurationMins"))
    if minutes == 10080:
        label = "Weekly (7-day)"
    elif minutes == 43200:
        label = "Monthly (30-day)"
    elif minutes and minutes % 60 == 0:
        label = f"{minutes // 60}h window"
    elif minutes:
        label = f"{minutes}m window"
    else:
        label = "Limit"
    reset = number(window.get("resetsAt"))
    return {
        "label": label,
        "percent": float(used) / 100.0,
        "resetsAt": dt.datetime.fromtimestamp(reset, dt.timezone.utc).isoformat() if reset else "",
        "windowMinutes": minutes,
    }


def fetch_codex_rpc() -> dict:
    result = {"limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": ""}
    codex = os.environ.get("CODEX_BIN") or find_command("codex")
    if not codex:
        result["usageStatusText"] = "Codex unavailable"
        result["authHelpText"] = "codex not found in PATH"
        return result

    try:
        proc = subprocess.Popen(
            [codex, "-s", "read-only", "-a", "on-request", "app-server"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            env=dict(os.environ),
        )
    except Exception as exc:
        result["usageStatusText"] = "Codex unavailable"
        result["authHelpText"] = str(exc)
        return result

    try:
        rpc_request(proc, 1, "initialize", {"clientInfo": {"name": "aurelia-agent-usage", "version": "1"}}, timeout=8)
        proc.stdin.write(json.dumps({"method": "initialized", "params": {}}) + "\n")
        proc.stdin.flush()
        account_msg = rpc_request(proc, 2, "account/read", timeout=5)
        limits_msg = rpc_request(proc, 3, "account/rateLimits/read", timeout=5)

        account = (account_msg.get("result") or {}).get("account") or {}
        limits = (limits_msg.get("result") or {}).get("rateLimits") or {}
        plan = limits.get("planType") or account.get("planType") or account.get("type") or ""
        result["tierLabel"] = str(plan) if plan else ""

        for window in (limits.get("primary"), limits.get("secondary")):
            entry = limit_window(window)
            if entry:
                result["limits"].append(entry)
        if not result["limits"]:
            result["usageStatusText"] = "Codex limits unavailable"
    except Exception as exc:
        result["usageStatusText"] = "Codex limits unavailable"
        result["authHelpText"] = str(exc)
    finally:
        try:
            proc.terminate()
            proc.wait(timeout=1)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
    return result


# ---------------------------------------------------------------- local scan


def scan_sessions(sessions_path: Path) -> dict:
    today = local_date_string()
    recent_dates = recent_date_strings()
    recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}

    seen: set[tuple[str, str]] = set()
    sessions: set[str] = set()
    active_days: set[str] = set()
    today_sessions: set[str] = set()
    today_tokens: dict[str, int] = {}
    usage_by_model: dict[str, dict[str, int]] = {}
    prompts = 0
    today_prompt_count = 0
    today_token_total = 0

    files = sorted(sessions_path.rglob("rollout-*.jsonl")) if sessions_path.is_dir() else []
    for path in files:
        session_id = path.stem
        model = "codex"
        turn_id = ""
        try:
            with path.open("r", encoding="utf-8", errors="replace") as handle:
                for line_number, line in enumerate(handle, 1):
                    if '"token_count"' not in line and '"turn_context"' not in line:
                        continue
                    try:
                        entry = json.loads(line)
                    except Exception:
                        continue

                    if entry.get("type") == "turn_context":
                        payload = entry.get("payload")
                        if isinstance(payload, dict):
                            turn_id = str(payload.get("turn_id") or turn_id)
                            model = str(payload.get("model") or model)
                        continue

                    payload = entry.get("payload")
                    if not isinstance(payload, dict) or payload.get("type") != "token_count":
                        continue

                    info = payload.get("info") if isinstance(payload.get("info"), dict) else {}
                    last = info.get("last_token_usage") if isinstance(info.get("last_token_usage"), dict) else {}
                    input_tokens = number(last.get("input_tokens"))
                    output_tokens = number(last.get("output_tokens"))
                    cache_read = number(last.get("cached_input_tokens"))
                    cache_write = number(last.get("cache_write_input_tokens"))
                    total = input_tokens + output_tokens + cache_read + cache_write

                    unique_key = (session_id, turn_id or f"line{line_number}")
                    if unique_key in seen:
                        continue
                    seen.add(unique_key)
                    if total <= 0:
                        continue

                    day = local_date_from_timestamp(entry.get("timestamp"))
                    sessions.add(session_id)
                    active_days.add(day)
                    prompts += 1

                    bucket = usage_by_model.setdefault(model, empty_bucket())
                    bucket["inputTokens"] += input_tokens
                    bucket["outputTokens"] += output_tokens
                    bucket["cacheReadInputTokens"] += cache_read
                    bucket["cacheCreationInputTokens"] += cache_write

                    if day in recent:
                        recent[day]["messageCount"] += total

                    if day == today:
                        today_prompt_count += 1
                        today_sessions.add(session_id)
                        today_token_total += total
                        today_tokens[model] = today_tokens.get(model, 0) + total
        except Exception as exc:  # pragma: no cover - unreadable files only
            print(f"Ignoring unreadable Codex session file {path}: {exc}", file=sys.stderr)

    return {
        "todayPrompts": today_prompt_count,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_token_total,
        "todayTokensByModel": today_tokens,
        "recentDays": [recent[day] for day in recent_dates],
        "modelUsage": usage_by_model,
        "totalPrompts": prompts,
        "totalSessions": len(sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true", help="accepted for collector parity")
    parser.add_argument("--limits-only", action="store_true", help="accepted for collector parity")
    parser.parse_args()

    home = codex_home()
    stats = common.merge_stats(scan_sessions(home / "sessions"), common.scan_pi_sessions(["codex"]))
    rpc = fetch_codex_rpc()
    detected = home.is_dir() or bool(stats.get("detected"))

    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "detected": detected,
        "hasLocalStats": detected,
        "hasPromptStats": True,
        "ready": number(stats.get("totalPrompts")) > 0 or len(rpc.get("limits") or []) > 0,
        "limits": rpc.get("limits") or [],
        "tierLabel": rpc.get("tierLabel") or "",
        "usageStatusText": rpc.get("usageStatusText") or "",
        "authHelpText": rpc.get("authHelpText") or "",
    }
    record.update(stats)
    record["detected"] = detected
    record["hasLocalStats"] = detected
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
