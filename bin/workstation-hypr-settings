#!/usr/bin/env bash
# workstation-hypr-settings — user-owned Hyprland settings overlay backend.
#
# Single mutation owner for the user Hyprland settings overlay:
#   $XDG_CONFIG_HOME/fedora-hyprland-workstation/hypr-settings.lua
#   (default: ~/.config/fedora-hyprland-workstation/hypr-settings.lua)
#
# The overlay is user-owned DATA. The repository baseline under dotfiles/hypr
# remains the reviewed desired state; dotfiles/hypr/hyprland.lua loads the
# overlay at config time (fail closed) so `hyprctl reload` restores the user's
# settings on reload and at the next session.
#
# Safety invariants:
#   * strict option schema: unknown ids and invalid values fail closed
#   * atomic writes (mktemp + rename), 0600, idempotent no-op writes
#   * bounded external operations (timeout around every hyprctl call)
#   * path safety: absolute XDG_CONFIG_HOME, no symlinked parents,
#     no privileged system paths
#   * live preview: hyprctl keyword for leaf options; hyprctl reload for
#     structural settings (animation presets, workspace pins)
#   * every changed value is observable; apply failures are reported, never
#     hidden behind `|| true`

set -Eeuo pipefail

PROG="workstation-hypr-settings"
MARKER="WORKSTATION_HYPR_SETTINGS_MANAGED_V1"
SCHEMA_VERSION=1

# ---------------------------------------------------------------------------
# Bounded external operations
# ---------------------------------------------------------------------------
TIME_BIN="${WORKSTATION_HYPR_SETTINGS_TIMEOUT_BIN:-$(command -v timeout || true)}"
if [[ -z "$TIME_BIN" ]]; then
    printf '%s\n' "Error: timeout is required." >&2
    exit 1
fi

hyprctl_bin="${WORKSTATION_HYPR_SETTINGS_HYPRCTL_BIN:-$(command -v hyprctl || true)}"

bounded_hyprctl() {
    if [[ -z "$hyprctl_bin" ]]; then
        return 127
    fi
    "$TIME_BIN" --kill-after=1s 3s "$hyprctl_bin" "$@"
}

# ---------------------------------------------------------------------------
# Paths (fail closed on unsafe environments)
# ---------------------------------------------------------------------------
home="${HOME:-}"
if [[ "$home" != /* || "$home" == "/" || ! -d "$home" || -L "$home" ]]; then
    printf '%s\n' "Error: HOME is missing or unsafe." >&2
    exit 1
fi

config_home="${XDG_CONFIG_HOME:-$home/.config}"
if [[ "$config_home" != /* || "$config_home" == "/" ]]; then
    printf '%s\n' "Error: XDG_CONFIG_HOME is not an absolute non-root path." >&2
    exit 1
fi
if [[ -e "$config_home" && -L "$config_home" ]]; then
    printf '%s\n' "Error: XDG_CONFIG_HOME must not be a symlink." >&2
    exit 1
fi

settings_path="${WORKSTATION_HYPR_SETTINGS_PATH:-$config_home/fedora-hyprland-workstation/hypr-settings.lua}"
if [[ "$settings_path" != /* || "$settings_path" == "/" ]]; then
    printf '%s\n' "Error: settings overlay path must be absolute and non-root." >&2
    exit 1
fi
if [[ "$settings_path" == *"/../"* || "$settings_path" == *"/.." ]]; then
    printf '%s\n' "Error: settings overlay path must not contain traversal components." >&2
    exit 1
fi
if [[ "$settings_path" == /etc/* || "$settings_path" == /usr/* || "$settings_path" == /var/* ]]; then
    printf '%s\n' "Error: privileged system paths are not allowed for user settings." >&2
    exit 1
fi
settings_dir="$(dirname -- "$settings_path")"

# ---------------------------------------------------------------------------
# Option schema registry
# ---------------------------------------------------------------------------
# Fields: id|hypr-leaf|type|min|max|enum|category|default|label|description
# Types: bool, int, float, str, enum, color
# A hypr-leaf of "-" means the option is structural (reload only).
# A default of "-" means the default is dynamic (read from live state).
option_specs() {
    cat <<'EOF'
general.gaps_in|general:gaps_in|int|0|64||general|3|Gaps In|Window gap between tiled windows
general.gaps_out|general:gaps_out|int|0|64||general|6|Gaps Out|Window gap at screen edges
general.gaps_workspaces|general:gaps_workspaces|int|0|64||general|0|Workspace Gaps|Gap between adjacent workspaces
general.border_size|general:border_size|int|0|16||general|2|Border Size|Window border thickness in pixels
general.resize_on_border|general:resize_on_border|bool||||general|true|Resize on Border|Resize windows by dragging the border
general.layout|general:layout|enum|||dwindle,master|general|dwindle|Layout|Window layout algorithm
general.snap.enabled|general:snap:enabled|bool||||general|true|Snap Assistant|Show resize/layout snapping assistant
general.allow_tearing|general:allow_tearing|bool||||general|false|Allow Tearing|Allow tearing for fullscreen games
general.col.active_border|general:col.active_border|color||||general|-|Active Border Color|Color of the focused window border
general.col.inactive_border|general:col.inactive_border|color||||general|-|Inactive Border Color|Color of unfocused window borders
decoration.rounding|decoration:rounding|int|0|24||decoration|8|Corner Rounding|Window corner radius in pixels
decoration.rounding_power|decoration:rounding_power|float|1|8||decoration|2.0|Rounding Power|Rounding curve exponent
decoration.active_opacity|decoration:active_opacity|float|0.1|1||decoration|1.0|Active Opacity|Opacity of focused windows
decoration.inactive_opacity|decoration:inactive_opacity|float|0.1|1||decoration|1.0|Inactive Opacity|Opacity of unfocused windows
decoration.fullscreen_opacity|decoration:fullscreen_opacity|float|0.1|1||decoration|1.0|Fullscreen Opacity|Opacity of fullscreen windows
decoration.dim_inactive|decoration:dim_inactive|bool||||decoration|false|Dim Inactive|Dim unfocused windows
decoration.dim_strength|decoration:dim_strength|float|0|1||decoration|0.5|Dim Strength|Dimming amount for inactive windows
decoration.shadow.enabled|decoration:shadow:enabled|bool||||decoration|true|Shadows|Draw window shadows
decoration.shadow.range|decoration:shadow:range|int|0|64||decoration|4|Shadow Range|Shadow size in pixels
decoration.shadow.render_power|decoration:shadow:render_power|int|1|4||decoration|3|Shadow Render Power|Shadow falloff exponent
decoration.shadow.color|decoration:shadow:color|color||||decoration|-|Shadow Color|Window shadow color
decoration.blur.enabled|decoration:blur:enabled|bool||||decoration|false|Blur|Blur windows behind translucent surfaces
decoration.blur.size|decoration:blur:size|int|1|16||decoration|8|Blur Size|Blur radius in pixels
decoration.blur.passes|decoration:blur:passes|int|0|8||decoration|1|Blur Passes|Number of blur passes
decoration.blur.new_optimizations|decoration:blur:new_optimizations|bool||||decoration|true|Blur Optimizations|Use the optimized blur path
decoration.blur.xray|decoration:blur:xray|bool||||decoration|false|Blur X-Ray|Blur only the wallpaper behind windows
decoration.blur.vibrancy|decoration:blur:vibrancy|float|0|1||decoration|0.17|Blur Vibrancy|Vibrancy of blurred content
decoration.blur.popups|decoration:blur:popups|bool||||decoration|true|Blur Popups|Blur popup windows
decoration.blur.special|decoration:blur:special|bool||||decoration|false|Blur Special|Blur special workspaces
decoration.blur.ignore_opacity|decoration:blur:ignore_opacity|bool||||decoration|false|Blur Ignore Opacity|Blur regardless of window opacity
misc.vrr|misc:vrr|enum|||0,1,2|misc|0|Variable Refresh Rate|0 off, 1 on, 2 fullscreen only
misc.disable_hyprland_logo|misc:disable_hyprland_logo|bool||||misc|false|Disable Hyprland Logo|Hide the background logo
misc.force_default_wallpaper|misc:force_default_wallpaper|int|0|2||misc|1|Default Wallpaper|Splash wallpaper variant
misc.disable_splash_rendering|misc:disable_splash_rendering|bool||||misc|false|Disable Splash|Hide the splash on start
misc.focus_on_activate|misc:focus_on_activate|bool||||misc|false|Focus on Activate|Focus windows that request activation
misc.mouse_move_enables_dpms|misc:mouse_move_enables_dpms|bool||||misc|false|Mouse Wakes Display|Mouse movement wakes the display
misc.key_press_enables_dpms|misc:key_press_enables_dpms|bool||||misc|false|Key Wakes Display|Key presses wake the display
misc.animate_manual_resizes|misc:animate_manual_resizes|bool||||misc|false|Animate Manual Resizes|Animate manual window resizes
misc.animate_mouse_windowdragging|misc:animate_mouse_windowdragging|bool||||misc|false|Animate Mouse Drag|Animate mouse window dragging
misc.enable_swallow|misc:enable_swallow|bool||||misc|false|Window Swallowing|Hide a terminal while its child window is open
misc.close_special_on_empty|misc:close_special_on_empty|bool||||misc|true|Close Empty Special|Close the special workspace when it becomes empty
misc.on_focus_under_fullscreen|misc:on_focus_under_fullscreen|int|0|2||misc|0|Focus Under Fullscreen|Focus behavior for windows under a fullscreen window
misc.middle_click_paste|misc:middle_click_paste|bool||||misc|true|Middle Click Paste|Paste the primary selection on middle click
misc.font_family|misc:font_family|str||||misc|Sans|Font Family|Default Hyprland UI font family
misc.swallow_regex|misc:swallow_regex|str||||misc|-|Swallow Regex|Windows eligible for swallowing
input.kb_layout|input:kb_layout|str||||input|us|Keyboard Layout|XKB layout or comma-separated list
