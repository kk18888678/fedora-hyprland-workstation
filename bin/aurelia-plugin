#!/usr/bin/env bash
# aurelia-plugin — manifest and lifecycle management for Aurelia Shell plugins.

set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
export AURELIA_PLUGIN_BIN_DIR="$script_dir"
lib_dir="$script_dir/lib/aurelia-plugin"
if [[ ! -d "$lib_dir" && -d "$script_dir/../lib/aurelia-plugin" ]]; then
    lib_dir="$script_dir/../lib/aurelia-plugin"
fi

for module in common manifest main; do
    module_path="$lib_dir/$module.sh"
    if [[ ! -f "$module_path" ]]; then
        printf 'Error: Missing Aurelia plugin module: %s\n' "$module_path" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$module_path"
done

aurelia_plugin_main "$@"
