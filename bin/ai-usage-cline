#!/usr/bin/env python3
"""Local-stats Cline usage collector for the Aurelia agents panel.

Covers both Cline surfaces that keep local history:

  * the VS Code / Cursor / VSCodium extension, whose per-task ui_messages.json
    records `tokensIn`/`tokensOut`/`cacheReads`/`cacheWrites` on each
    `api_req_started` entry;
  * the Cline CLI, whose session message logs record per-assistant-message
    `metrics` and `modelInfo`.

ClinePass 5-hour, weekly and monthly windows come from Cline's own
`/api/v1/users/me/plan/usage-limits` endpoint. The DURABLE credential is a
user-owned API key with no expiry, read from a private config file
(`~/.config/workstation/ai-keys.conf`, mode 0600, field `cline.api_key`) or
from the `CLINE_API_KEY` environment variable, and sent as
`Authorization: Bearer <key>`. The short-lived OAuth access token (~1 hour)
is retained ONLY as an explicitly-labelled best-effort fallback; it is not the
durability guarantee and is the exact value that used to flap.

The endpoint is read-only and no credential is ever refreshed or written:
Cline rotates the refresh token, so a read-only collector that refreshed
without atomically persisting the new token would invalidate the user's login.
Because `/api/v1/users/me/plan/usage-limits` is UNDOCUMENTED (it is used by the
Cline web app but appears in neither the CLI nor the extension bundle), its
shape is guarded strictly: a changed shape fails closed as
"Cline limits unavailable" with `limits: []` rather than a fabricated `0%`.

Prints one display-ready JSON record (the same contract as the other
ai-usage-* collectors).
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import ai_usage_common as common  # noqa: E402

AGENT_ID = "cline"
AGENT_NAME = "Cline"
CLINE_USAGE_URL = "https://api.cline.bot/api/v1/users/me/plan/usage-limits"
# Durable, user-owned API key. A key has no expiry field, so it has no
# lifecycle and cannot flap. The field name and path are documented in
# shell-documentation/13-ai-first-platform.md.
CLINE_KEY_FIELD = "cline.api_key"
CLINE_KEY_ENV = "CLINE_API_KEY"
# Upstream `type` -> (collector label, window length in minutes). The labels
# match the OpenCode and Codex collectors so the dashboard reads identically.
CLINE_WINDOWS = (
    ("five_hour", "5h window", 300),
    ("weekly", "Weekly (7-day)", 10080),
    ("monthly", "Monthly (30-day)", 43200),
)
AUTH_HELP = (
    "Cline rejected the API key. Create or replace a Cline API key at the "
    "Cline dashboard account page, then store the one-time secret in "
    "~/.config/workstation/ai-keys.conf (mode 0600) as `cline.api_key=...`, "
    "or export CLINE_API_KEY. The collector never refreshes or rewrites the "
    "credential."
)
NOT_CONFIGURED_STATUS = "Cline not configured"
AUTH_FAILURE_STATUS = "Cline authentication failed"
UNAVAILABLE_STATUS = "Cline limits unavailable"


# ------------------------------------------------------- credential (read-only)


def cline_dir() -> Path:
    base = os.environ.get("CLINE_DIR") or Path.home() / ".cline"
    return Path(os.path.expandvars(os.path.expanduser(str(base))))


def _settings_access_token(provider) -> str:
    if not isinstance(provider, dict):
        return ""
    settings = provider.get("settings")
    auth = settings.get("auth") if isinstance(settings, dict) else None
    token = auth.get("accessToken") if isinstance(auth, dict) else None
    if token is None:
        return ""
    return str(token).strip()


def cline_api_key() -> str:
    """Return the durable user-owned Cline API key, or "".

    Shared reader: `~/.config/workstation/ai-keys.conf` (mode 0600) field
    `cline.api_key`, or the `CLINE_API_KEY` environment variable. The key has
    no expiry, so it has no lifecycle and cannot flap. Read-only and never
    printed or written.
    """
    return common.read_ai_key(CLINE_KEY_FIELD, env_var=CLINE_KEY_ENV)


def cline_access_token() -> str:
    """BEST-EFFORT fallback only: the short-lived stored Cline OAuth token.

    This is deliberately NOT the durability guarantee. The token lives about an
    hour and is the exact credential that used to flap, so it is consulted only
    when no durable user-owned API key is configured. Read-only: the provider
    settings are parsed for presence only and the token value is never logged,
    emitted or rewritten. There is deliberately no token refresh because Cline
    rotates the refresh token; a read-only collector that refreshed without
    atomically persisting the new token would invalidate the user's login and
    break their CLI.
    """
    providers_path = cline_dir() / "data" / "settings" / "providers.json"
    if providers_path.is_file():
        try:
            document = json.loads(providers_path.read_text(encoding="utf-8"))
        except Exception:
            document = None
        providers = document.get("providers") if isinstance(document, dict) else None
        if isinstance(providers, dict):
            # Prefer the canonical `cline` provider, then the `cline-pass` id.
            for provider_id in ("cline", "cline-pass"):
                token = _settings_access_token(providers.get(provider_id))
                if token:
                    return token
    auth_path = common.pi_agent_root() / "auth.json"
    if auth_path.is_file():
        try:
            document = json.loads(auth_path.read_text(encoding="utf-8"))
        except Exception:
            document = None
        entry = document.get("clinepass") if isinstance(document, dict) else None
        token = entry.get("access") if isinstance(entry, dict) else None
        if token:
            return str(token).strip()
    return ""


def cline_credential() -> tuple[str, str]:
    """Resolve the credential for one request: (value, source).

    Precedence is the durable user-owned API key, then the explicitly-labelled
    best-effort OAuth fallback. `source` is one of `key`, `oauth` or `""` and
    is used only to keep the auth guidance honest; the value is never emitted.
    """
    key = cline_api_key()
    if key:
        return key, "key"
    token = cline_access_token()
    if token:
        return token, "oauth"
    return "", ""


def local_roots_present() -> bool:
    return bool(vscode_task_roots()) or cline_cli_sessions().is_dir()


def parse_cline_limits(payload):
    """Return the canonical live window list, or None for an unknown shape.

    Strict fail-closed guards: the route is undocumented, so a changed envelope
    (non-object body, `success: false`, missing/non-list `data.limits`, a
    non-object row, or a known window with a missing/non-numeric `percentUsed`)
    yields None instead of a partial or fabricated result.
    """
    if not isinstance(payload, dict):
        return None
    if payload.get("success") is False:
        return None
    data = payload.get("data")
    if not isinstance(data, dict):
        return None
    raw_limits = data.get("limits")
    if not isinstance(raw_limits, list):
        return None
    by_type = {}
    for item in raw_limits:
        if not isinstance(item, dict):
            return None
        by_type[str(item.get("type") or "")] = item
    limits = []
    for window_type, label, minutes in CLINE_WINDOWS:
        item = by_type.get(window_type)
        if item is None:
            continue
        percent = item.get("percentUsed")
        if percent is None:
            # A present known window with no percentage is a changed shape.
            return None
        fraction = common.used_fraction(percent)
        if fraction is None:
            return None
        limits.append({
            "label": label,
            # `percentUsed` is USED; the panel inverts to display remaining.
            "percent": fraction,
            "resetsAt": common.normalize_resets_at(item.get("resetsAt")),
            "windowMinutes": minutes,
        })
    return limits


def fetch_cline_limits(access_token: str | None = None) -> dict:
    """Live ClinePass 5h/weekly/monthly windows from the Cline API.

    The credential is the durable user-owned API key when present, otherwise
    the explicitly-labelled best-effort OAuth fallback, otherwise no request at
    all. When upstream returns only some windows, only those are emitted; a
    missing window is never reported as a fabricated 0%. Every failure is
    bounded by a timeout and returns a diagnostic rather than crashing.
    """
    result = {
        "limits": [],
        "tierLabel": "",
        "usageStatusText": NOT_CONFIGURED_STATUS,
        "authHelpText": "",
        "retryAdvised": False,
    }
    if access_token is None:
        credential, _source = cline_credential()
    else:
        credential = access_token
    if not credential:
        # No credential: no network call at all. This is a local-only state,
        # not an error, so retryAdvised stays false.
        return result
    try:
        request = urllib.request.Request(
            CLINE_USAGE_URL,
            headers={
                # The documented header is exactly `Authorization: Bearer`;
                # `x-api-key` is rejected with 401 by this route.
                "Authorization": "Bearer " + credential,
                "Accept": "application/json",
                "User-Agent": "aurelia-agent-usage/1.0",
            },
        )
        # Bounded: explicit 10-second timeout; TLS verification is never disabled.
        with urllib.request.urlopen(request, timeout=10) as response:
            payload = json.loads(response.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as exc:
        status = int(getattr(exc, "code", 0) or 0)
        if status in (401, 403):
            # A rejected credential cannot be retried and no refresh is
            # attempted, so the credential store stays untouched.
            result["usageStatusText"] = AUTH_FAILURE_STATUS
            result["authHelpText"] = AUTH_HELP
            result["retryAdvised"] = False
            return result
        result["usageStatusText"] = UNAVAILABLE_STATUS
        result["retryAdvised"] = status == 429 or status >= 500 or common.retry_advised_from_error(exc)
        return result
    except Exception as exc:
        # Timeout/DNS/transport: the only retryable class. Deliberately no
        # authHelpText, so a rate limit is never mistaken for a credential error.
        result["usageStatusText"] = UNAVAILABLE_STATUS
        result["retryAdvised"] = common.retry_advised_from_error(exc)
        return result

    limits = parse_cline_limits(payload)
    if limits is None:
        # Changed or malformed shape: fail closed, never fabricate a `0%`.
        result["usageStatusText"] = UNAVAILABLE_STATUS
        result["retryAdvised"] = False
        return result
    result["limits"] = limits
    result["usageStatusText"] = ""
    if limits:
        result["tierLabel"] = "ClinePass"
    return result


def number(value) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def local_date_string() -> str:
    return dt.datetime.now().strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
    today = dt.datetime.now().date()
    return [(today - dt.timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def local_date_from_millis(value) -> str:
    try:
        millis = float(value)
        if millis <= 0:
            return local_date_string()
        return dt.datetime.fromtimestamp(millis / 1000.0).strftime("%Y-%m-%d")
    except Exception:
        return local_date_string()


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def vscode_task_roots() -> list[Path]:
    config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    roots = []
    for app in ("Code", "Code - OSS", "VSCodium", "Cursor", "Windsurf"):
        path = config / app / "User" / "globalStorage" / "saoudrizwan.claude-dev" / "tasks"
        if path.is_dir():
            roots.append(path)
    return roots


def cline_cli_sessions() -> Path:
    return cline_dir() / "data" / "sessions"


def scan_vscode_tasks(roots: list[Path], add) -> None:
    for root in roots:
        for task_dir in sorted(root.iterdir()):
            if not task_dir.is_dir():
                continue
            messages_path = task_dir / "ui_messages.json"
            if not messages_path.is_file():
                continue
            model = "cline"
            metadata_path = task_dir / "task_metadata.json"
            if metadata_path.is_file():
                try:
                    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
                    usage = metadata.get("model_usage") if isinstance(metadata, dict) else None
                    if isinstance(usage, list) and usage:
                        model = str((usage[-1] or {}).get("model_id") or model)
                except Exception:
                    pass
            try:
                messages = json.loads(messages_path.read_text(encoding="utf-8", errors="replace"))
            except Exception as exc:  # pragma: no cover - unreadable tasks only
                print(f"Ignoring unreadable Cline task {messages_path}: {exc}", file=sys.stderr)
                continue
            if not isinstance(messages, list):
                continue
            for index, message in enumerate(messages):
                if not isinstance(message, dict) or message.get("say") != "api_req_started":
                    continue
                try:
                    payload = json.loads(message.get("text") or "{}")
                except Exception:
                    continue
                if not isinstance(payload, dict):
                    continue
                add(
                    key=(str(task_dir), index),
                    day=local_date_from_millis(message.get("ts")),
                    model=model,
                    input_tokens=number(payload.get("tokensIn")),
                    output_tokens=number(payload.get("tokensOut")),
                    cache_read=number(payload.get("cacheReads")),
                    cache_write=number(payload.get("cacheWrites")),
                )


def scan_cli_sessions(root: Path, add) -> None:
    if not root.is_dir():
        return
    for session_dir in sorted(root.iterdir()):
        if not session_dir.is_dir():
            continue
        for messages_path in sorted(session_dir.glob("*.messages.json")):
            try:
                document = json.loads(messages_path.read_text(encoding="utf-8", errors="replace"))
            except Exception as exc:  # pragma: no cover - unreadable sessions only
                print(f"Ignoring unreadable Cline session {messages_path}: {exc}", file=sys.stderr)
                continue
            messages = document.get("messages") if isinstance(document, dict) else None
            if not isinstance(messages, list):
                continue
            for message in messages:
                if not isinstance(message, dict) or message.get("role") != "assistant":
                    continue
                metrics = message.get("metrics")
                if not isinstance(metrics, dict):
                    continue
                model_info = message.get("modelInfo") if isinstance(message.get("modelInfo"), dict) else {}
                model = str(model_info.get("id") or model_info.get("provider") or "cline")
                add(
                    key=(str(session_dir), str(message.get("id") or "")),
                    day=local_date_from_millis(message.get("ts")),
                    model=model,
                    input_tokens=number(metrics.get("inputTokens")),
                    output_tokens=number(metrics.get("outputTokens")),
                    cache_read=number(metrics.get("cacheReadTokens")),
                    cache_write=number(metrics.get("cacheWriteTokens")),
                )


def scan() -> dict:
    today = local_date_string()
    recent_dates = recent_date_strings()
    recent = {day: common.empty_day(day) for day in recent_dates}

    seen: set[tuple[str, str]] = set()
    sessions: set[str] = set()
    active_days: set[str] = set()
    today_sessions: set[str] = set()
    today_by_model: dict[str, dict[str, int]] = {}
    usage_by_model: dict[str, dict[str, int]] = {}
    prompts = 0
    today_prompt_count = 0

    def add(key, day, model, input_tokens, output_tokens, cache_read, cache_write) -> None:
        nonlocal prompts, today_prompt_count
        total = input_tokens + output_tokens + cache_read + cache_write
        if total <= 0:
            return
        if key in seen:
            return
        seen.add(key)
        sessions.add(str(key[0]))
        active_days.add(day)
        prompts += 1
        bucket = usage_by_model.setdefault(model, empty_bucket())
        bucket["inputTokens"] += input_tokens
        bucket["outputTokens"] += output_tokens
        bucket["cacheReadInputTokens"] += cache_read
        bucket["cacheCreationInputTokens"] += cache_write
        billable = input_tokens + output_tokens
        cache = cache_read + cache_write
        if day in recent:
            entry = recent[day]
            entry["tokens"] += total
            entry["billableTokens"] += billable
            entry["cacheTokens"] += cache
        if day == today:
            today_prompt_count += 1
            today_sessions.add(str(key[0]))
            today_bucket = today_by_model.setdefault(model, empty_bucket())
            today_bucket["inputTokens"] += input_tokens
            today_bucket["outputTokens"] += output_tokens
            today_bucket["cacheReadInputTokens"] += cache_read
            today_bucket["cacheCreationInputTokens"] += cache_write

    vscode_roots = vscode_task_roots()
    cli_root = cline_cli_sessions()
    scan_vscode_tasks(vscode_roots, add)
    scan_cli_sessions(cli_root, add)

    today_split = common.today_model_split(today_by_model)
    return {
        "todayPrompts": today_prompt_count,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": sum(v["totalTokens"] for v in today_split.values()),
        "todayBillableTokens": sum(v["billableTokens"] for v in today_split.values()),
        "todayCacheTokens": sum(v["cacheTokens"] for v in today_split.values()),
        "todayTokensByModel": today_split,
        "recentDays": [common.finalize_day(recent[day]) for day in recent_dates],
        "modelUsage": common.finalize_model_buckets(usage_by_model),
        "totalPrompts": prompts,
        "totalSessions": len(sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
        "detected": bool(vscode_roots) or cli_root.is_dir(),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true", help="accepted for collector parity; local scans are always fresh")
    parser.parse_args()

    stats = common.merge_stats(scan(), common.scan_pi_sessions(["cline"]))
    credential, _source = cline_credential()
    cline = fetch_cline_limits()
    limits = cline.get("limits") or []
    detected = (
        local_roots_present()
        or bool(credential)
        or len(limits) > 0
        or bool(stats.get("detected"))
    )
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        # A limits-only account with no local history is still ready.
        "ready": number(stats.get("totalPrompts")) > 0 or len(limits) > 0,
        "detected": detected,
        "hasLocalStats": detected,
        "hasPromptStats": True,
        "tierLabel": cline.get("tierLabel") or "",
        # Cline records one API request per turn, not a chat prompt.
        "todayLabel": "requests",
        "retryAdvised": bool(cline.get("retryAdvised")),
        "usageStatusText": cline.get("usageStatusText") or "",
        "authHelpText": cline.get("authHelpText") or "",
        "limits": limits,
        # ClinePass can report all three canonical windows; a column outside
        # this set is "not offered" rather than "not reported".
        "supportedWindowMinutes": [300, 10080, 43200],
    }
    record.update(stats)
    # `stats` carries its own usage-derived `detected`; re-assert the merged
    # credential/limits visibility decision after the update, matching Codex
    # and OpenCode.
    record["detected"] = detected
    record["hasLocalStats"] = detected
    common.apply_subscription(record, AGENT_ID)
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
