#!/usr/bin/env python3
"""Local-stats Cline usage collector for the Aurelia agents panel.

Covers both Cline surfaces that keep local history:

  * the VS Code / Cursor / VSCodium extension, whose per-task ui_messages.json
    records `tokensIn`/`tokensOut`/`cacheReads`/`cacheWrites` on each
    `api_req_started` entry;
  * the Cline CLI, whose session message logs record per-assistant-message
    `metrics` and `modelInfo`.

Prints one display-ready JSON record (the same contract as the other
ai-usage-* collectors). No network calls and no credentials.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import ai_usage_common as common  # noqa: E402

AGENT_ID = "cline"
AGENT_NAME = "Cline"


def number(value) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def local_date_string() -> str:
    return dt.datetime.now().strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
    today = dt.datetime.now().date()
    return [(today - dt.timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def local_date_from_millis(value) -> str:
    try:
        millis = float(value)
        if millis <= 0:
            return local_date_string()
        return dt.datetime.fromtimestamp(millis / 1000.0).strftime("%Y-%m-%d")
    except Exception:
        return local_date_string()


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def vscode_task_roots() -> list[Path]:
    config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    roots = []
    for app in ("Code", "Code - OSS", "VSCodium", "Cursor", "Windsurf"):
        path = config / app / "User" / "globalStorage" / "saoudrizwan.claude-dev" / "tasks"
        if path.is_dir():
            roots.append(path)
    return roots


def cline_cli_sessions() -> Path:
    base = Path(os.environ.get("CLINE_DIR") or Path.home() / ".cline")
    return base / "data" / "sessions"


def scan_vscode_tasks(roots: list[Path], add) -> None:
    for root in roots:
        for task_dir in sorted(root.iterdir()):
            if not task_dir.is_dir():
                continue
            messages_path = task_dir / "ui_messages.json"
            if not messages_path.is_file():
                continue
            model = "cline"
            metadata_path = task_dir / "task_metadata.json"
            if metadata_path.is_file():
                try:
                    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
                    usage = metadata.get("model_usage") if isinstance(metadata, dict) else None
                    if isinstance(usage, list) and usage:
                        model = str((usage[-1] or {}).get("model_id") or model)
                except Exception:
                    pass
            try:
                messages = json.loads(messages_path.read_text(encoding="utf-8", errors="replace"))
            except Exception as exc:  # pragma: no cover - unreadable tasks only
                print(f"Ignoring unreadable Cline task {messages_path}: {exc}", file=sys.stderr)
                continue
            if not isinstance(messages, list):
                continue
            for index, message in enumerate(messages):
                if not isinstance(message, dict) or message.get("say") != "api_req_started":
                    continue
                try:
                    payload = json.loads(message.get("text") or "{}")
                except Exception:
                    continue
                if not isinstance(payload, dict):
                    continue
                add(
                    key=(str(task_dir), index),
                    day=local_date_from_millis(message.get("ts")),
                    model=model,
                    input_tokens=number(payload.get("tokensIn")),
                    output_tokens=number(payload.get("tokensOut")),
                    cache_read=number(payload.get("cacheReads")),
                    cache_write=number(payload.get("cacheWrites")),
                )


def scan_cli_sessions(root: Path, add) -> None:
    if not root.is_dir():
        return
    for session_dir in sorted(root.iterdir()):
        if not session_dir.is_dir():
            continue
        for messages_path in sorted(session_dir.glob("*.messages.json")):
            try:
                document = json.loads(messages_path.read_text(encoding="utf-8", errors="replace"))
            except Exception as exc:  # pragma: no cover - unreadable sessions only
                print(f"Ignoring unreadable Cline session {messages_path}: {exc}", file=sys.stderr)
                continue
            messages = document.get("messages") if isinstance(document, dict) else None
            if not isinstance(messages, list):
                continue
            for message in messages:
                if not isinstance(message, dict) or message.get("role") != "assistant":
                    continue
                metrics = message.get("metrics")
                if not isinstance(metrics, dict):
                    continue
                model_info = message.get("modelInfo") if isinstance(message.get("modelInfo"), dict) else {}
                model = str(model_info.get("id") or model_info.get("provider") or "cline")
                add(
                    key=(str(session_dir), str(message.get("id") or "")),
                    day=local_date_from_millis(message.get("ts")),
                    model=model,
                    input_tokens=number(metrics.get("inputTokens")),
                    output_tokens=number(metrics.get("outputTokens")),
                    cache_read=number(metrics.get("cacheReadTokens")),
                    cache_write=number(metrics.get("cacheWriteTokens")),
                )


def scan() -> dict:
    today = local_date_string()
    recent_dates = recent_date_strings()
    recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}

    seen: set[tuple[str, str]] = set()
    sessions: set[str] = set()
    active_days: set[str] = set()
    today_sessions: set[str] = set()
    today_tokens: dict[str, int] = {}
    usage_by_model: dict[str, dict[str, int]] = {}
    prompts = 0
    today_prompt_count = 0
    today_token_total = 0

    def add(key, day, model, input_tokens, output_tokens, cache_read, cache_write) -> None:
        nonlocal prompts, today_prompt_count, today_token_total
        total = input_tokens + output_tokens + cache_read + cache_write
        if total <= 0:
            return
        if key in seen:
            return
        seen.add(key)
        sessions.add(str(key[0]))
        active_days.add(day)
        prompts += 1
        bucket = usage_by_model.setdefault(model, empty_bucket())
        bucket["inputTokens"] += input_tokens
        bucket["outputTokens"] += output_tokens
        bucket["cacheReadInputTokens"] += cache_read
        bucket["cacheCreationInputTokens"] += cache_write
        if day in recent:
            recent[day]["messageCount"] += total
        if day == today:
            today_prompt_count += 1
            today_sessions.add(str(key[0]))
            today_token_total += total
            today_tokens[model] = today_tokens.get(model, 0) + total

    vscode_roots = vscode_task_roots()
    cli_root = cline_cli_sessions()
    scan_vscode_tasks(vscode_roots, add)
    scan_cli_sessions(cli_root, add)

    return {
        "todayPrompts": today_prompt_count,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_token_total,
        "todayTokensByModel": today_tokens,
        "recentDays": [recent[day] for day in recent_dates],
        "modelUsage": usage_by_model,
        "totalPrompts": prompts,
        "totalSessions": len(sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
        "detected": bool(vscode_roots) or cli_root.is_dir(),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true", help="accepted for collector parity; local scans are always fresh")
    parser.parse_args()

    stats = common.merge_stats(scan(), common.scan_pi_sessions(["cline"]))
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": number(stats.get("totalPrompts")) > 0,
        "detected": bool(stats.get("detected")),
        "hasLocalStats": bool(stats.get("detected")),
        "hasPromptStats": True,
        "tierLabel": "",
        "usageStatusText": "Local usage only",
        "authHelpText": "",
        "limits": [],
    }
    record.update(stats)
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
