#!/usr/bin/env bash
# aurelia-shell — bounded IPC client for the resident Aurelia Shell host.
#
# This command forwards calls to an already-running shell. It never starts a
# second Quickshell process; startup is owned by aurelia-launch-shell.

set -Eeuo pipefail

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

if [[ $# -lt 2 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'USAGE'
Usage: aurelia-shell <target> <method> [args...]

Forwards a bounded IPC call to the resident Aurelia Shell. This command does
not start Quickshell.

Examples:
  aurelia-shell shell ping
  aurelia-shell shell toggle aurelia.keybindings '{}'
  aurelia-shell shell listPlugins
USAGE
    exit 0
fi

shell_root="${XDG_CONFIG_HOME:-$HOME/.config}/aurelia"
if [[ "${AURELIA_DEVELOPMENT_MODE:-0}" == "1" || "${WORKSTATION_TEST_MODE:-0}" == "1" ]] &&
   [[ -n "${AURELIA_SHELL_ROOT:-}" ]]; then
    shell_root="$AURELIA_SHELL_ROOT"
fi
[[ "$shell_root" == /* && "$shell_root" != "/" ]] || fail "Aurelia shell path is not absolute"
[[ -f "$shell_root/shell.qml" ]] || fail "Aurelia Shell configuration not found: $shell_root/shell.qml"

qs_bin=""
if [[ "${AURELIA_DEVELOPMENT_MODE:-0}" == "1" || "${WORKSTATION_TEST_MODE:-0}" == "1" ]] &&
   [[ -n "${QUICKSHELL_BIN:-}" && -x "$QUICKSHELL_BIN" ]]; then
    qs_bin="$QUICKSHELL_BIN"
elif [[ -x "/usr/bin/qs" ]]; then
    qs_bin="/usr/bin/qs"
elif [[ -x "/usr/bin/quickshell" ]]; then
    qs_bin="/usr/bin/quickshell"
else
    fail "Quickshell runtime binary not found"
fi

timeout_bin=""
if [[ -x "/usr/bin/timeout" ]]; then
    timeout_bin="/usr/bin/timeout"
elif [[ "${WORKSTATION_TEST_MODE:-0}" == "1" && -x "$(command -v timeout 2>/dev/null || true)" ]]; then
    timeout_bin="$(command -v timeout)"
else
    fail "Required safety utility 'timeout' is not available"
fi

ipc_timeout="${AURELIA_SHELL_IPC_TIMEOUT:-2s}"
output=""
status=0
output="$("$timeout_bin" --kill-after=1s "$ipc_timeout" "$qs_bin" ipc --path "$shell_root/shell.qml" call -- "$@" 2>/dev/null)" || status=$?

if [[ "$status" -eq 124 || "$status" -eq 137 ]]; then
    fail "Aurelia Shell is not responding"
elif [[ "$status" -ne 0 ]]; then
    fail "Aurelia Shell is not running"
fi

case "$output" in
    "Target not found."*|"Function not found."*|"Too few arguments provided"*|"Too many arguments provided"*)
        fail "$output"
        ;;
    "Not ready to accept queries yet"*)
        fail "Aurelia Shell is not ready"
        ;;
esac

if [[ -n "$output" ]]; then
    printf '%s\n' "$output"
fi
