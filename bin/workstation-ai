#!/usr/bin/env bash
# workstation-ai — bounded AI coding-agent launcher and default-agent owner.
#
# Mirrors the core of Omarchy's AI workflow for the Fedora Hyprland
# workstation: a registry of coding agents, one user-selected default, a
# terminal launcher that runs the default in its unattended mode, and the
# workstation skill installed into agent skill directories.
#
# Ownership: this backend never installs agents. Agents that are not present
# are reported as unavailable; provisioning them is an installer or package
# decision (see modules/applications.sh), so the workstation keeps a single,
# verifiable supply chain.
#
# Safety invariants:
#   * strict agent registry: unknown ids fail closed
#   * the only mutation is an atomic write of the user-owned ai.conf (0600)
#   * skill installation only creates/removes this project's own symlink
#   * no network access; no arbitrary upstream installs

set -Eeuo pipefail

PROG="workstation-ai"
MARKER="WORKSTATION_AI_MANAGED_V1"

fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
# Absolute path to this backend, so the reviewed crash handoff can re-enter the
# same binary from inside the terminal it opens.
SELF_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"

home="${HOME:-}"
if [[ "$home" != /* || "$home" == "/" || ! -d "$home" || -L "$home" ]]; then
    fail "HOME is missing or unsafe"
fi
config_home="${XDG_CONFIG_HOME:-$home/.config}"
[[ "$config_home" == /* && "$config_home" != "/" ]] || fail "XDG_CONFIG_HOME must be absolute"
conf_path="${WORKSTATION_AI_CONF:-$config_home/workstation/ai.conf}"
[[ "$conf_path" == /* && "$conf_path" != "/" ]] || fail "ai.conf path must be absolute"
[[ "$conf_path" == *"/../"* ]] && fail "ai.conf path traversal"
conf_dir="$(dirname -- "$conf_path")"

state_home="${XDG_STATE_HOME:-$home/.local/state}"
[[ "$state_home" == /* && "$state_home" != "/" ]] || fail "XDG_STATE_HOME must be absolute"
usage_dir="$state_home/aurelia/agents/usage"

skill_source="$SCRIPT_DIR/../config/agent-skill/fedora-hyprland-workstation"
[[ -d "$skill_source" ]] || skill_source="/usr/local/share/fedora-hyprland-workstation/agent-skill/fedora-hyprland-workstation"
[[ -d "$skill_source" ]] || skill_source="$config_home/aurelia/agent-skill/fedora-hyprland-workstation"

diagnose_skill_source="$SCRIPT_DIR/../config/agent-skill/diagnose-crash"
[[ -d "$diagnose_skill_source" ]] || diagnose_skill_source="/usr/local/share/fedora-hyprland-workstation/agent-skill/diagnose-crash"
[[ -d "$diagnose_skill_source" ]] || diagnose_skill_source="$config_home/aurelia/agent-skill/diagnose-crash"

diagnose_skill_path() {
    printf '%s/SKILL.md\n' "$diagnose_skill_source"
}

# ---------------------------------------------------------------------------
# Agent registry: id|name|command|kind
# kind is "cli" (runs in a terminal) or "desktop" (a graphical application).
# ---------------------------------------------------------------------------
agent_specs() {
    cat <<'EOF'
agy|Antigravity|agy|cli
chatgpt|ChatGPT|chatgpt|desktop
claude|Claude Code|claude|cli
codex|Codex|codex|cli
opencode|OpenCode|opencode|cli
crush|Crush|crush|cli
copilot|GitHub Copilot|copilot|cli
grok|Grok|grok|cli
pi|Pi|pi|cli
omp|Oh My Pi|omp|cli
ori|Ori|ori|cli
hermes|Hermes|hermes|cli
muse|Muse Code|muse|cli
cursor-agent|Cursor CLI|cursor-agent|cli
EOF
}

spec_for() {
    agent_specs | awk -F'|' -v id="$1" '$1 == id { print }'
}

agent_ids() {
    agent_specs | cut -d'|' -f1
}

is_known() {
    [[ -n "$(spec_for "$1")" ]]
}

is_installed() {
    local spec kind command_name
    spec="$(spec_for "$1")"
    [[ -n "$spec" ]] || return 1
    command_name="$(printf '%s' "$spec" | cut -d'|' -f3)"
    kind="$(printf '%s' "$spec" | cut -d'|' -f4)"
    if [[ "$kind" == "desktop" ]]; then
        command -v "$command_name" >/dev/null && return 0
        command -v gtk-launch >/dev/null &&
            [[ -f "/usr/share/applications/${command_name}.desktop" ]] && return 0
        return 1
    fi
    command -v "$command_name" >/dev/null
}

# ---------------------------------------------------------------------------
# Default agent config
# ---------------------------------------------------------------------------
assert_managed() {
    if [[ -f "$conf_path" ]]; then
        grep -q "$MARKER" "$conf_path" || fail "ai.conf exists but is not managed by $PROG: $conf_path"
    fi
}

read_default() {
    [[ -f "$conf_path" ]] || return 0
    assert_managed
    awk -F= '$1 == "default_agent" { print $2; exit }' "$conf_path"
}

write_default() {
    local value="$1"
    mkdir -p -- "$conf_dir" || fail "could not create config directory"
    local tmp
    tmp="$(mktemp "$conf_dir/.ai.conf.XXXXXX")" || fail "could not stage ai.conf"
    {
        printf '%s\n' "# $MARKER"
        [[ -n "$value" ]] && printf 'default_agent=%s\n' "$value"
    } >"$tmp" || { rm -f -- "$tmp"; fail "could not write ai.conf"; }
    chmod 0600 -- "$tmp" || { rm -f -- "$tmp"; fail "could not secure ai.conf"; }
    mv -f -- "$tmp" "$conf_path" || { rm -f -- "$tmp"; fail "could not install ai.conf"; }
}

# Rewrite one managed key, preserving every other line. An empty value removes
# the key. This is the single mutation boundary for ai.conf.
conf_set() {
    local key="$1" value="$2"
    assert_managed
    mkdir -p -- "$conf_dir" || fail "could not create config directory"
    local tmp line k
    tmp="$(mktemp "$conf_dir/.ai.conf.XXXXXX")" || fail "could not stage ai.conf"
    {
        printf '%s\n' "# $MARKER"
        if [[ -f "$conf_path" ]]; then
            while IFS= read -r line; do
                [[ "$line" == \#* || "$line" != *=* ]] && continue
                k="${line%%=*}"
                [[ "$k" == "$key" ]] && continue
                printf '%s\n' "$line"
            done <"$conf_path"
        fi
        if [[ -n "$value" ]]; then
            printf '%s=%s\n' "$key" "$value"
        fi
    } >"$tmp" || { rm -f -- "$tmp"; fail "could not write ai.conf"; }
    chmod 0600 -- "$tmp" || { rm -f -- "$tmp"; fail "could not secure ai.conf"; }
    mv -f -- "$tmp" "$conf_path" || { rm -f -- "$tmp"; fail "could not install ai.conf"; }
}

# ---------------------------------------------------------------------------
# Launch
# ---------------------------------------------------------------------------
terminal_prefix() {
    # Prints the terminal invocation for a command, or returns 1.
    if command -v kitty >/dev/null; then
        printf '%s\n' "kitty|title"
    elif command -v ghostty >/dev/null; then
        printf '%s\n' "ghostty|title"
    elif command -v alacritty >/dev/null; then
        printf '%s\n' "alacritty|title"
    elif command -v foot >/dev/null; then
        printf '%s\n' "foot|title"
    elif command -v xterm >/dev/null; then
        printf '%s\n' "xterm|title"
    else
        return 1
    fi
}

# Build the agent argv (unattended mode), optionally seeded with a prompt.
# Build the agent argv. mode is "unattended" (the normal launcher) or
# "readonly" (the crash diagnosis handoff, which must not be able to mutate
# the workstation).
build_agent_argv() {
    local id="$1" prompt="${2:-}" mode="${3:-unattended}"
    case "$mode" in
        unattended)
            case "$id" in
                opencode)
                    argv=(opencode --auto)
                    [[ -n "$prompt" ]] && argv+=(--prompt "$prompt")
                    ;;
                agy)
                    argv=(agy --dangerously-skip-permissions)
                    [[ -n "$prompt" ]] && argv+=(--prompt-interactive "$prompt")
                    ;;
                claude)
                    argv=(claude --permission-mode auto)
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                codex)
                    argv=(codex --approve-for-me)
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                crush)
                    if [[ -n "$prompt" ]]; then argv=(crush run "$prompt"); else argv=(crush --yolo); fi
                    ;;
                copilot)
                    argv=(copilot --allow-all)
                    [[ -n "$prompt" ]] && argv+=(--interactive "$prompt")
                    ;;
                grok)
                    argv=(grok --permission-mode bypassPermissions)
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                omp)
                    argv=(omp --auto-approve)
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                ori)
                    argv=(ori code)
                    [[ -n "$prompt" ]] && argv+=(--interactive --prompt "$prompt")
                    ;;
                hermes)
                    if [[ -n "$prompt" ]]; then
                        argv=(env -u HERMES_SESSION_SOURCE hermes chat --yolo --tui "--query=$prompt")
                    else
                        argv=(hermes --yolo)
                    fi
                    ;;
                muse)
                    argv=(muse --approval-mode never)
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                cursor-agent)
                    argv=(cursor-agent --yolo --trust)
                    [[ -n "$prompt" ]] && argv+=(agent -- "$prompt")
                    ;;
                pi)
                    argv=(pi)
                    [[ -n "$prompt" ]] && argv+=("$prompt")
                    ;;
                *)
                    fail "agent has no unattended launcher: $id"
                    ;;
            esac
            ;;
        readonly)
            # Crash diagnosis reads evidence; it must never be handed the
            # unattended/bypass flags above. Prefer an explicit read-only or
            # plan mode where the agent documents one, and otherwise fall back
            # to the plain interactive command (no auto-approval), which is the
            # most restricted invocation the agent exposes.
            case "$id" in
                agy)
                    argv=(agy --mode plan --sandbox)
                    [[ -n "$prompt" ]] && argv+=(--prompt-interactive "$prompt")
                    ;;
                claude)
                    argv=(claude --permission-mode plan)
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                codex)
                    argv=(codex --sandbox read-only)
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                opencode)
                    argv=(opencode --agent plan)
                    [[ -n "$prompt" ]] && argv+=(--prompt "$prompt")
                    ;;
                grok)
                    argv=(grok --permission-mode plan)
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                omp)
                    argv=(omp "--approval-mode=always-ask" "--tools=read,bash,grep,glob")
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                cursor-agent)
                    argv=(cursor-agent --mode plan)
                    [[ -n "$prompt" ]] && argv+=(agent -- "$prompt")
                    ;;
                pi)
                    argv=(pi --tools "read,bash")
                    [[ -n "$prompt" ]] && argv+=("$prompt")
                    ;;
                crush)
                    argv=(crush)
                    [[ -n "$prompt" ]] && argv+=("$prompt")
                    ;;
                copilot)
                    argv=(copilot)
                    [[ -n "$prompt" ]] && argv+=(--interactive "$prompt")
                    ;;
                ori)
                    argv=(ori code)
                    [[ -n "$prompt" ]] && argv+=(--interactive --prompt "$prompt")
                    ;;
                hermes)
                    argv=(env -u HERMES_SESSION_SOURCE hermes chat --tui "--query=$prompt")
                    ;;
                muse)
                    argv=(muse)
                    [[ -n "$prompt" ]] && argv+=(-- "$prompt")
                    ;;
                *)
                    fail "agent has no read-only launcher: $id"
                    ;;
            esac
            ;;
        *)
            fail "unknown launch mode: $mode"
            ;;
    esac
}

cmd_launch() {
    local prompt="" review_file="" disclosure_file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --prompt)
                [[ $# -ge 2 ]] || fail "--prompt needs a value"
                prompt="$2"
                shift 2
                ;;
            --review)
                [[ $# -ge 2 ]] || fail "--review needs a payload file"
                review_file="$2"
                shift 2
                ;;
            --disclosure)
                [[ $# -ge 2 ]] || fail "--disclosure needs a file"
                disclosure_file="$2"
                shift 2
                ;;
            *) fail "unexpected argument: $1" ;;
        esac
    done

    local id
    id="$(read_default)"
    if [[ -z "$id" ]]; then
        fail "no default agent set (use: $PROG set <agent>)"
    fi
    is_known "$id" || fail "default agent is not in the registry: $id"
    is_installed "$id" || fail "$id is not installed"

    # Agents refuse to remember trust for $HOME; start in ~/Work when present,
    # mirroring the workstation convention.
    if [[ "$PWD" == "$home" && -d "$home/Work" ]]; then
        cd "$home/Work"
    fi

    local spec name kind
    spec="$(spec_for "$id")"
    name="$(printf '%s' "$spec" | cut -d'|' -f2)"
    kind="$(printf '%s' "$spec" | cut -d'|' -f4)"

    # A reviewed payload is shown in a terminal before the agent starts. The
    # terminal runs this backend again in its internal __review mode, which is
    # the only path that may launch the read-only diagnosis agent. There is no
    # branch that launches the agent directly from a crash payload.
    if [[ -n "$review_file" ]]; then
        [[ -f "$review_file" && ! -L "$review_file" && -r "$review_file" ]] ||
            fail "the crash payload cannot be reviewed; nothing was sent"
        argv=("$SELF_PATH" __review --payload "$review_file" --agent "$id")
        [[ -n "$disclosure_file" ]] && argv+=(--disclosure "$disclosure_file")
    elif [[ "$kind" == "desktop" ]]; then
        if command -v gtk-launch >/dev/null; then
            exec gtk-launch -- "$id.desktop"
        fi
        exec "$id"
    else
        build_agent_argv "$id" "$prompt" unattended
    fi

    local prefix terminal
    prefix="$(terminal_prefix)" || fail "no supported terminal found (kitty, ghostty, alacritty, foot, xterm)"
    terminal="${prefix%%|*}"
    case "$terminal" in
        kitty) exec kitty --title "AI: $name" "${argv[@]}" ;;
        ghostty) exec ghostty --title="AI: $name" -e "${argv[@]}" ;;
        alacritty) exec alacritty --title "AI: $name" -e "${argv[@]}" ;;
        foot) exec foot -T "AI: $name" "${argv[@]}" ;;
        xterm) exec xterm -T "AI: $name" -e "${argv[@]}" ;;
        *) fail "unsupported terminal: $terminal" ;;
    esac
}

# ---------------------------------------------------------------------------
# Skill
# ---------------------------------------------------------------------------
skill_targets() {
    local base="$home/.agents/skills"
    printf '%s\n' "$base"
    local agent_dir
    for agent_dir in "$home/.claude/skills" "$home/.codex/skills" "$home/.pi/agent/skills" \
        "$home/.gemini/config/skills" "$home/.hermes/skills"; do
        [[ -d "$agent_dir" ]] && printf '%s\n' "$agent_dir"
    done
}

# Skill names installed by this backend, and the source directory for each.
skill_names() {
    printf '%s\n' fedora-hyprland-workstation diagnose-crash
}

skill_source_for() {
    case "$1" in
        fedora-hyprland-workstation) printf '%s\n' "$skill_source" ;;
        diagnose-crash) printf '%s\n' "$diagnose_skill_source" ;;
        *) fail "unknown skill: $1" ;;
    esac
}

cmd_skill() {
    local action="${1:-status}"
    case "$action" in
        status)
            local target name installed=0
            while IFS= read -r target; do
                [[ -n "$target" ]] || continue
                while IFS= read -r name; do
                    if [[ -L "$target/$name" ]]; then
                        installed=1
                    fi
                done < <(skill_names)
            done < <(skill_targets)
            if (( installed )); then printf 'installed\n'; else printf 'not-installed\n'; fi
            ;;
        install)
            local target name source link
            while IFS= read -r target; do
                [[ -n "$target" ]] || continue
                mkdir -p -- "$target" || fail "could not create $target"
                while IFS= read -r name; do
                    source="$(skill_source_for "$name")"
                    [[ -d "$source" ]] || fail "skill source not found: $source"
                    link="$target/$name"
                    if [[ -e "$link" && ! -L "$link" ]]; then
                        fail "refusing to replace non-symlink: $link"
                    fi
                    rm -f -- "$link"
                    ln -s -- "$source" "$link" || fail "could not link skill into $target"
                done < <(skill_names)
            done < <(skill_targets)
            printf 'Skill installed for %s\n' "$(skill_targets | wc -l | tr -d ' ')"
            ;;
        remove)
            local target name link removed=0
            while IFS= read -r target; do
                [[ -n "$target" ]] || continue
                while IFS= read -r name; do
                    link="$target/$name"
                    if [[ -L "$link" ]]; then
                        rm -f -- "$link" && removed=1
                    fi
                done < <(skill_names)
            done < <(skill_targets)
            if (( removed )); then printf 'Skill removed.\n'; else printf 'Skill was not installed.\n'; fi
            ;;
        *) fail "usage: $PROG skill [status|install|remove]" ;;
    esac
}

# ---------------------------------------------------------------------------
# JSON
# ---------------------------------------------------------------------------
json_string() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '"%s"' "$s"
}

cmd_agents() {
    local default_id first=1 line id name command_name kind installed
    default_id="$(read_default)"
    printf '{\n  "default": %s,\n  "agents": [' "$([[ -n "$default_id" ]] && json_string "$default_id" || printf null)"
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        id="$(printf '%s' "$line" | cut -d'|' -f1)"
        name="$(printf '%s' "$line" | cut -d'|' -f2)"
        command_name="$(printf '%s' "$line" | cut -d'|' -f3)"
        kind="$(printf '%s' "$line" | cut -d'|' -f4)"
        if is_installed "$id"; then installed=true; else installed=false; fi
        (( first )) || printf ',\n'
        first=0
        printf '    { "id": %s, "name": %s, "command": %s, "kind": %s, "installed": %s }' \
            "$(json_string "$id")" "$(json_string "$name")" "$(json_string "$command_name")" \
            "$(json_string "$kind")" "$installed"
    done < <(agent_specs)
    printf '\n  ]\n}\n'
}

cmd_set() {
    local id="$1"
    is_known "$id" || fail "unknown agent: $id"
    write_default "$id"
    if is_installed "$id"; then
        printf 'Default agent set to %s.\n' "$id"
    else
        printf 'Default agent set to %s (not installed yet).\n' "$id"
    fi
}

cmd_reset() {
    if [[ -f "$conf_path" ]]; then
        assert_managed
        rm -f -- "$conf_path"
    fi
    printf 'Cleared the default agent.\n'
}

cmd_check() {
    printf 'backend: %s\n' "$PROG"
    printf 'ai_conf: %s\n' "$conf_path"
    printf 'usage_dir: %s\n' "$usage_dir"
    printf 'default: %s\n' "$(read_default)"
    printf 'terminal: %s\n' "$(terminal_prefix | cut -d'|' -f1 || printf 'unavailable')"
    printf 'skill_source: %s\n' "$skill_source"
}

# subscription list [--json] | set <agent> <key> <value> | unset <agent> <key>
# Keys: plan, renew (YYYY-MM-DD), cycle, cost, currency, reminder_days.
cmd_subscription() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in
        list)
            assert_managed
            local json=0
            [[ "${1:-}" == "--json" ]] && json=1
            if (( json )); then
                python3 - "$conf_path" <<'PY'
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
out = {}
if path.is_file():
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        parts = key.split(".")
        if len(parts) != 3 or parts[0] != "subscription":
            continue
        out.setdefault(parts[1], {})[parts[2]] = value
print(json.dumps(out, sort_keys=True))
PY
            else
                [[ -f "$conf_path" ]] || return 0
                grep '^subscription\.' "$conf_path" || true
            fi
            ;;
        set)
            local agent="${1:-}" key="${2:-}" value="${3:-}"
            [[ -n "$agent" && -n "$key" ]] || fail "usage: $PROG subscription set <agent> <key> <value>"
            [[ "$agent" =~ ^[A-Za-z0-9_-]+$ ]] || fail "invalid agent id"
            [[ "$key" =~ ^[A-Za-z0-9_]+$ ]] || fail "invalid subscription key"
            conf_set "subscription.$agent.$key" "$value"
            printf 'Set %s.%s on %s\n' "$key" "$agent" "$value"
            ;;
        unset)
            local agent="${1:-}" key="${2:-}"
            [[ -n "$agent" && -n "$key" ]] || fail "usage: $PROG subscription unset <agent> <key>"
            conf_set "subscription.$agent.$key" ""
            printf 'Unset %s on %s\n' "$key" "$agent"
            ;;
        *)
            fail "usage: $PROG subscription [list [--json]|set <agent> <key> <value>|unset <agent> <key>]"
            ;;
    esac
}

# Collectors are executable ai-usage-<agent> scripts; each prints one record.
json_valid() {
    if command -v jq >/dev/null; then
        jq -e . >/dev/null
    elif command -v python3 >/dev/null; then
        python3 -c 'import json,sys; json.load(sys.stdin)' >/dev/null
    else
        cat >/dev/null
    fi
}

cmd_usage_update() {
    local force=0 agent collector out tmp candidate wanted
    local -a only=() cargs=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force) force=1 ;;
            --*) fail "unknown flag: $1" ;;
            *) only+=("$1") ;;
        esac
        shift
    done
    mkdir -p -- "$usage_dir" || fail "could not create usage directory"
    local status=0
    for collector in "$SCRIPT_DIR"/ai-usage-*; do
        [[ -f "$collector" && -x "$collector" ]] || continue
        agent="${collector##*/ai-usage-}"
        [[ "$agent" == "*-usage-update" ]] && continue
        if (( ${#only[@]} > 0 )); then
            wanted=0
            for candidate in "${only[@]}"; do
                [[ "$candidate" == "$agent" ]] && wanted=1
            done
            (( wanted )) || continue
        fi
        cargs=()
        (( force )) && cargs+=(--force)
        if ! out="$("$collector" "${cargs[@]}")"; then
            printf 'Warning: %s collector failed.\n' "$agent" >&2
            status=1
            continue
        fi
        [[ -n "$out" ]] || continue
        if ! printf '%s' "$out" | json_valid; then
            printf 'Warning: %s collector produced invalid JSON.\n' "$agent" >&2
            status=1
            continue
        fi
        tmp="$(mktemp "$usage_dir/.$agent.XXXXXX")" || { status=1; continue; }
        if printf '%s\n' "$out" >"$tmp" && chmod 0600 -- "$tmp" && mv -f -- "$tmp" "$usage_dir/$agent.json"; then
            :
        else
            rm -f -- "$tmp"
            status=1
        fi
    done
    return $status
}

cmd_usage() {
    local first=1 file
    printf '{\n  "agents": ['
    if [[ -d "$usage_dir" ]]; then
        for file in "$usage_dir"/*.json; do
            [[ -f "$file" ]] || continue
            (( first )) || printf ','
            first=0
            printf '\n'
            cat "$file"
        done
    fi
    printf '\n  ]\n}\n'
}

# Launch the default agent seeded with a task (mirrors `omarchy agent prompt`).
cmd_prompt() {
    [[ $# -ge 1 ]] || fail "usage: $PROG prompt <text>"
    cmd_launch --prompt "$*"
}

# ---------------------------------------------------------------------------
# Crash payload review: best-effort secret masking and fail-closed consent
# ---------------------------------------------------------------------------
# Best-effort masking of common secret shapes in the crash payload. Reads the
# payload on stdin, writes the masked payload to stdout, and writes a
# disclosure of every pattern class it masked to stderr. It never edits the
# original payload in place and never suppresses a match silently; the caller
# shows the disclosure next to the reviewed bytes.
mask_secrets() {
    awk '
    BEGIN {
        IGNORECASE = 1
        PROCINFO["sorted_in"] = "@ind_str_asc"
        in_private_key = 0
        total = 0
    }
    function note(label) { count[label]++; total++ }
    {
        line = $0
        if (in_private_key) {
            if (line ~ /-----END [A-Z0-9 ]*PRIVATE KEY-----/) {
                in_private_key = 0
            }
            next
        }
        if (line ~ /-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----/) {
            in_private_key = 1
            note("private-key-block")
            print "[REDACTED PRIVATE KEY]"
            next
        }
        if (line ~ /password[[:space:]]*=[[:space:]]*[^[:space:]]+/) {
            gsub(/password[[:space:]]*=[[:space:]]*[^[:space:]]+/, "password=[REDACTED]", line)
            note("password")
        }
        if (line ~ /bearer[[:space:]]+[A-Za-z0-9._~+\/=-]+/) {
            gsub(/bearer[[:space:]]+[A-Za-z0-9._~+\/=-]+/, "Bearer [REDACTED]", line)
            note("bearer-token")
        }
        if (line ~ /authorization:[[:space:]]*[^[:space:]]/) {
            gsub(/authorization:[[:space:]]*.*/, "Authorization: [REDACTED]", line)
            note("authorization-header")
        }
        if (line ~ /eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/) {
            gsub(/eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/, "[REDACTED JWT]", line)
            note("jwt")
        }
        if (line ~ /AKIA[0-9A-Z]{16}/) { gsub(/AKIA[0-9A-Z]{16}/, "[REDACTED AWS ACCESS KEY]", line); note("aws-access-key") }
        if (line ~ /ASIA[0-9A-Z]{16}/) { gsub(/ASIA[0-9A-Z]{16}/, "[REDACTED AWS ACCESS KEY]", line); note("aws-access-key") }
        if (line ~ /github_pat_[A-Za-z0-9_]{20,}/) { gsub(/github_pat_[A-Za-z0-9_]{20,}/, "[REDACTED GITHUB TOKEN]", line); note("github-token") }
        if (line ~ /gh[pousr]_[A-Za-z0-9]{36,}/) { gsub(/gh[pousr]_[A-Za-z0-9]{36,}/, "[REDACTED GITHUB TOKEN]", line); note("github-token") }
        if (line ~ /sk-[A-Za-z0-9]{20,}/) { gsub(/sk-[A-Za-z0-9]{20,}/, "[REDACTED API TOKEN]", line); note("api-token") }
        if (line ~ /xox[baprs]-[A-Za-z0-9-]{10,}/) { gsub(/xox[baprs]-[A-Za-z0-9-]{10,}/, "[REDACTED SLACK TOKEN]", line); note("slack-token") }
        if (line ~ /AIza[0-9A-Za-z_-]{35}/) { gsub(/AIza[0-9A-Za-z_-]{35}/, "[REDACTED GOOGLE API KEY]", line); note("google-api-key") }
        print line
    }
    END {
        if (total == 0) exit 0
        print "Masked secret patterns (best effort):" > "/dev/stderr"
        for (label in count) print "  " label " (" count[label] ")" > "/dev/stderr"
    }
    '
}

# Remove only the payload files this backend staged, never an arbitrary tree.
crash_staging_cleanup() {
    local dir="${1:-}"
    [[ -n "$dir" && -d "$dir" ]] || return 0
    case "${dir##*/}" in
        workstation-ai-crash.*) ;;
        *) return 0 ;;
    esac
    rm -f -- "$dir/payload" "$dir/disclosure"
    rmdir --ignore-fail-on-non-empty -- "$dir" || true
}

# Show the exact staged payload and send it only on an explicit yes. Runs in
# the terminal opened by cmd_launch --review, so the bytes a person sees are
# the bytes handed to the agent.
cmd_review() {
    local payload_file="" disclosure_file="" agent=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --payload)
                [[ $# -ge 2 ]] || fail "__review: --payload needs a value"
                payload_file="$2"; shift 2 ;;
            --disclosure)
                [[ $# -ge 2 ]] || fail "__review: --disclosure needs a value"
                disclosure_file="$2"; shift 2 ;;
            --agent)
                [[ $# -ge 2 ]] || fail "__review: --agent needs a value"
                agent="$2"; shift 2 ;;
            *) fail "__review: unexpected argument: $1" ;;
        esac
    done

    [[ -n "$payload_file" ]] || fail "the crash payload is missing; nothing was sent"
    [[ -f "$payload_file" && ! -L "$payload_file" && -r "$payload_file" ]] ||
        fail "the crash payload cannot be reviewed; nothing was sent"
    [[ -n "$agent" ]] || fail "no agent was named for the review; nothing was sent"
    is_known "$agent" || fail "unknown agent for the review; nothing was sent"

    local staging
    staging="$(dirname -- "$payload_file")"

    printf '%s\n' "The following payload will be sent to the AI agent:"
    printf '%s\n' "----------------------------------------------------------------"
    cat -- "$payload_file" || {
        crash_staging_cleanup "$staging"
        fail "the crash payload could not be shown; nothing was sent"
    }
    printf '\n%s\n' "----------------------------------------------------------------"
    if [[ -n "$disclosure_file" && -s "$disclosure_file" ]]; then
        cat -- "$disclosure_file" || {
            crash_staging_cleanup "$staging"
            fail "the secret disclosure could not be shown; nothing was sent"
        }
    else
        printf '%s\n' "Secret scan: no known secret patterns matched."
    fi

    local answer=""
    printf 'Send this payload to the AI agent? [y/N] '
    if ! read -r answer; then
        printf '\n%s\n' "No answer was read; nothing was sent."
        crash_staging_cleanup "$staging"
        exit 1
    fi
    case "$answer" in
        y|Y|yes|YES|Yes) ;;
        *)
            printf '%s\n' "Not sent."
            crash_staging_cleanup "$staging"
            exit 1
            ;;
    esac

    local prompt
    prompt="$(cat -- "$payload_file")" || {
        crash_staging_cleanup "$staging"
        fail "the crash payload could not be read; nothing was sent"
    }
    crash_staging_cleanup "$staging"

    build_agent_argv "$agent" "$prompt" readonly
    exec "${argv[@]}"
}

# Diagnose one crash from systemd-coredump metadata. The diagnosis is
# metadata-only: no core is extracted and no process memory is read.
#
# The crash facts arrive as discrete argv words (from the coredump watcher's
# click-to-diagnose notification, or by hand). They are never interpolated
# into a shell command, so a hostile process name cannot become an injection.
# The assembled payload is masked for common secrets and staged for an
# explicit, fail-closed review before any agent sees it.
cmd_crash() {
    local pid="${1:-}" comm="${2:-}" exe="${3:-}" signal_name="${4:-}"
    [[ "$pid" =~ ^[0-9]+$ ]] || fail "usage: $PROG crash <pid> [comm] [exe] [signal]"
    [[ -n "$comm" ]] || comm="unknown"
    [[ -n "$exe" ]] || exe="unknown"
    [[ -n "$signal_name" ]] || signal_name="unknown"

    # Looked up live so a hand-run PID still gets a timestamp. This is metadata
    # only; a core is never dumped.
    local when="unknown"
    if command -v coredumpctl >/dev/null; then
        when="$(coredumpctl list "$pid" --no-pager --no-legend | tail -1 | cut -d' ' -f1-4 || true)"
    fi
    [[ -n "$when" ]] || when="unknown"

    local skill
    skill="$(diagnose_skill_path)"

    local prompt
    prompt=$(
        cat <<PROMPT
A process crashed on this Fedora Hyprland workstation and I want to know why.

What systemd-coredump recorded:
  process:  $comm
  PID:      $pid
  binary:   $exe
  signal:   $signal_name
  time:     $when

Use the diagnose-crash skill. This diagnosis is metadata-only: never extract a
core dump and never read process memory. Work from coredumpctl info, the
journal, and package history. The skill covers how to investigate, what to
report, and when a crash is worth reporting upstream. If your harness has no
skill mechanism, read the skill files directly and follow them instead:

  $skill
PROMPT
    )

    # Stage the masked payload. Nothing is sent until the user has seen these
    # exact bytes and approved them; a failure anywhere here fails closed.
    local staging payload_file disclosure_file masked
    staging="$(mktemp -d "${TMPDIR:-/tmp}/workstation-ai-crash.XXXXXX")" ||
        fail "could not stage the crash review"
    trap 'crash_staging_cleanup "$staging"' EXIT
    chmod 700 -- "$staging" || fail "could not secure the crash review"
    payload_file="$staging/payload"
    disclosure_file="$staging/disclosure"
    masked="$(printf '%s' "$prompt" | mask_secrets 2>"$disclosure_file")" ||
        fail "could not scan the crash payload for secrets"
    printf '%s' "$masked" >"$payload_file" ||
        fail "could not stage the crash payload"
    chmod 600 -- "$payload_file" "$disclosure_file" ||
        fail "could not secure the crash payload"

    # cmd_launch opens a terminal and execs; on success this process is
    # replaced, and __review cleans the staged files. If it fails closed, the
    # EXIT trap above removes them.
    cmd_launch --review "$payload_file" --disclosure "$disclosure_file"
}

usage() {
    cat <<'USAGE'
Usage: workstation-ai <command> [args]

  agents                 List known agents with installed state (JSON).
  default                Print the default agent id.
  set <id>               Persist the default agent.
  reset                  Clear the default agent.
  launch [--prompt TEXT] Launch the default agent in a terminal (unattended mode).
  prompt <text>          Launch the default agent seeded with a task.
  crash <pid> [comm] [exe] [signal]  Review a masked, metadata-only crash
                         payload and diagnose it with the default agent in
                         its most restricted read-only mode.
  subscription [list|set|unset]  Manage subscription plan/renewal metadata.
  usage                  Print collected agent usage records (JSON).
  usage-update [--force] [agent...]  Refresh the usage records.
  skill [status|install|remove]  Manage the workstation agent skill.
  check                  Report backend diagnostics.

This backend detects and launches agents; it never installs them.
USAGE
}

main() {
    local cmd="${1:-}"
    [[ -n "$cmd" ]] || { usage; exit 2; }
    shift || true
    case "$cmd" in
        -h|--help|help) usage ;;
        agents) cmd_agents ;;
        default) read_default ;;
        set)
            [[ $# -eq 1 ]] || fail "usage: $PROG set <id>"
            cmd_set "$1"
            ;;
        reset) cmd_reset ;;
        launch) cmd_launch "$@" ;;
        prompt) cmd_prompt "$@" ;;
        crash) cmd_crash "$@" ;;
        __review) cmd_review "$@" ;;
        subscription) cmd_subscription "$@" ;;
        usage) cmd_usage ;;
        usage-update) cmd_usage_update "$@" ;;
        skill) cmd_skill "$@" ;;
        check) cmd_check ;;
        *) fail "unknown command: $cmd (see --help)" ;;
    esac
}

main "$@"
