#!/usr/bin/env python3
"""
Workstation Hotkey Physical Key Capture
Captures physical key combinations using terminal raw mode and Kitty keyboard protocol.
Isolates Hyprland session during capture to prevent compositor shortcut preemption.
"""

import sys
import os
import termios
import tty
import select
import subprocess
import re

SPECIAL_KEYS = {
    13: "RETURN",
    32: "SPACE",
    9: "TAB",
    27: "ESCAPE",
    127: "BACKSPACE",
    57358: "CAPS_LOCK",
    57373: "UP",
    57374: "DOWN",
    57375: "RIGHT",
    57376: "LEFT",
    57377: "PAGE_UP",
    57378: "PAGE_DOWN",
    57379: "HOME",
    57380: "END",
    57381: "INSERT",
    57382: "DELETE",
}
for i in range(1, 13):
    SPECIAL_KEYS[57382 + i] = f"F{i}"

MODIFIER_KEYS = {
    57441: "SUPER_L", 57442: "SUPER_R",
    57443: "SHIFT_L", 57444: "SHIFT_R",
    57445: "CTRL_L", 57446: "CTRL_R",
    57447: "ALT_L", 57448: "ALT_R",
}

def parse_kitty_sequence(seq):
    m = re.match(r"^\x1b\[(\d+)(?:;(\d+))?(?::(\d+))?u$", seq)
    if not m:
        return False, None
    code = int(m.group(1))
    mods = (int(m.group(2)) - 1) if m.group(2) else 0
    event_type = int(m.group(3)) if m.group(3) else 1

    if event_type == 3:
        return True, "RELEASE"

    if code in MODIFIER_KEYS:
        return True, "MODIFIER_ONLY"

    if code == 27:
        return True, "CANCEL"

    parts = []
    if mods & 8: parts.append("SUPER")
    if mods & 4: parts.append("CTRL")
    if mods & 2: parts.append("ALT")
    if mods & 1: parts.append("SHIFT")

    if code in SPECIAL_KEYS:
        key_name = SPECIAL_KEYS[code]
    elif 33 <= code <= 126:
        key_name = chr(code).upper()
    else:
        key_name = f"KEY_{code}"

    parts.append(key_name)
    return True, " + ".join(parts)

def capture_main():
    mock_input = os.environ.get("HOTKEYS_CAPTURE_MOCK_INPUT")
    if mock_input:
        if mock_input in ("CANCEL", "cancel"):
            return "CANCEL"
        elif mock_input in ("MANUAL", "manual"):
            return "MANUAL"
        elif mock_input in ("UNBIND", "unbind", "none"):
            return "UNBIND"
        else:
            return f"KEY:{mock_input}"

    if not sys.stdin.isatty():
        return "MANUAL"

    fd = sys.stdin.fileno()
    old_attrs = termios.tcgetattr(fd)
    in_submap = False

    try:
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            ret = subprocess.run(["hyprctl", "dispatch", "submap", "hotkey_capture"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if ret.returncode == 0:
                in_submap = True

        tty.setraw(fd)
        sys.stdout.write("\x1b[>1u")
        sys.stdout.flush()

        buf = ""
        while True:
            r, _, _ = select.select([sys.stdin], [], [], 30.0)
            if not r:
                return "CANCEL"

            ch = sys.stdin.read(1)
            if not ch:
                return "CANCEL"

            buf += ch

            if buf == "\x03":
                return "CANCEL"
            elif buf == "\x1b":
                r_esc, _, _ = select.select([sys.stdin], [], [], 0.05)
                if not r_esc:
                    return "CANCEL"
                continue

            if buf.startswith("\x1b[") and buf.endswith("u"):
                ok, res = parse_kitty_sequence(buf)
                buf = ""
                if ok:
                    if res == "MODIFIER_ONLY" or res == "RELEASE":
                        continue
                    elif res == "CANCEL":
                        return "CANCEL"
                    else:
                        return f"KEY:{res}"

            if re.match(r"^\x1b\[([A-D])$", buf):
                direction_map = {"A": "UP", "B": "DOWN", "C": "RIGHT", "D": "LEFT"}
                key = direction_map[buf[2]]
                return f"KEY:{key}"
            elif re.match(r"^\x1b\[1;(\d+)([A-D])$", buf):
                m = re.match(r"^\x1b\[1;(\d+)([A-D])$", buf)
                mod_val = int(m.group(1)) - 1
                direction_map = {"A": "UP", "B": "DOWN", "C": "RIGHT", "D": "LEFT"}
                parts = []
                if mod_val & 8: parts.append("SUPER")
                if mod_val & 4: parts.append("CTRL")
                if mod_val & 2: parts.append("ALT")
                if mod_val & 1: parts.append("SHIFT")
                parts.append(direction_map[m.group(2)])
                return f"KEY:{' + '.join(parts)}"

            if not buf.startswith("\x1b"):
                if buf == "t" or buf == "T":
                    return "MANUAL"
                elif buf == "u" or buf == "U":
                    return "UNBIND"
                elif buf == "q" or buf == "Q":
                    return "CANCEL"
                elif buf == "\r" or buf == "\n":
                    return "KEY:RETURN"
                elif buf == " ":
                    return "KEY:SPACE"
                elif buf == "\t":
                    return "KEY:TAB"
                elif buf == "\x7f" or buf == "\x08":
                    return "KEY:BACKSPACE"
                elif len(buf) == 1 and 32 < ord(buf) < 127:
                    return f"KEY:{buf.upper()}"
                buf = ""

            if len(buf) > 32:
                buf = ""

    finally:
        try:
            sys.stdout.write("\x1b[<u")
            sys.stdout.flush()
        except Exception:
            pass

        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        except Exception:
            pass

        if in_submap:
            subprocess.run(["hyprctl", "dispatch", "submap", "reset"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    result = capture_main()
    if result == "CANCEL":
        print("CANCEL")
        sys.exit(1)
    elif result == "MANUAL":
        print("MANUAL")
        sys.exit(0)
    elif result == "UNBIND":
        print("UNBIND")
        sys.exit(0)
    elif result.startswith("KEY:"):
        print(result)
        sys.exit(0)
    else:
        print("CANCEL")
        sys.exit(1)
