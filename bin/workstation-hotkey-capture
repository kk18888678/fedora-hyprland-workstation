#!/usr/bin/env python3
"""
Workstation Hotkey Physical Key Capture
Captures physical key combinations using terminal raw mode and Kitty keyboard protocol.
Isolates Hyprland session during capture to prevent compositor shortcut preemption.
Guarantees clean, idempotent terminal and submap restoration on any exit or signal.
"""

import sys
import os
import termios
import tty
import select
import subprocess
import re
import signal

SPECIAL_KEYS = {
    13: "RETURN",
    32: "SPACE",
    9: "TAB",
    27: "ESCAPE",
    127: "BACKSPACE",
    57358: "CAPS_LOCK",
    57373: "UP",
    57374: "DOWN",
    57375: "RIGHT",
    57376: "LEFT",
    57377: "PAGE_UP",
    57378: "PAGE_DOWN",
    57379: "HOME",
    57380: "END",
    57381: "INSERT",
    57382: "DELETE",
}
for i in range(1, 13):
    SPECIAL_KEYS[57382 + i] = f"F{i}"

MODIFIER_KEYS = {
    57441: "SUPER_L", 57442: "SUPER_R",
    57443: "SHIFT_L", 57444: "SHIFT_R",
    57445: "CTRL_L", 57446: "CTRL_R",
    57447: "ALT_L", 57448: "ALT_R",
}

def parse_kitty_sequence(seq):
    # Matches Kitty keyboard protocol sequences including sub-arguments in keycode:
    # CSI unicode-key-code[:shifted-key[:base-key]] ; modifiers[:event_type] u
    m = re.match(r"^\x1b\[(\d+)(?::\d+)*(?:;(\d+)(?::(\d+))?)?u$", seq)
    if not m:
        return False, None
    code = int(m.group(1))
    mods = (int(m.group(2)) - 1) if m.group(2) else 0
    event_type = int(m.group(3)) if m.group(3) else 1

    # Event types: 1 = press, 2 = repeat, 3 = release
    if event_type == 3:
        return True, "RELEASE"

    if code in MODIFIER_KEYS:
        return True, "MODIFIER_ONLY"

    if code == 27:
        return True, "CANCEL"

    parts = []
    # Strict canonical modifier order: SUPER -> CTRL -> ALT -> SHIFT -> KEY
    if mods & 8: parts.append("SUPER")
    if mods & 4: parts.append("CTRL")
    if mods & 2: parts.append("ALT")
    if mods & 1: parts.append("SHIFT")

    if code in SPECIAL_KEYS:
        key_name = SPECIAL_KEYS[code]
    elif 33 <= code <= 126:
        key_name = chr(code).upper()
    else:
        key_name = f"KEY_{code}"

    parts.append(key_name)
    return True, " + ".join(parts)

def capture_main():
    mock_input = os.environ.get("HOTKEYS_CAPTURE_MOCK_INPUT")
    if mock_input:
        if mock_input in ("CANCEL", "cancel"):
            return "CANCEL"
        elif mock_input in ("MANUAL", "manual"):
            return "MANUAL"
        elif mock_input in ("UNBIND", "unbind", "none"):
            return "UNBIND"
        else:
            return f"KEY:{mock_input}"

    if not sys.stdin.isatty():
        return "MANUAL"

    tty_fd = sys.stdin.fileno()
    tty_in = sys.stdin

    # Protocol control escape sequences and interactive cues MUST be sent to the controlling
    # terminal (/dev/tty) or sys.stderr, NEVER to sys.stdout (reserved for machine results).
    tty_out = None
    try:
        tty_out = open("/dev/tty", "w")
    except Exception:
        tty_out = sys.stderr

    old_attrs = None
    try:
        old_attrs = termios.tcgetattr(tty_fd)
    except Exception:
        return "MANUAL"

    in_submap = False
    cleaned_up = False

    def cleanup():
        nonlocal cleaned_up, in_submap, old_attrs, tty_fd, tty_out
        if cleaned_up:
            return
        cleaned_up = True

        # Pop Kitty progressive enhancement from the terminal emulator
        if tty_out:
            try:
                tty_out.write("\x1b[<u")
                tty_out.flush()
            except Exception:
                pass

        # Restore terminal raw mode attributes
        if tty_fd is not None and old_attrs is not None:
            try:
                termios.tcsetattr(tty_fd, termios.TCSADRAIN, old_attrs)
            except Exception:
                pass

        # Guarantee Hyprland submap reset to prevent locking global keybindings
        if in_submap:
            try:
                subprocess.run(["hyprctl", "dispatch", "submap", "reset"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            except Exception:
                pass

    def handle_signal(signum, frame):
        cleanup()
        sys.exit(128 + signum)

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT, signal.SIGQUIT):
        try:
            signal.signal(sig, handle_signal)
        except Exception:
            pass

    try:
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            ret = subprocess.run(["hyprctl", "dispatch", "submap", "hotkey_capture"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            if ret.returncode == 0:
                in_submap = True

        tty.setraw(tty_fd)
        # Request Kitty progressive enhancement on controlling terminal
        tty_out.write("\x1b[>1u")
        tty_out.flush()

        buf = ""
        while True:
            r, _, _ = select.select([tty_in], [], [], 30.0)
            if not r:
                return "CANCEL"

            ch = os.read(tty_fd, 1).decode("latin-1", errors="replace")
            if not ch:
                return "CANCEL"

            buf += ch

            if buf == "\x03":  # Ctrl+C
                return "CANCEL"
            elif buf == "\x1b":  # Potential Escape or start of ANSI sequence
                r_esc, _, _ = select.select([tty_in], [], [], 0.05)
                if not r_esc:
                    return "CANCEL"
                continue

            # Parse Kitty keyboard protocol event
            if buf.startswith("\x1b[") and buf.endswith("u"):
                ok, res = parse_kitty_sequence(buf)
                buf = ""
                if ok:
                    if res == "MODIFIER_ONLY" or res == "RELEASE":
                        continue
                    elif res == "CANCEL":
                        return "CANCEL"
                    else:
                        return f"KEY:{res}"

            # Legacy VT arrow keys
            if re.match(r"^\x1b\[([A-D])$", buf):
                direction_map = {"A": "UP", "B": "DOWN", "C": "RIGHT", "D": "LEFT"}
                key = direction_map[buf[2]]
                return f"KEY:{key}"
            elif re.match(r"^\x1b\[1;(\d+)([A-D])$", buf):
                m = re.match(r"^\x1b\[1;(\d+)([A-D])$", buf)
                mod_val = int(m.group(1)) - 1
                direction_map = {"A": "UP", "B": "DOWN", "C": "RIGHT", "D": "LEFT"}
                parts = []
                if mod_val & 8: parts.append("SUPER")
                if mod_val & 4: parts.append("CTRL")
                if mod_val & 2: parts.append("ALT")
                if mod_val & 1: parts.append("SHIFT")
                parts.append(direction_map[m.group(2)])
                return f"KEY:{' + '.join(parts)}"

            # Bare keypresses without escape sequence
            if not buf.startswith("\x1b"):
                if buf in ("t", "T"):
                    return "MANUAL"
                elif buf in ("u", "U"):
                    return "UNBIND"
                elif buf in ("q", "Q"):
                    return "CANCEL"
                elif buf in ("\r", "\n"):
                    return "KEY:RETURN"
                elif buf == " ":
                    return "KEY:SPACE"
                elif buf == "\t":
                    return "KEY:TAB"
                elif buf in ("\x7f", "\x08"):
                    return "KEY:BACKSPACE"
                else:
                    # Fail closed: do NOT silently strip modifiers like Super/Alt on bare ASCII.
                    # Fall back to manual text entry prompt.
                    return "MANUAL"
                buf = ""

            if len(buf) > 32:
                buf = ""

    finally:
        cleanup()

if __name__ == "__main__":
    result = capture_main()
    if result == "CANCEL":
        print("CANCEL")
        sys.exit(1)
    elif result == "MANUAL":
        print("MANUAL")
        sys.exit(0)
    elif result == "UNBIND":
        print("UNBIND")
        sys.exit(0)
    elif result.startswith("KEY:"):
        print(result)
        sys.exit(0)
    else:
        print("CANCEL")
        sys.exit(1)
