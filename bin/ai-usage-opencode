#!/usr/bin/env python3
"""Local-stats OpenCode usage collector for the Aurelia agents panel.

OpenCode keeps per-session token totals in its SQLite database
($XDG_DATA_HOME/opencode/opencode.db, table `session`) and per-turn totals in
the `message` table. Usage is bucketed by each assistant message's own
activity time, falling back to the session's last update, so a session that
spans days is not attributed entirely to its creation day. Because the
database runs in WAL mode and may be open, this collector copies the database
(and its WAL sidecars) into a private temporary directory and reads the copy,
so the live database is never written to or checkpointed.

Prints one display-ready JSON record (the same contract as the other
ai-usage-* collectors). No network calls and no credentials.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shutil
import sqlite3
import sys
import tempfile
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import ai_usage_common as common  # noqa: E402

AGENT_ID = "opencode"
AGENT_NAME = "OpenCode"
GO_USAGE_URL = "https://opencode.ai/zen/go/v1/usage"
GO_WINDOWS = (("rolling", "5h window", 300), ("weekly", "Weekly (7-day)", 10080), ("monthly", "Monthly (30-day)", 43200))


def auth_paths() -> list[Path]:
    home = Path.home()
    return [
        Path(os.environ.get("PI_HOME") or home / ".pi") / "agent" / "auth.json",
        Path(os.environ.get("XDG_DATA_HOME") or home / ".local" / "share") / "opencode" / "auth.json",
    ]


def opencode_go_key() -> str:
    for path in auth_paths():
        if not path.is_file():
            continue
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        entry = data.get("opencode-go") if isinstance(data, dict) else None
        if isinstance(entry, dict):
            key = str(entry.get("key") or "").strip()
            if key:
                return key
    return ""


def fetch_go_limits() -> dict:
    """Live OpenCode Go subscription windows (rolling 5h / weekly / monthly)."""
    key = opencode_go_key()
    if not key:
        return {"limits": [], "usageStatusText": "", "authHelpText": "", "retryAdvised": False}
    try:
        request = urllib.request.Request(
            GO_USAGE_URL,
            headers={
                "Authorization": "Bearer " + key,
                "Accept": "application/json",
                "User-Agent": "aurelia-agent-usage/1.0",
            },
        )
        with urllib.request.urlopen(request, timeout=10) as response:
            payload = json.loads(response.read().decode("utf-8", "replace"))
    except Exception as exc:
        return {
            "limits": [],
            "usageStatusText": "OpenCode Go limits unavailable",
            "authHelpText": str(exc),
            "retryAdvised": common.retry_advised_from_error(exc),
        }

    usage = payload.get("usage") if isinstance(payload, dict) else None
    if not isinstance(usage, dict):
        return {"limits": [], "usageStatusText": "OpenCode Go limits unavailable", "authHelpText": "", "retryAdvised": False}

    limits = []
    for name, label, minutes in GO_WINDOWS:
        window = usage.get(name)
        if not isinstance(window, dict):
            continue
        percent = window.get("percent")
        if percent is None:
            continue
        limits.append({
            "label": label,
            "percent": float(percent) / 100.0,
            # Upstream may send epoch seconds, epoch milliseconds or ISO-8601;
            # normalise so the UI can always derive a reset countdown.
            "resetsAt": common.normalize_resets_at(window.get("resetsAt")),
            "windowMinutes": minutes,
        })
    return {"limits": limits, "usageStatusText": "", "authHelpText": "", "retryAdvised": False}


def number(value) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def data_home() -> Path:
    return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")


def database_path() -> Path:
    return data_home() / "opencode" / "opencode.db"


def local_date_string() -> str:
    return dt.datetime.now().strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
    today = dt.datetime.now().date()
    return [(today - dt.timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def local_date_from_millis(value) -> str:
    try:
        millis = float(value)
        if millis <= 0:
            return local_date_string()
        return dt.datetime.fromtimestamp(millis / 1000.0).strftime("%Y-%m-%d")
    except Exception:
        return local_date_string()


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def model_name(value) -> str:
    if isinstance(value, dict):
        return str(value.get("id") or value.get("modelID") or value.get("name") or "opencode")
    text = str(value or "").strip()
    if not text:
        return "opencode"
    try:
        parsed = json.loads(text)
    except Exception:
        return text
    if isinstance(parsed, dict):
        return str(parsed.get("id") or parsed.get("modelID") or parsed.get("name") or text)
    return text


def copy_database(source: Path, staging: Path) -> Path:
    target = staging / "opencode.db"
    shutil.copy2(source, target)
    for suffix in ("-wal", "-shm"):
        sidecar = source.with_name(source.name + suffix)
        if sidecar.is_file():
            shutil.copy2(sidecar, staging / (target.name + suffix))
    return target


def _scan_messages(con, add) -> bool:
    """Bucket per-assistant-message usage by its real activity time.

    OpenCode stores cumulative token totals on the `session` row, but each
    assistant `message` row carries the tokens produced by that turn and the
    time it ran. Using the message time keeps a session that spans days from
    attributing every token to the session's creation day.
    """
    try:
        rows = con.execute("select id, session_id, time_created, data from message")
    except sqlite3.Error:
        return False
    found = False
    for message_id, session_id, created, data in rows:
        try:
            document = json.loads(data)
        except Exception:
            continue
        if not isinstance(document, dict) or document.get("role") != "assistant":
            continue
        tokens = document.get("tokens") if isinstance(document.get("tokens"), dict) else None
        if not tokens:
            continue
        cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
        input_tokens = number(tokens.get("input"))
        output_tokens = number(tokens.get("output")) + number(tokens.get("reasoning"))
        cache_read = number(cache.get("read"))
        cache_write = number(cache.get("write"))
        model = model_name(document.get("modelID") or document.get("model") or "opencode")
        activity = document.get("time") if isinstance(document.get("time"), dict) else {}
        timestamp = activity.get("created") or activity.get("completed") or created
        if add(
            local_date_from_millis(timestamp),
            model,
            str(session_id or message_id),
            input_tokens,
            output_tokens,
            cache_read,
            cache_write,
        ):
            found = True
    return found


def _scan_sessions(con, add) -> bool:
    """Fallback for databases without per-message usage: last activity time.

    `time_updated` is the session's most recent activity, so it is a better
    day bucket than `time_created` even though it cannot split a multi-day
    session.
    """
    try:
        rows = con.execute(
            "select id, model, tokens_input, tokens_output, tokens_reasoning, "
            "tokens_cache_read, tokens_cache_write, time_created, time_updated "
            "from session"
        )
    except sqlite3.Error:
        return False
    found = False
    for session_id, model_raw, input_tokens, output_tokens, reasoning, cache_read, cache_write, created, updated in rows:
        input_tokens = number(input_tokens)
        output_tokens = number(output_tokens) + number(reasoning)
        cache_read = number(cache_read)
        cache_write = number(cache_write)
        if add(
            local_date_from_millis(updated or created),
            model_name(model_raw),
            str(session_id),
            input_tokens,
            output_tokens,
            cache_read,
            cache_write,
        ):
            found = True
    return found


def scan() -> dict:
    today = local_date_string()
    recent_dates = recent_date_strings()
    recent = {day: common.empty_day(day) for day in recent_dates}

    sessions: set[str] = set()
    active_days: set[str] = set()
    today_sessions: set[str] = set()
    today_by_model: dict[str, dict[str, int]] = {}
    usage_by_model: dict[str, dict[str, int]] = {}

    def add(day, model, session_key, input_tokens, output_tokens, cache_read, cache_write) -> bool:
        total = input_tokens + output_tokens + cache_read + cache_write
        if total <= 0:
            return False
        sessions.add(session_key)
        active_days.add(day)
        billable = input_tokens + output_tokens
        cache = cache_read + cache_write
        bucket = usage_by_model.setdefault(model, empty_bucket())
        bucket["inputTokens"] += input_tokens
        bucket["outputTokens"] += output_tokens
        bucket["cacheReadInputTokens"] += cache_read
        bucket["cacheCreationInputTokens"] += cache_write
        if day in recent:
            entry = recent[day]
            entry["tokens"] += total
            entry["billableTokens"] += billable
            entry["cacheTokens"] += cache
        if day == today:
            today_sessions.add(session_key)
            today_bucket = today_by_model.setdefault(model, empty_bucket())
            today_bucket["inputTokens"] += input_tokens
            today_bucket["outputTokens"] += output_tokens
            today_bucket["cacheReadInputTokens"] += cache_read
            today_bucket["cacheCreationInputTokens"] += cache_write
        return True

    source = database_path()
    if not source.is_file():
        return _result(recent, recent_dates, usage_by_model, today_by_model, sessions, active_days, today_sessions)

    staging = Path(tempfile.mkdtemp(prefix="aurelia-opencode-"))
    try:
        copy = copy_database(source, staging)
        con = sqlite3.connect(copy)
        try:
            if not _scan_messages(con, add):
                _scan_sessions(con, add)
        finally:
            con.close()
    except Exception as exc:  # pragma: no cover - locked or corrupt database only
        print(f"Ignoring unreadable OpenCode database {source}: {exc}", file=sys.stderr)
    finally:
        shutil.rmtree(staging, ignore_errors=True)

    return _result(recent, recent_dates, usage_by_model, today_by_model, sessions, active_days, today_sessions)


def _result(recent, recent_dates, usage_by_model, today_by_model, sessions, active_days, today_sessions) -> dict:
    today_split = common.today_model_split(today_by_model)
    return {
        "todayPrompts": len(today_sessions),
        "todaySessions": len(today_sessions),
        "todayTotalTokens": sum(v["totalTokens"] for v in today_split.values()),
        "todayBillableTokens": sum(v["billableTokens"] for v in today_split.values()),
        "todayCacheTokens": sum(v["cacheTokens"] for v in today_split.values()),
        "todayTokensByModel": today_split,
        "recentDays": [common.finalize_day(recent[day]) for day in recent_dates],
        "modelUsage": common.finalize_model_buckets(usage_by_model),
        "totalPrompts": len(sessions),
        "totalSessions": len(sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true", help="accepted for collector parity; local scans are always fresh")
    parser.parse_args()

    stats = common.merge_stats(scan(), common.scan_pi_sessions(["opencode"]))
    go = fetch_go_limits()
    detected = database_path().is_file() or bool(stats.get("detected")) or len(go["limits"]) > 0
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": number(stats.get("totalPrompts")) > 0 or len(go["limits"]) > 0,
        "detected": detected,
        "hasLocalStats": detected,
        "hasPromptStats": True,
        "tierLabel": "OpenCode Go" if go["limits"] else "",
        # OpenCode records one session, not a chat prompt.
        "todayLabel": "sessions",
        "retryAdvised": bool(go.get("retryAdvised")),
        "usageStatusText": go["usageStatusText"],
        "authHelpText": go["authHelpText"],
        "limits": go["limits"],
    }
    record.update(stats)
    record["detected"] = detected
    record["hasLocalStats"] = detected
    common.apply_subscription(record, AGENT_ID)
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
