#!/usr/bin/env bash
# workstation-system-settings — bounded user-level system settings backend.
#
# Exposes a validated set of live system settings to the Aurelia settings hub:
# appearance (GTK/icon/cursor/font via gsettings), audio (default output/input
# via wpctl), Bluetooth, network, date & time, power profile and brightness.
# Every operation is a bounded, single-purpose command run as the invoking user
# (never root); authorization is whatever polkit/logind/dconf grants the active
# session, and failures are reported, never hidden.
#
# Safety invariants:
#   * strict option schema: unknown ids and invalid values fail closed
#   * bounded external operations (timeout around every tool call)
#   * no configuration files are written by this backend; it applies live
#     state through the owning tool so the tool remains the single owner
#   * a missing tool degrades to read-only defaults and a clear write error

set -Eeuo pipefail

PROG="workstation-system-settings"

# ---------------------------------------------------------------------------
# Bounded external operations
# ---------------------------------------------------------------------------
TIME_BIN="${WORKSTATION_SYSTEM_SETTINGS_TIMEOUT_BIN:-$(command -v timeout || true)}"
if [[ -z "$TIME_BIN" ]]; then
    printf '%s\n' "Error: timeout is required." >&2
    exit 1
fi

tool_bin() {
    local override="$1" name="$2"
    if [[ -n "$override" && -x "$override" ]]; then
        printf '%s\n' "$override"
        return 0
    fi
    command -v "$name" 2>/dev/null || true
}

POWERPROFILES_BIN="$(tool_bin "${WORKSTATION_SYSTEM_SETTINGS_POWERPROFILES_BIN:-}" powerprofilesctl)"
BRIGHTNESS_BIN="$(tool_bin "${WORKSTATION_SYSTEM_SETTINGS_BRIGHTNESS_BIN:-}" brightnessctl)"
WPCTL_BIN="$(tool_bin "${WORKSTATION_SYSTEM_SETTINGS_WPCTL_BIN:-}" wpctl)"
NMCLI_BIN="$(tool_bin "${WORKSTATION_SYSTEM_SETTINGS_NMCLI_BIN:-}" nmcli)"
TIMEDATECTL_BIN="$(tool_bin "${WORKSTATION_SYSTEM_SETTINGS_TIMEDATECTL_BIN:-}" timedatectl)"
GSETTINGS_BIN="$(tool_bin "${WORKSTATION_SYSTEM_SETTINGS_GSETTINGS_BIN:-}" gsettings)"
BLUETOOTHCTL_BIN="$(tool_bin "${WORKSTATION_SYSTEM_SETTINGS_BLUETOOTHCTL_BIN:-}" bluetoothctl)"

bounded() {
    "$TIME_BIN" --kill-after=1s 5s "$@"
}

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Option schema registry
# ---------------------------------------------------------------------------
# Fields: id|type|min|max|enum|category|default|label|description
# Types: bool, int, float, enum, denum (dynamic enum resolved from status)
option_specs() {
    cat <<'EOF'
system.power.profile|enum|||power-saver,balanced,performance|power|balanced|Power Profile|CPU and GPU power/performance balance
system.display.brightness|int|1|100||display|-|Screen Brightness|Brightness of the primary display (%)
system.appearance.gtk_theme|denum||||appearance|-|GTK Theme|GTK widget theme for applications
system.appearance.icon_theme|denum||||appearance|-|Icon Theme|Icon theme for applications
system.appearance.cursor_theme|denum||||appearance|-|Cursor Theme|Mouse cursor theme
system.appearance.cursor_size|int|16|96||appearance|24|Cursor Size|Mouse cursor size in pixels
system.appearance.color_scheme|enum|||default,prefer-dark,prefer-light|appearance|prefer-dark|Color Scheme|Light or dark application preference
system.appearance.accent_color|enum|||blue,teal,green,yellow,orange,red,pink,purple,slate|appearance|blue|Accent Color|Accent color for GTK applications
system.appearance.text_scaling|float|0.5|3||appearance|1.0|Text Scaling|Global text scaling factor
system.appearance.enable_animations|bool||||appearance|true|Interface Animations|Animate GTK interface elements
system.appearance.show_battery_percentage|bool||||appearance|false|Battery Percentage|Show the battery percentage in the bar
system.time.clock_24h|bool||||time|true|24-Hour Clock|Use a 24-hour clock format
system.time.show_seconds|bool||||time|false|Show Seconds|Show seconds in the clock
system.time.show_date|bool||||time|true|Show Date|Show the date in the clock
system.time.show_weekday|bool||||time|false|Show Weekday|Show the weekday in the clock
system.audio.output_volume|int|0|100||audio|-|Output Volume|Volume of the default audio output (%)
system.audio.output_mute|bool||||audio|false|Mute Output|Mute the default audio output
system.audio.input_volume|int|0|100||audio|-|Input Volume|Volume of the default audio input (%)
system.audio.input_mute|bool||||audio|false|Mute Input|Mute the default audio input
system.audio.output_device|denum||||audio|-|Output Device|Default audio output device
system.audio.input_device|denum||||audio|-|Input Device|Default audio input device
system.bluetooth.enabled|bool||||bluetooth|-|Bluetooth|Enable the Bluetooth adapter
system.bluetooth.discoverable|bool||||bluetooth|false|Discoverable|Allow other devices to find this computer
system.network.wifi_enabled|bool||||network|-|Wi-Fi|Enable the Wi-Fi radio
system.network.saved_connection|denum||||network|-|Saved Network|Connect to a saved Wi-Fi network
system.time.ntp|bool||||time|-|Automatic Time|Synchronize the clock with network time
system.time.timezone|denum||||time|-|Time Zone|System time zone
EOF
}

spec_for() {
    option_specs | awk -F'|' -v id="$1" '$1 == id { print }'
}

spec_field() {
    printf '%s\n' "$1" | awk -F'|' -v n="$2" '{ print $n }'
}

# ---------------------------------------------------------------------------
# Dynamic option sources (value<TAB>label)
# ---------------------------------------------------------------------------
list_unique() {
    awk -F'\t' '!seen[$1]++'
}

list_theme_names() {
    local d e
    for d in /usr/share/themes "$HOME/.themes" "$HOME/.local/share/themes"; do
        [[ -d "$d" && ! -L "$d" ]] || continue
        for e in "$d"/*; do
            [[ -d "$e" && ! -L "$e" ]] || continue
            printf '%s\t%s\n' "$(basename "$e")" "$(basename "$e")"
        done
    done | list_unique
}

list_icon_names() {
    local d e
    for d in /usr/share/icons "$HOME/.icons" "$HOME/.local/share/icons"; do
        [[ -d "$d" && ! -L "$d" ]] || continue
        for e in "$d"/*; do
            [[ -d "$e" && ! -L "$e" ]] || continue
            [[ -f "$e/index.theme" || -d "$e/cursors" ]] || continue
            printf '%s\t%s\n' "$(basename "$e")" "$(basename "$e")"
        done
    done | list_unique
}

list_cursor_names() {
    local d e
    for d in /usr/share/icons "$HOME/.icons" "$HOME/.local/share/icons"; do
        [[ -d "$d" && ! -L "$d" ]] || continue
        for e in "$d"/*; do
            [[ -d "$e/cursors" && ! -L "$e" ]] || continue
            printf '%s\t%s\n' "$(basename "$e")" "$(basename "$e")"
        done
    done | list_unique
}

# PipeWire node ids for a wpctl status section (Sinks or Sources).
wpctl_section_ids() {
    [[ -n "$WPCTL_BIN" ]] || return 1
    bounded "$WPCTL_BIN" status 2>/dev/null | awk -v want="$1" '
        /:[[:space:]]*$/ {
            if (match($0, /[A-Za-z]+:/)) section = substr($0, RSTART, RLENGTH - 1)
        }
        section == want {
            if (match($0, /[0-9]+\./)) {
                id = substr($0, RSTART, RLENGTH - 1)
                rest = substr($0, RSTART + RLENGTH)
                sub(/^[[:space:]]+/, "", rest)
                sub(/[[:space:]]+\[vol.*/, "", rest)
                sub(/[[:space:]]+$/, "", rest)
                if (rest != "") print id "\t" rest
            }
        }'
}

read_default_device() {
    [[ -n "$WPCTL_BIN" ]] || return 1
    bounded "$WPCTL_BIN" status 2>/dev/null | awk -v want="$1" '
        /:[[:space:]]*$/ {
            if (match($0, /[A-Za-z]+:/)) section = substr($0, RSTART, RLENGTH - 1)
        }
        section == want && index($0, "*") && match($0, /[0-9]+\./) {
            print substr($0, RSTART, RLENGTH - 1); exit
        }'
}

list_timezones() {
    [[ -n "$TIMEDATECTL_BIN" ]] || return 1
    bounded "$TIMEDATECTL_BIN" list-timezones 2>/dev/null | while IFS= read -r zone; do
        [[ -n "$zone" ]] || continue
        printf '%s\t%s\n' "$zone" "$zone"
    done
}

list_saved_wifi() {
    [[ -n "$NMCLI_BIN" ]] || return 1
    bounded "$NMCLI_BIN" -t -f TYPE,NAME connection show 2>/dev/null | while IFS= read -r line; do
        [[ "$line" == *wireless* ]] || continue
        local name="${line#*:}"
        [[ -n "$name" && "$name" != "$line" ]] || continue
        printf '%s\t%s\n' "$name" "$name"
    done | list_unique
}

read_saved_wifi() {
    [[ -n "$NMCLI_BIN" ]] || return 1
    local out
    out="$(bounded "$NMCLI_BIN" -t -f ACTIVE,TYPE,NAME connection show 2>/dev/null || true)"
    [[ -n "$out" ]] || return 1
    printf '%s\n' "$out" | while IFS= read -r line; do
        local active="${line%%:*}" rest="${line#*:}" type name
        type="${rest%%:*}"
        name="${rest#*:}"
        [[ "$active" == "yes" && "$type" == *wireless* ]] || continue
        printf '%s\n' "$name"
    done
}

dynamic_options() {
    local id="$1"
    case "$id" in
        system.appearance.gtk_theme) list_theme_names ;;
        system.appearance.icon_theme) list_icon_names ;;
        system.appearance.cursor_theme) list_cursor_names ;;
        system.audio.output_device) wpctl_section_ids Sinks ;;
        system.audio.input_device) wpctl_section_ids Sources ;;
        system.network.saved_connection) list_saved_wifi ;;
        system.time.timezone) list_timezones ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------------------
# Value validation
# ---------------------------------------------------------------------------
validate_value() {
    local id="$1" value="$2" spec type min max enum
    spec="$(spec_for "$id")"
    [[ -n "$spec" ]] || fail "unknown option id: $id"
    type="$(spec_field "$spec" 2)"
    min="$(spec_field "$spec" 3)"
    max="$(spec_field "$spec" 4)"
    enum="$(spec_field "$spec" 5)"

    case "$type" in
        bool)
            case "$value" in
                true|1)  printf '%s\n' true ;;
                false|0) printf '%s\n' false ;;
                *) fail "invalid boolean value for $id: $value" ;;
            esac
            ;;
        int)
            [[ "$value" =~ ^-?[0-9]+$ ]] || fail "invalid integer for $id: $value"
            if [[ -n "$min" && "$value" -lt "$min" ]]; then
                fail "value for $id below minimum $min"
            fi
            if [[ -n "$max" && "$value" -gt "$max" ]]; then
                fail "value for $id above maximum $max"
            fi
            printf '%s\n' "$value"
            ;;
        float)
            [[ "$value" =~ ^-?[0-9]*\.?[0-9]+$ ]] || fail "invalid number for $id: $value"
            awk -v min="$min" -v max="$max" -v v="$value" -v id="$id" '
                BEGIN {
                    n = v + 0
                    if (n < min || n > max) {
                        printf "value for %s outside [%s, %s]\n", id, min, max > "/dev/stderr"
                        exit 1
                    }
                    if (n == int(n)) printf "%d\n", n
                    else printf "%.4f\n", n
                }'
            ;;
        enum)
            local found=0 entry IFS=','
            for entry in $enum; do
                if [[ "$value" == "$entry" ]]; then
                    found=1
                    break
                fi
            done
            (( found == 1 )) || fail "invalid value for $id: $value (expected one of: $enum)"
            printf '%s\n' "$value"
            ;;
        denum)
            local found=0 entry
            while IFS=$'\t' read -r entry _label; do
                if [[ "$value" == "$entry" ]]; then
                    found=1
                    break
                fi
            done < <(dynamic_options "$id" 2>/dev/null || true)
            (( found == 1 )) || fail "invalid value for $id: $value"
            printf '%s\n' "$value"
            ;;
        *)
            fail "unsupported schema type for $id: $type"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# gsettings helpers
# ---------------------------------------------------------------------------
GS_SCHEMA="org.gnome.desktop.interface"

gsettings_get() {
    [[ -n "$GSETTINGS_BIN" ]] || return 1
    local out
    out="$(bounded "$GSETTINGS_BIN" get "$GS_SCHEMA" "$1" 2>/dev/null | head -n 1 || true)"
    [[ -n "$out" ]] || return 1
    printf '%s\n' "$out"
}

gsettings_get_string() {
    local out
    out="$(gsettings_get "$1")" || return 1
    out="${out%\'}"
    out="${out#\'}"
    printf '%s\n' "$out"
}

gsettings_get_bool() {
    local out
    out="$(gsettings_get "$1")" || return 1
    case "$out" in
        true) printf 'true\n' ;;
        false) printf 'false\n' ;;
        *) return 1 ;;
    esac
}

gsettings_set() {
    [[ -n "$GSETTINGS_BIN" ]] || fail "gsettings is not available"
    bounded "$GSETTINGS_BIN" set "$GS_SCHEMA" "$1" "$2" >/dev/null 2>&1 ||
        fail "could not set $1"
}

# ---------------------------------------------------------------------------
# Readers (one per option; all bounded, none fatal)
# ---------------------------------------------------------------------------
read_power_profile() {
    [[ -n "$POWERPROFILES_BIN" ]] || return 1
    local out
    out="$(bounded "$POWERPROFILES_BIN" get 2>/dev/null | head -n 1 || true)"
    [[ "$out" == "power-saver" || "$out" == "balanced" || "$out" == "performance" ]] || return 1
    printf '%s\n' "$out"
}

read_brightness() {
    [[ -n "$BRIGHTNESS_BIN" ]] || return 1
    local cur max
    cur="$(bounded "$BRIGHTNESS_BIN" get 2>/dev/null | head -n 1 || true)"
    max="$(bounded "$BRIGHTNESS_BIN" max 2>/dev/null | head -n 1 || true)"
    [[ "$cur" =~ ^[0-9]+$ && "$max" =~ ^[0-9]+$ ]] || return 1
    (( max > 0 )) || return 1
    awk -v c="$cur" -v m="$max" 'BEGIN { p = int(c * 100 / m + 0.5); if (p < 1) p = 1; if (p > 100) p = 100; print p }'
}

read_audio_volume() {
    [[ -n "$WPCTL_BIN" ]] || return 1
    local out
    out="$(bounded "$WPCTL_BIN" get-volume "$1" 2>/dev/null | head -n 1 || true)"
    [[ "$out" =~ Volume:[[:space:]]+([0-9.]+) ]] || return 1
    awk -v v="${BASH_REMATCH[1]}" 'BEGIN { p = int(v * 100 + 0.5); if (p < 0) p = 0; if (p > 100) p = 100; print p }'
}

read_audio_mute() {
    [[ -n "$WPCTL_BIN" ]] || return 1
    local out
    out="$(bounded "$WPCTL_BIN" get-volume "$1" 2>/dev/null | head -n 1 || true)"
    [[ -n "$out" ]] || return 1
    if [[ "$out" == *MUTED* ]]; then printf 'true\n'; else printf 'false\n'; fi
}

read_bluetooth_field() {
    [[ -n "$BLUETOOTHCTL_BIN" ]] || return 1
    local field="$1" out
    out="$(bounded "$BLUETOOTHCTL_BIN" show 2>/dev/null || true)"
    [[ -n "$out" ]] || return 1
    local value
    value="$(printf '%s\n' "$out" | awk -v f="$field:" '$1 == f { print $2; exit }')"
    case "$value" in
        yes) printf 'true\n' ;;
        no) printf 'false\n' ;;
        *) return 1 ;;
    esac
}

read_wifi_enabled() {
    [[ -n "$NMCLI_BIN" ]] || return 1
    local out
    out="$(bounded "$NMCLI_BIN" radio wifi 2>/dev/null | head -n 1 || true)"
    case "$out" in
        enabled) printf 'true\n' ;;
        disabled) printf 'false\n' ;;
        *) return 1 ;;
    esac
}

read_ntp() {
    [[ -n "$TIMEDATECTL_BIN" ]] || return 1
    local out
    out="$(bounded "$TIMEDATECTL_BIN" show -p NTP --value 2>/dev/null | head -n 1 || true)"
    case "$out" in
        yes) printf 'true\n' ;;
        no) printf 'false\n' ;;
        *) return 1 ;;
    esac
}

read_timezone() {
    [[ -n "$TIMEDATECTL_BIN" ]] || return 1
    local out
    out="$(bounded "$TIMEDATECTL_BIN" show -p Timezone --value 2>/dev/null | head -n 1 || true)"
    [[ -n "$out" ]] || return 1
    printf '%s\n' "$out"
}

read_value() {
    local id="$1"
    case "$id" in
        system.power.profile) read_power_profile ;;
        system.display.brightness) read_brightness ;;
        system.appearance.gtk_theme) gsettings_get_string gtk-theme ;;
        system.appearance.icon_theme) gsettings_get_string icon-theme ;;
        system.appearance.cursor_theme) gsettings_get_string cursor-theme ;;
        system.appearance.cursor_size) gsettings_get cursor-size ;;
        system.appearance.color_scheme) gsettings_get_string color-scheme ;;
        system.appearance.accent_color) gsettings_get_string accent-color ;;
        system.appearance.text_scaling) gsettings_get text-scaling-factor ;;
        system.appearance.enable_animations) gsettings_get_bool enable-animations ;;
        system.appearance.show_battery_percentage) gsettings_get_bool show-battery-percentage ;;
        system.appearance.clock_24h|system.time.clock_24h)
            local fmt
            fmt="$(gsettings_get_string clock-format)" || return 1
            if [[ "$fmt" == "24h" ]]; then printf 'true\n'; else printf 'false\n'; fi
            ;;
        system.appearance.show_seconds|system.time.show_seconds) gsettings_get_bool clock-show-seconds ;;
        system.appearance.show_date|system.time.show_date) gsettings_get_bool clock-show-date ;;
        system.appearance.show_weekday|system.time.show_weekday) gsettings_get_bool clock-show-weekday ;;
        system.audio.output_volume) read_audio_volume @DEFAULT_AUDIO_SINK@ ;;
        system.audio.output_mute) read_audio_mute @DEFAULT_AUDIO_SINK@ ;;
        system.audio.input_volume) read_audio_volume @DEFAULT_AUDIO_SOURCE@ ;;
        system.audio.input_mute) read_audio_mute @DEFAULT_AUDIO_SOURCE@ ;;
        system.audio.output_device) read_default_device Sinks ;;
        system.audio.input_device) read_default_device Sources ;;
        system.bluetooth.enabled) read_bluetooth_field Powered ;;
        system.bluetooth.discoverable) read_bluetooth_field Discoverable ;;
        system.network.wifi_enabled) read_wifi_enabled ;;
        system.network.saved_connection) read_saved_wifi ;;
        system.time.ntp) read_ntp ;;
        system.time.timezone) read_timezone ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------------------
# Writers (one per option; bounded, output discarded, failure reported)
# ---------------------------------------------------------------------------
write_value() {
    local id="$1" value="$2"
    case "$id" in
        system.power.profile)
            [[ -n "$POWERPROFILES_BIN" ]] || fail "powerprofilesctl is not available"
            bounded "$POWERPROFILES_BIN" set "$value" >/dev/null 2>&1 ||
                fail "could not set power profile (polkit may have denied the request)"
            ;;
        system.display.brightness)
            [[ -n "$BRIGHTNESS_BIN" ]] || fail "brightnessctl is not available"
            bounded "$BRIGHTNESS_BIN" set "$value%" >/dev/null 2>&1 ||
                fail "could not set display brightness"
            ;;
        system.appearance.gtk_theme)
            gsettings_set gtk-theme "'$value'" ;;
        system.appearance.icon_theme)
            gsettings_set icon-theme "'$value'" ;;
        system.appearance.cursor_theme)
            gsettings_set cursor-theme "'$value'" ;;
        system.appearance.cursor_size)
            gsettings_set cursor-size "$value" ;;
        system.appearance.color_scheme)
            gsettings_set color-scheme "'$value'" ;;
        system.appearance.accent_color)
            gsettings_set accent-color "'$value'" ;;
        system.appearance.text_scaling)
            gsettings_set text-scaling-factor "$value" ;;
        system.appearance.enable_animations)
            gsettings_set enable-animations "$value" ;;
        system.appearance.show_battery_percentage)
            gsettings_set show-battery-percentage "$value" ;;
        system.appearance.clock_24h|system.time.clock_24h)
            if [[ "$value" == "true" ]]; then gsettings_set clock-format "'24h'"; else gsettings_set clock-format "'12h'"; fi
            ;;
        system.appearance.show_seconds|system.time.show_seconds)
            gsettings_set clock-show-seconds "$value" ;;
        system.appearance.show_date|system.time.show_date)
            gsettings_set clock-show-date "$value" ;;
        system.appearance.show_weekday|system.time.show_weekday)
            gsettings_set clock-show-weekday "$value" ;;
        system.audio.output_volume)
            [[ -n "$WPCTL_BIN" ]] || fail "wpctl is not available"
            bounded "$WPCTL_BIN" set-volume @DEFAULT_AUDIO_SINK@ "$value%" >/dev/null 2>&1 ||
                fail "could not set output volume"
            ;;
        system.audio.input_volume)
            [[ -n "$WPCTL_BIN" ]] || fail "wpctl is not available"
            bounded "$WPCTL_BIN" set-volume @DEFAULT_AUDIO_SOURCE@ "$value%" >/dev/null 2>&1 ||
                fail "could not set input volume"
            ;;
        system.audio.output_mute|system.audio.input_mute)
            [[ -n "$WPCTL_BIN" ]] || fail "wpctl is not available"
            local node="@DEFAULT_AUDIO_SINK@" flag=0
            [[ "$id" == "system.audio.input_mute" ]] && node="@DEFAULT_AUDIO_SOURCE@"
            [[ "$value" == "true" ]] && flag=1
            bounded "$WPCTL_BIN" set-mute "$node" "$flag" >/dev/null 2>&1 ||
                fail "could not change mute state"
            ;;
        system.audio.output_device|system.audio.input_device)
            [[ -n "$WPCTL_BIN" ]] || fail "wpctl is not available"
            bounded "$WPCTL_BIN" set-default "$value" >/dev/null 2>&1 ||
                fail "could not set default audio device"
            ;;
        system.bluetooth.enabled)
            [[ -n "$BLUETOOTHCTL_BIN" ]] || fail "bluetoothctl is not available"
            local power="off"
            [[ "$value" == "true" ]] && power="on"
            bounded "$BLUETOOTHCTL_BIN" power "$power" >/dev/null 2>&1 ||
                fail "could not change Bluetooth power"
            ;;
        system.bluetooth.discoverable)
            [[ -n "$BLUETOOTHCTL_BIN" ]] || fail "bluetoothctl is not available"
            local disc="off"
            [[ "$value" == "true" ]] && disc="on"
            bounded "$BLUETOOTHCTL_BIN" discoverable "$disc" >/dev/null 2>&1 ||
                fail "could not change Bluetooth discoverable state"
            ;;
        system.network.wifi_enabled)
            [[ -n "$NMCLI_BIN" ]] || fail "nmcli is not available"
            local radio="off"
            [[ "$value" == "true" ]] && radio="on"
            bounded "$NMCLI_BIN" radio wifi "$radio" >/dev/null 2>&1 ||
                fail "could not change the Wi-Fi radio (polkit may have denied the request)"
            ;;
        system.network.saved_connection)
            [[ -n "$NMCLI_BIN" ]] || fail "nmcli is not available"
            bounded "$NMCLI_BIN" connection up "$value" >/dev/null 2>&1 ||
                fail "could not activate the saved connection"
            ;;
        system.time.ntp)
            [[ -n "$TIMEDATECTL_BIN" ]] || fail "timedatectl is not available"
            bounded "$TIMEDATECTL_BIN" set-ntp "$value" >/dev/null 2>&1 ||
                fail "could not change automatic time (polkit may have denied the request)"
            ;;
        system.time.timezone)
            [[ -n "$TIMEDATECTL_BIN" ]] || fail "timedatectl is not available"
            bounded "$TIMEDATECTL_BIN" set-timezone "$value" >/dev/null 2>&1 ||
                fail "could not change the time zone (polkit may have denied the request)"
            ;;
        *)
            fail "unknown option id: $id"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# JSON helpers
# ---------------------------------------------------------------------------
json_string() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '"%s"' "$s"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_schema() {
    printf '[\n'
    local first=1 line
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        (( first )) || printf ',\n'
        first=0
        printf '  { "id": %s, "type": %s, "min": %s, "max": %s, "enum": %s, "category": %s, "default": %s, "label": %s, "description": %s }' \
            "$(json_string "$(spec_field "$line" 1)")" \
            "$(json_string "$(spec_field "$line" 2)")" \
            "$(json_string "$(spec_field "$line" 3)")" \
            "$(json_string "$(spec_field "$line" 4)")" \
            "$(json_string "$(spec_field "$line" 5)")" \
            "$(json_string "$(spec_field "$line" 6)")" \
            "$(json_string "$(spec_field "$line" 7)")" \
            "$(json_string "$(spec_field "$line" 8)")" \
            "$(json_string "$(spec_field "$line" 9)")"
    done < <(option_specs)
    printf '\n]\n'
}

cmd_status() {
    local first=1 line id live effective source default_val type options_json entry
    printf '{\n  "options": ['
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        id="$(spec_field "$line" 1)"
        type="$(spec_field "$line" 2)"
        default_val="$(spec_field "$line" 7)"
        live=""
        if live="$(read_value "$id" 2>/dev/null)"; then
            effective="$live"
            source="live"
        else
            live=""
            effective="${default_val:--}"
            source="default"
        fi
        options_json="null"
        if [[ "$type" == "denum" ]]; then
            local first_opt=1
            options_json="["
            while IFS=$'\t' read -r entry opt_label; do
                [[ -n "$entry" ]] || continue
                (( first_opt )) || options_json+=", "
                first_opt=0
                options_json+="{ \"value\": $(json_string "$entry"), \"label\": $(json_string "${opt_label:-$entry}") }"
            done < <(dynamic_options "$id" 2>/dev/null || true)
            options_json+="]"
        fi
        (( first )) || printf ',\n'
        first=0
        printf '    { "id": %s, "label": %s, "category": %s, "type": %s, "default": %s, "live": %s, "effective": %s, "source": %s, "options": %s }' \
            "$(json_string "$id")" \
            "$(json_string "$(spec_field "$line" 8)")" \
            "$(json_string "$(spec_field "$line" 6)")" \
            "$(json_string "$type")" \
            "$(json_string "$default_val")" \
            "$([[ -n "$live" ]] && json_string "$live" || printf null)" \
            "$(json_string "$effective")" \
            "$(json_string "$source")" \
            "$options_json"
    done < <(option_specs)
    printf '\n  ]\n}\n'
}

cmd_get() {
    local id="$1" value
    [[ -n "$(spec_for "$id")" ]] || fail "unknown option id: $id"
    if value="$(read_value "$id" 2>/dev/null)"; then
        printf '%s\n' "$value"
        return 0
    fi
    printf '%s\n' "$(spec_field "$(spec_for "$id")" 7)"
}

cmd_set() {
    local id="$1" value="$2"
    [[ -n "$(spec_for "$id")" ]] || fail "unknown option id: $id"
    value="$(validate_value "$id" "$value")"
    write_value "$id" "$value"
    printf 'Set %s = %s.\n' "$id" "$value"
}

cmd_check() {
    printf 'backend: %s\n' "$PROG"
    printf 'powerprofilesctl: %s\n' "${POWERPROFILES_BIN:-unavailable}"
    printf 'brightnessctl: %s\n' "${BRIGHTNESS_BIN:-unavailable}"
    printf 'wpctl: %s\n' "${WPCTL_BIN:-unavailable}"
    printf 'nmcli: %s\n' "${NMCLI_BIN:-unavailable}"
    printf 'timedatectl: %s\n' "${TIMEDATECTL_BIN:-unavailable}"
    printf 'gsettings: %s\n' "${GSETTINGS_BIN:-unavailable}"
    printf 'bluetoothctl: %s\n' "${BLUETOOTHCTL_BIN:-unavailable}"
}

usage() {
    cat <<'USAGE'
Usage: workstation-system-settings <command> [args]

Commands:
  schema            Print the option registry as JSON.
  status            Print effective per-option state (JSON, with dynamic options).
  get <id>          Print the effective value of one option.
  set <id> <value>  Validate and apply one option live.
  check             Report tool availability.

Options cover appearance, audio, Bluetooth, network, date & time, power profile
and display brightness. Commands run as the invoking user; authorization is
whatever polkit/logind/dconf grants the active session.
USAGE
}

main() {
    local cmd="${1:-}"
    [[ -n "$cmd" ]] || { usage; exit 2; }
    shift || true
    case "$cmd" in
        -h|--help|help) usage ;;
        schema) cmd_schema ;;
        status) cmd_status ;;
        get)
            [[ $# -eq 1 ]] || fail "usage: $PROG get <id>"
            cmd_get "$1"
            ;;
        set)
            [[ $# -eq 2 ]] || fail "usage: $PROG set <id> <value>"
            cmd_set "$1" "$2"
            ;;
        check) cmd_check ;;
        *) fail "unknown command: $cmd (see --help)" ;;
    esac
}

main "$@"
