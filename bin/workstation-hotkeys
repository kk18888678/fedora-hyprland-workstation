#!/usr/bin/env bash
set -Eeuo pipefail

# Fast status bar preview dispatcher for fzf
if [[ "${1:-}" == "preview" ]]; then
    sel_id="${2:-}"
    sel_runnable="${3:-false}"
    sel_editable="${4:-false}"
    sel_key="${5:-}"

    # Target UX vocabulary:
    # ↵ Run    Alt+S Set    Alt+U Unset    Esc Close
    if [[ "$sel_editable" != "true" ]]; then
        # Truly immutable/read-only system action
        printf '  \033[2m%s\033[0m\n' "Esc Close"
    elif [[ "$sel_key" == "None (Unbound)" || "$sel_key" == "none" || -z "$sel_key" ]]; then
        # Settable, but currently unset
        printf '  \033[1;36m%s\033[0m    \033[2m%s\033[0m\n' \
            "Alt+S Set" "Esc Close"
    elif [[ "$sel_runnable" == "true" ]]; then
        # Settable, bound, runnable
        printf '  \033[1;32m%s\033[0m    \033[1;36m%s\033[0m    \033[1;33m%s\033[0m    \033[2m%s\033[0m\n' \
            "↵ Run" "Alt+S Set" "Alt+U Unset" "Esc Close"
    else
        # Settable, bound, non-runnable (context action)
        printf '  \033[1;36m%s\033[0m    \033[1;33m%s\033[0m    \033[2m%s\033[0m\n' \
            "Alt+S Set" "Alt+U Unset" "Esc Close"
    fi
    exit 0
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

# Locate keybindings manifest
manifest_path=""
if [[ -n "${HOTKEYS_MANIFEST:-}" && -f "$HOTKEYS_MANIFEST" ]]; then
    manifest_path="$HOTKEYS_MANIFEST"
elif [[ -f "${HOME:-}/.config/hypr/keybindings_manifest.lua" ]]; then
    manifest_path="${HOME:-}/.config/hypr/keybindings_manifest.lua"
elif [[ -f "$script_dir/../dotfiles/hypr/keybindings_manifest.lua" ]]; then
    manifest_path="$script_dir/../dotfiles/hypr/keybindings_manifest.lua"
fi

if [[ -z "$manifest_path" || ! -f "$manifest_path" ]]; then
    printf '%s\n' "Error: Keybindings manifest not found." >&2
    exit 1
fi

manifest_dir="$(dirname -- "$manifest_path")"

effective_lua=""
if [[ -f "$manifest_dir/effective_bindings.lua" ]]; then
    effective_lua="$manifest_dir/effective_bindings.lua"
else
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    effective_lua="$script_dir/../dotfiles/hypr/effective_bindings.lua"
fi

if [[ ! -f "$effective_lua" ]]; then
    printf '%s\n' "Error: effective_bindings.lua loader not found." >&2
    exit 1
fi
effective_dir="$(dirname -- "$effective_lua")"
export LUA_PATH="$manifest_dir/?.lua;$effective_dir/?.lua;${LUA_PATH:-;;}"

lua_bin="$(command -v luajit 2>/dev/null || command -v lua 2>/dev/null || true)"
if [[ -z "$lua_bin" ]]; then
    printf '%s\n' "Error: Lua interpreter not found." >&2
    exit 1
fi

# Parse CLI arguments and provider overrides
HOTKEYS_SUBCOMMAND=""
HOTKEYS_TARGET_ID=""
HOTKEYS_PROVIDER_OVERRIDE=""

remaining_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --provider=*)
            HOTKEYS_PROVIDER_OVERRIDE="${1#*=}"
            shift
            ;;
        --provider)
            HOTKEYS_PROVIDER_OVERRIDE="${2:-}"
            shift 2
            ;;
        json|--json)
            HOTKEYS_SUBCOMMAND="json"
            shift
            ;;
        run|--run)
            HOTKEYS_SUBCOMMAND="run"
            HOTKEYS_TARGET_ID="${2:-}"
            shift 2 2>/dev/null || shift
            ;;
        set|--set)
            HOTKEYS_SUBCOMMAND="set"
            HOTKEYS_TARGET_ID="${2:-}"
            shift 2 2>/dev/null || shift
            ;;
        unset|--unset)
            HOTKEYS_SUBCOMMAND="unset"
            HOTKEYS_TARGET_ID="${2:-}"
            shift 2 2>/dev/null || shift
            ;;
        toggle|--toggle)
            HOTKEYS_SUBCOMMAND="toggle"
            shift
            ;;
        *)
            remaining_args+=("$1")
            shift
            ;;
    esac
done
if [[ ${#remaining_args[@]} -gt 0 ]]; then
    set -- "${remaining_args[@]}"
fi

get_hotkeys_provider() {
    # 1. Explicit CLI argument override (--provider=...)
    if [[ -n "${HOTKEYS_PROVIDER_OVERRIDE:-}" ]]; then
        printf '%s\n' "$HOTKEYS_PROVIDER_OVERRIDE"
        return 0
    fi
    # 2. Test-only environment override (strictly scoped to automated testing harness)
    if [[ -n "${HOTKEYS_TEST_PROVIDER:-}" ]]; then
        printf '%s\n' "$HOTKEYS_TEST_PROVIDER"
        return 0
    fi
    # 3. Persisted desired-state configuration written by reconciler
    local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/workstation/desktop.conf"
    if [[ -f "$config_file" ]]; then
        local prov
        prov="$(grep -E '^[[:space:]]*hotkeys[._]provider[[:space:]]*=' "$config_file" 2>/dev/null | tail -n 1 | cut -d '=' -f2 | tr -d ' "[:space:]' || true)"
        if [[ -n "$prov" ]]; then
            printf '%s\n' "$prov"
            return 0
        fi
    fi
    # 4. Fallback default
    printf '%s\n' "legacy"
}

render_output() {
    "$lua_bin" - "$manifest_path" "$manifest_dir" <<'LUA_SCRIPT'
local manifest_path = arg[1]
local manifest_dir  = arg[2]
local manifest = dofile(manifest_path)

package.path = manifest_dir .. "/?.lua;" .. package.path
local eff = require("effective_bindings")
local effective, err = eff.resolve_bindings(manifest)
if not effective then
    io.stderr:write("Error: Keybindings overrides file is corrupt or invalid: " .. tostring(err) .. "\n")
    os.exit(1)
end

local C_RESET = "\27[0m"
local C_BOLD  = "\27[1m"
local C_DIM   = "\27[2m"
local C_FOAM  = "\27[38;2;156;207;216m"  -- #9ccfd8
local C_GOLD  = "\27[38;2;246;193;119m"  -- #f6c177
local C_IRIS  = "\27[38;2;196;167;231m"  -- #c4a7e7
local C_TEXT  = "\27[38;2;224;222;244m"  -- #e0def4
local C_MUTED = "\27[38;2;110;106;134m"  -- #6e6a86

print()
print(string.format("%s%s Fedora Hyprland Workstation — Keyboard Shortcuts %s", C_BOLD, C_IRIS, C_RESET))
print(string.format("%s───────────────────────────────────────────────────────────────────%s", C_MUTED, C_RESET))

for _, cat in ipairs(effective.categories or {}) do
    local cat_items = {}
    for _, item in ipairs(effective.bindings or {}) do
        if item.category == cat then
            table.insert(cat_items, item)
        end
    end

    if #cat_items > 0 then
        print(string.format("\n%s%s%s%s", C_BOLD, C_FOAM, cat, C_RESET))
        for _, item in ipairs(cat_items) do
            local key_str = item.display_key or item.key or "None (Unbound)"
            local desc_str = item.description or ""
            local pad = 37 - #key_str
            if pad < 2 then pad = 2 end
            local spaces = string.rep(" ", pad)
            print(string.format("  %s%s%s%s%s%s%s", C_BOLD, C_GOLD, key_str, C_RESET, spaces, C_TEXT, desc_str, C_RESET))
        end
    end
end

print(string.format("\n%s───────────────────────────────────────────────────────────────────%s", C_MUTED, C_RESET))
print(string.format("%sPress %sq%s%s, %sEsc%s%s, or %sCtrl+C%s%s to close.%s\n", C_DIM, C_BOLD, C_RESET, C_DIM, C_BOLD, C_RESET, C_DIM, C_BOLD, C_RESET, C_DIM, C_RESET))
LUA_SCRIPT
}

# Fetch TSV rows for interactive TUI / test mode:
# ID 	 DISPLAY_ROW 	 KEY 	 DESCRIPTION 	 CATEGORY 	 RUNNABLE 	 COMMAND 	 ACTION_TYPE
get_tsv_rows() {
    "$lua_bin" - "$manifest_path" "$manifest_dir" <<'LUA_SCRIPT'
local manifest_path = arg[1]
local manifest_dir  = arg[2]
local manifest = dofile(manifest_path)

package.path = manifest_dir .. "/?.lua;" .. package.path
local eff = require("effective_bindings")
local effective, err = eff.resolve_bindings(manifest)
if not effective then
    io.stderr:write("Error: Keybindings overrides file is corrupt or invalid: " .. tostring(err) .. "\n")
    os.exit(1)
end

for _, item in ipairs(effective.bindings or {}) do
    local id = item.id or ""
    local key = item.display_key or item.key or "None (Unbound)"
    local desc = item.description or ""
    local cat = item.category or ""
    local runnable = (item.runnable == true) and "true" or "false"
    local editable = (item.editable ~= false) and "true" or "false"
    local cmd = item.command or ""
    local act = item.action_type or ""

    -- Clean, large two-column format: HOTKEY + APP / ACTION
    local display_col = string.format("  %-28s  %s", key, desc)

    print(string.format("%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s",
        id, display_col, key, desc, cat, runnable, editable, cmd, act))
end
LUA_SCRIPT
}

# Fetch structured command_argv as a NUL-delimited stream
get_action_argv() {
    local target_id="$1"
    "$lua_bin" - "$manifest_path" "$manifest_dir" "$target_id" <<'LUA_SCRIPT'
local manifest_path = arg[1]
local manifest_dir  = arg[2]
local target_id     = arg[3]

package.path = manifest_dir .. "/?.lua;" .. package.path
local eff = require("effective_bindings")
local manifest = dofile(manifest_path)

local argv, err = eff.get_action_argv(target_id, manifest)
if not argv then
    io.stderr:write(tostring(err) .. "\n")
    os.exit(2)
end

for _, a in ipairs(argv) do
    io.write(a, "\0")
end
LUA_SCRIPT
}

# Execute action safely using structured argv and process detachment
execute_action() {
    local action_id="$1"
    local description="$2"

    local cmd_argv=()
    while IFS= read -r -d '' arg; do
        cmd_argv+=("$arg")
    done < <(get_action_argv "$action_id" 2>/dev/null)
    local status=$?

    if [[ "$status" -ne 0 || ${#cmd_argv[@]} -eq 0 ]]; then
        printf '%s\n' "Unavailable: This action requires desktop context and cannot be run from the hotkey manager."
        return 1
    fi

    local exe="${cmd_argv[0]}"
    if ! command -v "$exe" >/dev/null 2>&1; then
        logger -t workstation-hotkeys "Action '$action_id' ($description) failed: command '$exe' not found" 2>/dev/null || true
        if command -v notify-send >/dev/null 2>&1; then
            notify-send -u critical "Launch Failed" "Command not found: $exe" 2>/dev/null || true
        fi
        printf '%s\n' "Error: Command '$exe' is not installed or not executable." >&2
        return 1
    fi

    # Direct background execution of structured argv detached completely from
    # the terminal emulator PTY and process group, capturing immediate startup failures
    (
        err_log="$(mktemp /tmp/hotkeys-launch-XXXXXX.log 2>/dev/null || true)"
        if [[ -n "$err_log" ]]; then
            if ! "${cmd_argv[@]}" </dev/null >/dev/null 2>"$err_log"; then
                err_msg="$(head -n 2 "$err_log" 2>/dev/null || true)"
                logger -t workstation-hotkeys "Action '$action_id' ($description) failed: ${err_msg:-exited with error}" 2>/dev/null || true
                if command -v notify-send >/dev/null 2>&1; then
                    notify-send -u critical "Launch Failed" "$description: ${err_msg:-Failed to start}" 2>/dev/null || true
                fi
            fi
            rm -f "$err_log"
        else
            "${cmd_argv[@]}" </dev/null >/dev/null 2>&1
        fi
    ) &
    disown $! 2>/dev/null || true

    printf '%s\n' "Running: $description"
    return 0
}

# Set/edit binding via Lua helper
apply_binding_edit() {
    local action_id="$1"
    local new_input="$2"

    "$lua_bin" - "$manifest_path" "$manifest_dir" "$action_id" "$new_input" <<'LUA_SCRIPT'
local manifest_path = arg[1]
local manifest_dir  = arg[2]
local action_id     = arg[3]
local new_input     = arg[4]

package.path = manifest_dir .. "/?.lua;" .. package.path
local eff = require("effective_bindings")

local ok, result = eff.set_action_binding(action_id, new_input, manifest_path)
if not ok then
    io.stderr:write(tostring(result) .. "\n")
    os.exit(1)
end
print(tostring(result))
LUA_SCRIPT
}

# Prompt user and capture physical key combination or manual input
prompt_and_capture_key() {
    local action_id="$1"
    local action_desc="$2"
    local current_key="$3"
    local action_cat="$4"

    clear 2>/dev/null || true
    printf '\033[1;36m%s\033[0m\n\n' "Set Shortcut — $action_desc"
    printf 'Current shortcut:  \033[1m%s\033[0m\n\n' "$current_key"
    printf '%s\n\n' "Press desired key combination now (e.g. Super + Shift + T)..."
    printf '\033[2m%s\033[0m\n' "[ Esc Cancel    't' Type text manually    'u' Unset ]"

    local capture_bin
    capture_bin="$(dirname -- "${BASH_SOURCE[0]}")/workstation-hotkey-capture"
    if [[ ! -f "$capture_bin" ]]; then
        capture_bin="$script_dir/workstation-hotkey-capture"
    fi

    local cap_out=""
    if [[ -x "$capture_bin" ]]; then
        cap_out="$("$capture_bin" 2>/dev/null || true)"
    fi

    local new_key=""
    if [[ "$cap_out" =~ ^KEY:(.+) ]]; then
        new_key="${BASH_REMATCH[1]}"
    elif [[ "$cap_out" == "UNBIND" ]]; then
        new_key="none"
    elif [[ "$cap_out" == "CANCEL" ]]; then
        return 0
    else
        # Manual fallback mode
        printf '%s\n' "Enter key combination (e.g. SUPER + SHIFT + T),"
        printf '%s\n' "  'none' to unbind, 'default' to restore manifest default,"
        printf '%s' "  or press Enter with no input to cancel: "
        read -r manual_input || true
        if [[ -z "$manual_input" ]]; then
            return 0
        fi
        new_key="$manual_input"
    fi

    if [[ -z "$new_key" ]]; then
        return 0
    fi

    if err_msg="$(apply_binding_edit "$action_id" "$new_key" 2>&1)"; then
        printf '\n\033[1;32m%s\033[0m\n' "Shortcut updated successfully. Hyprland configuration reloaded."
        if [[ -t 0 && -t 1 ]]; then sleep 0.8; fi
    else
        printf '\n\033[1;31m%s\033[0m\n\n' "$err_msg"
        if [[ -t 0 ]]; then
            printf '%s' "Press Enter to return to shortcut list... "
            read -r _ || true
        fi
    fi
}

# Fetch installed desktop applications TSV:
# DESKTOP_ID 	 DISPLAY_COL 	 NAME 	 SHORTCUT 	 ROLE
get_app_rows() {
    "$lua_bin" - "$manifest_path" "$manifest_dir" <<'LUA_SCRIPT'
local manifest_path = arg[1]
local manifest_dir  = arg[2]
local manifest = dofile(manifest_path)

package.path = manifest_dir .. "/?.lua;" .. package.path
local eff = require("effective_bindings")
local apps = eff.list_installed_applications()
local effective, _ = eff.resolve_bindings(manifest)

local assigned_keys = {}
for _, b in ipairs(effective.bindings or {}) do
    if b.desktop_id then
        assigned_keys[b.desktop_id] = b.display_key or b.key or "Unbound"
    end
end

for _, app in ipairs(apps) do
    local did = app.desktop_id
    local name = app.name or did
    local role = app.default_role or ""
    local shortcut = assigned_keys[did] or "None"

    local pad = 35 - #name
    if pad < 2 then pad = 2 end
    local role_badge = (role ~= "") and (" [" .. role .. "]") or ""
    local display_col = string.format("%s%s%-24s%s", name, string.rep(" ", pad), "[" .. shortcut .. "]", role_badge)
    print(string.format("%s\t%s\t%s\t%s\t%s", did, display_col, name, shortcut, role))
end
LUA_SCRIPT
}

# Assign application shortcut interactive UI
assign_app_shortcut_ui() {
    clear 2>/dev/null || true
    local app_data
    app_data="$(get_app_rows)"

    local chosen
    chosen="$(printf '%s\n' "$app_data" | fzf \
        --prompt="Select Application > " \
        --header="Fedora Hyprland Workstation — Assign Application Shortcut" \
        --footer="↵ Select App to Assign Shortcut    Esc Cancel" \
        --delimiter=$'\t' \
        --with-nth=2 || true)"

    if [[ -z "$chosen" ]]; then
        return 0
    fi

    local chosen_id chosen_disp chosen_name chosen_cur chosen_role
    IFS=$'\t' read -r chosen_id chosen_disp chosen_name chosen_cur chosen_role <<< "$chosen"

    prompt_and_capture_key "app:$chosen_id" "Launch $chosen_name" "$chosen_cur" "Applications & Launchers"
}

# Fetch JSON rows for Aurelia / modern UI consumption
get_json_rows() {
    "$lua_bin" - "$manifest_path" "$manifest_dir" <<'LUA_SCRIPT'
local manifest_path = arg[1]
local manifest_dir  = arg[2]
local manifest = dofile(manifest_path)

package.path = manifest_dir .. "/?.lua;" .. package.path
local eff = require("effective_bindings")
local effective, err = eff.resolve_bindings(manifest)
if not effective then
    io.stderr:write("Error: " .. tostring(err) .. "\n")
    os.exit(1)
end

io.write(eff.serialize_bindings_json(effective))
LUA_SCRIPT
}

# Handle explicit subcommands immediately
if [[ "$HOTKEYS_SUBCOMMAND" == "json" || "${HOTKEYS_TEST_ACTION:-}" == "json" ]]; then
    get_json_rows
    exit 0
fi

# Validate action ID format strictly before execution or mutation
if [[ -n "$HOTKEYS_SUBCOMMAND" && "$HOTKEYS_SUBCOMMAND" =~ ^(run|set|unset)$ ]]; then
    if [[ -z "$HOTKEYS_TARGET_ID" ]]; then
        printf '%s\n' "Error: Missing action ID for $HOTKEYS_SUBCOMMAND" >&2
        exit 1
    fi
    if [[ ! "$HOTKEYS_TARGET_ID" =~ ^[a-zA-Z0-9_.:-]+$ ]]; then
        printf '%s\n' "Error: Invalid action ID: $HOTKEYS_TARGET_ID" >&2
        exit 1
    fi
fi

if [[ "$HOTKEYS_SUBCOMMAND" == "run" ]]; then
    desc="$("$lua_bin" - "$manifest_path" "$manifest_dir" "$HOTKEYS_TARGET_ID" 2>/dev/null <<'LUA'
local manifest_path = arg[1]
local manifest_dir  = arg[2]
local target_id     = arg[3]
package.path = manifest_dir .. "/?.lua;" .. package.path
local eff = require("effective_bindings")
local manifest = dofile(manifest_path)
local effective = eff.resolve_bindings(manifest)
for _, b in ipairs(effective.bindings or {}) do
    if b.id == target_id then print(b.description or b.id); os.exit(0) end
end
os.exit(1)
LUA
)" || {
        printf '%s\n' "Error: Unknown action ID: $HOTKEYS_TARGET_ID" >&2
        exit 1
    }
    execute_action "$HOTKEYS_TARGET_ID" "${desc:-$HOTKEYS_TARGET_ID}"
    exit $?
fi

if [[ "$HOTKEYS_SUBCOMMAND" == "unset" ]]; then
    if err_msg="$(apply_binding_edit "$HOTKEYS_TARGET_ID" "none" 2>&1)"; then
        printf '%s\n' "UNSET_OK"
        exit 0
    else
        printf 'UNSET_FAIL: %s\n' "$err_msg" >&2
        exit 1
    fi
fi

if [[ "$HOTKEYS_SUBCOMMAND" == "set" ]]; then
    if [[ ! -t 0 || ! -t 1 ]] && [[ -z "${HOTKEYS_CAPTURE_MOCK_INPUT:-}" ]]; then
        if command -v foot >/dev/null 2>&1; then
            exec foot --app-id=workstation-hotkeys-capture --title="Set Shortcut" "$0" set "$HOTKEYS_TARGET_ID"
        elif command -v kitty >/dev/null 2>&1; then
            exec kitty --class=workstation-hotkeys-capture --title="Set Shortcut" "$0" set "$HOTKEYS_TARGET_ID"
        fi
    fi
    info_line="$("$lua_bin" - "$manifest_path" "$manifest_dir" "$HOTKEYS_TARGET_ID" 2>/dev/null <<'LUA'
local manifest_path = arg[1]
local manifest_dir  = arg[2]
local target_id     = arg[3]
package.path = manifest_dir .. "/?.lua;" .. package.path
local eff = require("effective_bindings")
local manifest = dofile(manifest_path)
local effective = eff.resolve_bindings(manifest)
for _, b in ipairs(effective.bindings or {}) do
    if b.id == target_id then
        print(string.format("%s\t%s\t%s", b.description or b.id, b.display_key or "none", b.category or ""))
        os.exit(0)
    end
end
LUA
)"
    IFS=$'\t' read -r action_desc current_key action_cat <<< "$info_line"
    prompt_and_capture_key "$HOTKEYS_TARGET_ID" "${action_desc:-$HOTKEYS_TARGET_ID}" "${current_key:-none}" "${action_cat:-}"
    exit $?
fi

# Handle test actions non-interactively
if [[ -n "${HOTKEYS_TEST_ACTION:-}" ]]; then
    case "$HOTKEYS_TEST_ACTION" in
        list)
            get_tsv_rows
            exit 0
            ;;
        apps)
            get_app_rows
            exit 0
            ;;
        assign_app)
            target_id="${HOTKEYS_TEST_ID:-}"
            target_input="${HOTKEYS_TEST_INPUT:-}"
            if err_msg="$("$lua_bin" - "$manifest_path" "$manifest_dir" "$target_id" "$target_input" 2>&1 <<'LUA'
local manifest_path = arg[1]
local manifest_dir  = arg[2]
local desktop_id    = arg[3]
local new_input     = arg[4]
package.path = manifest_dir .. "/?.lua;" .. package.path
local eff = require("effective_bindings")
local ok, result = eff.assign_application_shortcut(desktop_id, new_input, manifest_path)
if not ok then
    io.stderr:write(tostring(result) .. "\n")
    os.exit(1)
end
print(tostring(result))
LUA
)"; then
                printf '%s\n' "ASSIGN_APP_OK"
                exit 0
            else
                printf '%s\n' "ASSIGN_APP_FAIL: $err_msg" >&2
                exit 1
            fi
            ;;
        run)
            target_id="${HOTKEYS_TEST_ID:-}"
            cmd_argv=()
            while IFS= read -r -d '' arg; do
                cmd_argv+=("$arg")
            done < <(get_action_argv "$target_id" 2>/dev/null)
            if [[ ${#cmd_argv[@]} -gt 0 ]]; then
                printf '%s\n' "RUN:${cmd_argv[*]}"
                if [[ "${HOTKEYS_TEST_EXEC:-0}" == "1" ]]; then
                    nohup "${cmd_argv[@]}" >/dev/null 2>&1 &
                fi
                exit 0
            else
                desc="$("$lua_bin" - "$manifest_path" "$target_id" 2>/dev/null <<'LUA'
local m = dofile(arg[1])
for _, b in ipairs(m.bindings or {}) do
    if b.id == arg[2] then print(b.description or b.id); os.exit(0) end
end
LUA
)"
                if [[ -z "$desc" ]]; then
                    printf '%s\n' "ERROR: Action not found: $target_id" >&2
                    exit 1
                fi
                printf '%s\n' "UNAVAILABLE:$desc"
                exit 2
            fi
            ;;
        run_argv)
            target_id="${HOTKEYS_TEST_ID:-}"
            cmd_argv=()
            while IFS= read -r -d '' arg; do
                cmd_argv+=("$arg")
            done < <(get_action_argv "$target_id" 2>/dev/null)
            if [[ ${#cmd_argv[@]} -gt 0 ]]; then
                for a in "${cmd_argv[@]}"; do
                    printf '%s\n' "$a"
                done
                exit 0
            else
                exit 2
            fi
            ;;

        edit|conflict|invalid)
            target_id="${HOTKEYS_TEST_ID:-}"
            target_input="${HOTKEYS_TEST_INPUT:-}"
            if err_msg="$(apply_binding_edit "$target_id" "$target_input" 2>&1)"; then
                printf '%s\n' "EDIT_OK"
                exit 0
            else
                printf '%s\n' "EDIT_FAIL: $err_msg" >&2
                exit 1
            fi
            ;;
        unset)
            target_id="${HOTKEYS_TEST_ID:-}"
            if err_msg="$(apply_binding_edit "$target_id" "none" 2>&1)"; then
                printf '%s\n' "UNSET_OK"
                exit 0
            else
                printf '%s\n' "UNSET_FAIL: $err_msg" >&2
                exit 1
            fi
            ;;
        reset)
            target_id="${HOTKEYS_TEST_ID:-}"
            if err_msg="$(apply_binding_edit "$target_id" "default" 2>&1)"; then
                printf '%s\n' "RESET_OK"
                exit 0
            else
                printf '%s\n' "RESET_FAIL: $err_msg" >&2
                exit 1
            fi
            ;;

        provider)
            get_hotkeys_provider
            exit 0
            ;;
        quit)
            exit 0
            ;;
        *)
            printf '%s\n' "Unknown HOTKEYS_TEST_ACTION: $HOTKEYS_TEST_ACTION" >&2
            exit 1
            ;;
    esac
fi

# Force stdout mode (preserves existing non-interactive test and output parity)
if [[ "${HOTKEYS_FORCE_STDOUT:-0}" == "1" ]]; then
    render_output
    exit 0
fi

# Dispatch based on configured Hotkeys Provider
active_provider="$(get_hotkeys_provider)"
if [[ "$active_provider" == "aurelia" ]]; then
    if [[ "${HOTKEYS_SIMULATE_AURELIA_SUCCESS:-0}" == "1" ]]; then
        printf '%s\n' "AURELIA_TOGGLE_OK"
        exit 0
    fi
    if [[ "${HOTKEYS_SIMULATE_AURELIA_FAIL:-0}" != "1" ]]; then
        qs_bin="$(command -v qs 2>/dev/null || command -v quickshell 2>/dev/null || true)"
        if [[ -n "$qs_bin" ]]; then
            # 1. Attempt IPC call to an existing healthy Aurelia instance
            if "$qs_bin" ipc call hotkeys toggle >/dev/null 2>&1; then
                exit 0
            fi
            # 2. If unavailable, locate the Aurelia shell QML configuration
            aurelia_shell="${XDG_CONFIG_HOME:-$HOME/.config}/aurelia/shell.qml"
            if [[ ! -f "$aurelia_shell" ]]; then
                aurelia_shell="$script_dir/../dotfiles/aurelia/shell.qml"
            fi
            if [[ -f "$aurelia_shell" ]]; then
                # 3. Start Aurelia safely with --no-duplicate to prevent duplicate instances
                "$qs_bin" --no-duplicate --daemonize --path "$aurelia_shell" >/dev/null 2>&1 || true
                # 4. Verify actual IPC readiness with bounded retry (max 500ms: 10 * 50ms)
                for _ in {1..10}; do
                    if "$qs_bin" ipc call hotkeys toggle >/dev/null 2>&1; then
                        exit 0
                    fi
                    sleep 0.05
                done
            fi
        fi
    fi
    logger -t workstation-hotkeys "Aurelia Hotkeys unavailable or failed readiness; falling back to legacy fzf interface." 2>/dev/null || true
fi

# Legacy fallback / direct fzf mode: if not in an interactive terminal, spawn terminal
if [[ ! -t 1 ]]; then
    if command -v foot >/dev/null 2>&1; then
        exec foot --app-id=workstation-hotkeys --title="Workstation Hotkeys" "$0" "$@"
    elif command -v kitty >/dev/null 2>&1; then
        exec kitty --class=workstation-hotkeys --title="Workstation Hotkeys" "$0" "$@"
    else
        notify-send "Hotkeys" "No supported terminal found to display hotkeys." 2>/dev/null || true
        exit 1
    fi
fi

# Interactive mode: requires fzf and interactive TTY
if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    while true; do
        tsv_data="$(get_tsv_rows)"

        # Run fzf with real search, persistent bottom status bar, and contextual keys
        fzf_out="$(printf '%s\n' "$tsv_data" | fzf \
            --ansi \
            --prompt="Search hotkeys > " \
            --header="Fedora Hyprland Workstation — Keyboard Shortcuts" \
            --preview="$0 preview {1} {6} {7} {3}" \
            --preview-window="bottom:2:wrap:noborder" \
            --expect=alt-s,alt-u \
            --bind='ctrl-c:abort,esc:abort' \
            --delimiter=$'\t' \
            --with-nth=2 || true)"

        if [[ -z "$fzf_out" ]]; then
            # Esc or Ctrl+C was pressed to quit
            exit 0
        fi

        key_action="$(head -n 1 <<< "$fzf_out")"
        selected_row="$(tail -n +2 <<< "$fzf_out" | head -n 1)"

        if [[ -z "$selected_row" ]]; then
            exit 0
        fi

        IFS=$'\t' read -r sel_id sel_display sel_key sel_desc sel_cat sel_runnable sel_editable sel_cmd sel_act <<< "$selected_row"

        case "$key_action" in
            alt-s)
                if [[ "$sel_editable" != "true" ]]; then
                    continue
                fi
                prompt_and_capture_key "$sel_id" "$sel_desc" "$sel_key" "$sel_cat"
                continue
                ;;
            alt-u)
                if [[ "$sel_editable" != "true" ]]; then
                    continue
                fi
                if err_msg="$(apply_binding_edit "$sel_id" "none" 2>&1)"; then
                    printf '\n\033[1;32m%s\033[0m\n' "Shortcut unbound successfully."
                    sleep 0.5
                else
                    printf '\n\033[1;31m%s\033[0m\n' "$err_msg"
                    sleep 1
                fi
                continue
                ;;
            *)
                # Enter workflow: activate/run
                if [[ "$sel_runnable" == "true" ]]; then
                    execute_action "$sel_id" "$sel_desc"
                    exit 0
                fi
                ;;
        esac
    done
elif command -v less >/dev/null 2>&1; then
    render_output | less -R -F -X
else
    render_output
    read -r -n 1 -s _ || true
fi
