#!/usr/bin/env bash
# workstation-hotkeys — Compatibility Wrapper for workstation-keybindings
#
# Maintained for backwards compatibility with existing keybindings, user configurations,
# and scripts. Forwards all invocations directly to workstation-keybindings.
#
# Invariant:
# - Zero duplicate implementation logic.
# - Clean delegation via exec.

set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
target_bin="$script_dir/workstation-keybindings"

if [[ ! -x "$target_bin" ]]; then
    target_bin="$(command -v workstation-keybindings 2>/dev/null || true)"
fi

if [[ -z "$target_bin" || ! -x "$target_bin" ]]; then
    printf 'Error: workstation-keybindings executable not found.\n' >&2
    exit 1
fi

exec "$target_bin" "$@"
