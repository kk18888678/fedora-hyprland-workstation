#!/usr/bin/env bash
# aurelia-launch-shell — start the single resident Aurelia Shell host.

set -Eeuo pipefail

shell_root="${XDG_CONFIG_HOME:-$HOME/.config}/aurelia"
if [[ "${AURELIA_DEVELOPMENT_MODE:-0}" == "1" || "${WORKSTATION_TEST_MODE:-0}" == "1" ]] &&
   [[ -n "${AURELIA_SHELL_ROOT:-}" ]]; then
    shell_root="$AURELIA_SHELL_ROOT"
fi
[[ "$shell_root" == /* && "$shell_root" != "/" ]] || {
    printf 'Error: Aurelia shell path is not absolute.\n' >&2
    exit 1
}
[[ -f "$shell_root/shell.qml" ]] || {
    printf 'Error: Aurelia Shell configuration not found: %s/shell.qml\n' "$shell_root" >&2
    exit 1
}

qs_bin=""
if [[ "${AURELIA_DEVELOPMENT_MODE:-0}" == "1" || "${WORKSTATION_TEST_MODE:-0}" == "1" ]] &&
   [[ -n "${QUICKSHELL_BIN:-}" && -x "$QUICKSHELL_BIN" ]]; then
    qs_bin="$QUICKSHELL_BIN"
elif [[ "${WORKSTATION_TEST_MODE:-0}" == "1" ]] && command -v qs >/dev/null 2>&1; then
    qs_bin="$(command -v qs)"
elif [[ -x "/usr/bin/qs" ]]; then
    qs_bin="/usr/bin/qs"
elif [[ -x "/usr/bin/quickshell" ]]; then
    qs_bin="/usr/bin/quickshell"
else
    printf 'Error: Quickshell runtime binary not found.\n' >&2
    exit 1
fi

exec "$qs_bin" --no-duplicate --path "$shell_root/shell.qml"
