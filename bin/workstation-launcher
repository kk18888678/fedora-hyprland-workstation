#!/usr/bin/env bash
set -Eeuo pipefail

# Workstation Application Launcher
# Provides application launching with declarative shortcut discoverability
# and an action footer (Enter: Launch, E: Edit Shortcut, Q: Quit).
# Shortcuts are dynamically derived from keybindings_manifest.lua (single source of truth).

# If not running in an interactive terminal and not forced to stdout, launch in dedicated floating window
if [[ ! -t 1 && "${LAUNCHER_FORCE_STDOUT:-0}" != "1" ]]; then
    if command -v foot >/dev/null 2>&1; then
        exec foot --app-id=workstation-launcher --title="Application Launcher" "$0" "$@"
    elif command -v kitty >/dev/null 2>&1; then
        exec kitty --class=workstation-launcher --title="Application Launcher" "$0" "$@"
    else
        notify-send "Launcher" "No supported terminal found to display launcher." 2>/dev/null || true
        exit 1
    fi
fi

# Locate keybindings manifest
manifest_path=""
if [[ -n "${LAUNCHER_MANIFEST:-}" && -f "$LAUNCHER_MANIFEST" ]]; then
    manifest_path="$LAUNCHER_MANIFEST"
elif [[ -f "${HOME:-}/.config/hypr/keybindings_manifest.lua" ]]; then
    manifest_path="${HOME:-}/.config/hypr/keybindings_manifest.lua"
else
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    if [[ -f "$script_dir/../dotfiles/hypr/keybindings_manifest.lua" ]]; then
        manifest_path="$script_dir/../dotfiles/hypr/keybindings_manifest.lua"
    fi
fi

lua_bin="$(command -v luajit 2>/dev/null || command -v lua 2>/dev/null || true)"

# Generate structured launcher data from desktop entries and manifest
generate_launcher_entries() {
    "$lua_bin" - "${manifest_path:-}" <<'LUA_SCRIPT'
local manifest_path = arg[1]
local manifest = {}
if manifest_path and manifest_path ~= "" then
    local ok, res = pcall(dofiler or dofile, manifest_path)
    if ok and type(res) == "table" then
        manifest = res
    end
end

-- Index managed shortcuts by desktop_id and executable/command
local shortcuts_by_id = {}
local shortcuts_by_cmd = {}

for _, item in ipairs(manifest.bindings or {}) do
    local key = item.display_key or item.key
    if key and key ~= "" then
        if item.desktop_id and item.desktop_id ~= "" then
            shortcuts_by_id[item.desktop_id:lower()] = key
        end
        if item.command and item.command ~= "" then
            local cmd_base = item.command:match("^([^%s]+)")
            if cmd_base then
                shortcuts_by_cmd[cmd_base:lower()] = key
            end
        end
    end
end

-- Standard desktop search directories
local search_dirs = {
    (os.getenv("HOME") or "") .. "/.local/share/applications",
    "/usr/local/share/applications",
    "/usr/share/applications",
    "/var/lib/flatpak/exports/share/applications",
}

local entries = {}
local seen_ids = {}

local function parse_desktop_file(path, file_name)
    local f = io.open(path, "r")
    if not f then return nil end

    local in_desktop_entry = false
    local name = nil
    local exec = nil
    local no_display = false
    local terminal = false
    local type_app = false

    for line in f:lines() do
        line = line:match("^%s*(.-)%s*$")
        if line:match("^%[Desktop Entry%]") then
            in_desktop_entry = true
        elseif line:match("^%[") then
            in_desktop_entry = false
        elseif in_desktop_entry then
            local k, v = line:match("^([^=]+)=(.*)$")
            if k and v then
                k = k:match("^%s*(.-)%s*$")
                v = v:match("^%s*(.-)%s*$")
                if k == "Name" and not name then
                    name = v
                elseif k == "Exec" and not exec then
                    exec = v
                elseif k == "NoDisplay" and v:lower() == "true" then
                    no_display = true
                elseif k == "Terminal" and v:lower() == "true" then
                    terminal = true
                elseif k == "Type" and v == "Application" then
                    type_app = true
                end
            end
        end
    end
    f:close()

    if no_display or not type_app or not name or not exec then
        return nil
    end

    -- Clean Exec string (strip %f, %u, %F, %U, etc.)
    local clean_exec = exec:gsub("%%[fFuUdDnNickvm]", ""):match("^%s*(.-)%s*$")
    local exec_base = clean_exec:match("^([^%s]+)")

    -- Match shortcut from manifest
    local shortcut = shortcuts_by_id[file_name:lower()]
    if not shortcut and exec_base then
        shortcut = shortcuts_by_cmd[exec_base:lower()]
    end

    return {
        id = file_name,
        name = name,
        exec = clean_exec,
        terminal = terminal,
        shortcut = shortcut or "",
    }
end

for _, dir in ipairs(search_dirs) do
    local handle = io.popen("ls -1 " .. string.format("%q", dir) .. " 2>/dev/null")
    if handle then
        for file in handle:lines() do
            if file:match("%.desktop$") and not seen_ids[file] then
                seen_ids[file] = true
                local entry = parse_desktop_file(dir .. "/" .. file, file)
                if entry then
                    table.insert(entries, entry)
                end
            end
        end
        handle:close()
    end
end

-- Sort alphabetically by Name
table.sort(entries, function(a, b)
    return a.name:lower() < b.name:lower()
end)

for _, e in ipairs(entries) do
    -- Format output: id \t name \t shortcut \t exec
    print(string.format("%s\t%s\t%s\t%s", e.id, e.name, e.shortcut, e.exec))
end
LUA_SCRIPT
}

# If forced to stdout (e.g. tests), print entries and exit
if [[ "${LAUNCHER_FORCE_STDOUT:-0}" == "1" ]]; then
    if [[ -n "$lua_bin" ]]; then
        generate_launcher_entries
    fi
    exit 0
fi

# Launch an application entry
launch_app() {
    local exec_cmd="$1"
    if [[ -z "$exec_cmd" ]]; then
        return 0
    fi
    # Execute detached in background
    nohup bash -c "$exec_cmd" >/dev/null 2>&1 &
    exit 0
}

# Edit / manage shortcut action handler
handle_edit_shortcut() {
    local selected_name="${1:-}"
    local selected_shortcut="${2:-}"
    # Invoke workstation-hotkeys reference with explanation
    if command -v workstation-hotkeys >/dev/null 2>&1; then
        workstation-hotkeys || true
    else
        printf '%s\n' "Shortcut Management: Edit $manifest_path to change keybindings."
        read -r -n 1 -s _ || true
    fi
    exit 0
}

# Interactive fzf mode if available
if command -v fzf >/dev/null 2>&1 && [[ -n "$lua_bin" ]]; then
    # Prepare formatted items
    items="$(generate_launcher_entries)"
    if [[ -z "$items" ]]; then
        printf '%s\n' "No applications found." >&2
        exit 1
    fi

    # Format items for fzf display with shortcut right-aligned
    formatted_input="$(awk -F'\t' '{
        id=$1; name=$2; shortcut=$3; exec=$4;
        if (shortcut != "") {
            printf "%-35s %-20s\t%s\t%s\n", name, shortcut, exec, id
        } else {
            printf "%-35s %-20s\t%s\t%s\n", name, "", exec, id
        }
    }' <<< "$items")"

    header_text="↵ Launch        E Edit shortcut        Q Quit"

    # Run fzf with custom keybindings: Enter to launch, Q to quit, E to edit shortcut
    selection="$(fzf \
        --ansi \
        --with-nth=1 \
        --delimiter='\t' \
        --prompt='Search Apps: ' \
        --header="$header_text" \
        --header-first \
        --reverse \
        --no-mouse \
        --expect=enter,e,q,ctrl-q,esc <<< "$formatted_input" || true)"

    key_pressed="$(head -n 1 <<< "$selection")"
    chosen_line="$(sed -n '2p' <<< "$selection")"

    case "$key_pressed" in
        enter)
            if [[ -n "$chosen_line" ]]; then
                chosen_exec="$(awk -F'\t' '{print $2}' <<< "$chosen_line")"
                launch_app "$chosen_exec"
            fi
            ;;
        e|E)
            if [[ -n "$chosen_line" ]]; then
                chosen_name="$(awk -F'\t' '{print $1}' <<< "$chosen_line" | awk '{$1=$1};1')"
                handle_edit_shortcut "$chosen_name" ""
            else
                handle_edit_shortcut "" ""
            fi
            ;;
        q|Q|esc|ctrl-q|"")
            # Dismiss launcher cleanly
            exit 0
            ;;
    esac
else
    # Minimal fallback interactive selector if fzf is not installed
    items="$(generate_launcher_entries)"
    printf '\n  Fedora Workstation Applications\n'
    printf '  ───────────────────────────────────────────────────────────────────\n'
    idx=1
    declare -A exec_map
    declare -A name_map
    while IFS=$'\t' read -r id name shortcut exec_cmd; do
        [[ -n "$name" ]] || continue
        exec_map[$idx]="$exec_cmd"
        name_map[$idx]="$name"
        if [[ -n "$shortcut" ]]; then
            printf '  [%2d] %-35s %s\n' "$idx" "$name" "$shortcut"
        else
            printf '  [%2d] %-35s\n' "$idx" "$name"
        fi
        ((idx++))
        if (( idx > 25 )); then break; fi
    done <<< "$items"
    printf '  ───────────────────────────────────────────────────────────────────\n'
    printf '  ↵ Launch [1-%d]        E Edit shortcut        Q Quit\n\n' "$((idx - 1))"

    read -r -p "  Selection: " choice || choice="q"
    case "$choice" in
        [qQ]|"")
            exit 0
            ;;
        [eE])
            handle_edit_shortcut "" ""
            ;;
        [0-9]*)
            if [[ -n "${exec_map[$choice]:-}" ]]; then
                launch_app "${exec_map[$choice]}"
            fi
            ;;
    esac
fi
