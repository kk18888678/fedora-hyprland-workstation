    {"id":"aurelia.weather","kinds":["bar-widget"],"entryPoints":{"barWidget":"WeatherBarWidget.qml"},"keepLoaded":false,"barWidget":{"displayName":"Weather","description":"Automatic weather bar widget with city and coordinate overrides.","category":"Weather","allowMultiple":false,"defaultSection":"center"}},
