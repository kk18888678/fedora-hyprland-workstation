{
  "version": 1,
  "plugins": [],
  "disabledPlugins": [],
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "aurelia.clock",
    "layout": {
      "left": [
        { "id": "aurelia.workspaces" }
      ],
      "center": [
        { "id": "aurelia.clock", "format": "MMM d, dddd HH:mm" },
        { "id": "aurelia.weather", "location": "none" }
      ],
      "right": [
        { "id": "aurelia.tasklist" },
        { "id": "aurelia.tray" },
        { "id": "aurelia.screenshot" },
        { "id": "aurelia.power" }
      ]
    }
  }
}
