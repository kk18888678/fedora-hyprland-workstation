[Unit]
Description=Announce process crashes and offer an AI diagnosis
# Needs the session bus to notify and the graphical session to own the
# notification server, so it starts only after the session target is up.
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# Set by `aurelia crash capture off`. Checked here so a disabled watcher stays
# disabled across logins without the unit having to be disabled.
ConditionPathExists=!%h/.local/state/aurelia/toggles/crash-capture-off

[Service]
Type=simple
ExecStart=/usr/local/bin/aurelia-crash-watch
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
