#!/usr/bin/env bash

# aurelia-bar-text-color — choose a legible foreground for a transparent bar.
#
# The helper is deliberately read-only. It samples only a validated local
# wallpaper path and returns one of the two validated theme colors. It measures
# the darkest and brightest WCAG relative-luminance regions of the bar strip,
# composites the bar-strip scrim the resident bar will draw over that range,
# and returns the candidate with the maximum worst-case contrast. When even the
# best candidate cannot clear 4.5:1 against the scrim-composited background it
# emits an explicit `fallback reason=insufficient-contrast ... action=opaque`
# signal on stderr so the resident bar can strengthen its legibility scrim. It
# never forces the surface opaque: the user's transparent-bar choice wins.
# Missing media, tooling, geometry, or malformed input is an expected capability
# fallback, but remains observable on stderr for the resident bar log.

set -Eeuo pipefail

position="${1:-top}"
bar_size="${2:-}"
text_color="${3:-}"
background_color="${4:-}"
shift 4  || true

background_path=""
screen_size=""
scrim_color="#000000"
scrim_alpha="0"

while (( $# > 0 )); do
    case "$1" in
        --background)
            (( $# >= 2 )) || {
                printf '%s\n' '[AURELIA-BAR-TEXT] fallback reason=missing-background-argument' >&2
                exit 0
            }
            background_path="$2"
            shift 2
            ;;
        --screen)
            (( $# >= 2 )) || {
                printf '%s\n' '[AURELIA-BAR-TEXT] fallback reason=missing-screen-argument' >&2
                exit 0
            }
            screen_size="$2"
            shift 2
            ;;
        --scrim)
            (( $# >= 2 )) || {
                printf '%s\n' '[AURELIA-BAR-TEXT] fallback reason=missing-scrim-argument' >&2
                exit 0
            }
            scrim_color="$2"
            shift 2
            ;;
        --scrim-alpha)
            (( $# >= 2 )) || {
                printf '%s\n' '[AURELIA-BAR-TEXT] fallback reason=missing-scrim-alpha-argument' >&2
                exit 0
            }
            scrim_alpha="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

valid_hex() {
    [[ "${1:-}" =~ ^#[0-9A-Fa-f]{6}$ ]]
}

fallback() {
    local reason="$1"
    local value="#ffffff"
    valid_hex "$text_color" && value="$text_color"
    printf '[AURELIA-BAR-TEXT] fallback reason=%s\n' "$reason" >&2
    printf '%s\n' "$value"
    exit 0
}

valid_hex "$text_color" || fallback invalid-text-color
valid_hex "$background_color" || fallback invalid-background-color
valid_hex "$scrim_color" || fallback invalid-scrim-color
[[ "$scrim_alpha" =~ ^[0-9]+(\.[0-9]+)?$ ]] || fallback invalid-scrim-alpha
[[ "$position" =~ ^(top|bottom|left|right)$ ]] || fallback invalid-position
[[ "$bar_size" =~ ^[0-9]+$ && "$bar_size" -gt 0 ]] || fallback invalid-bar-size

if [[ -z "$background_path" ]]; then
    home_dir="${HOME:-}"
    [[ "$home_dir" == /* && "$home_dir" != "/" ]] || fallback invalid-home
    state_home="${XDG_STATE_HOME:-$home_dir/.local/state}"
    [[ "$state_home" == /* && "$state_home" != "/" ]] || fallback invalid-state-home
    state_file="${state_home%/}/aurelia/current/background.path"
    if [[ -f "$state_file" && ! -L "$state_file" ]]; then
        IFS= read -r background_path <"$state_file" || true
    fi
fi

[[ "$background_path" == /* && "$background_path" != "/" ]] || fallback missing-background
[[ "$background_path" != *$'\n'* && "$background_path" != *$'\r'* ]] || fallback unsafe-background
[[ -f "$background_path" ]] || fallback background-not-file

if [[ -z "$screen_size" ]]; then
    if [[ -x /usr/bin/hyprctl && -x /usr/bin/jq ]]; then
        screen_size="$('/usr/bin/hyprctl' monitors -j  |
            '/usr/bin/jq' -r '.[0] | "\(.width)x\(.height)"'  || true)"
    fi
fi
[[ "$screen_size" =~ ^([0-9]+)x([0-9]+)$ ]] || fallback invalid-screen-size

screen_width="${BASH_REMATCH[1]}"
screen_height="${BASH_REMATCH[2]}"
(( screen_width > 0 && screen_height > 0 && bar_size <= screen_width && bar_size <= screen_height )) ||
    fallback invalid-screen-geometry

if [[ ! -x /usr/bin/magick ]]; then
    fallback missing-magick
fi

case "$position" in
    top)
        crop="${screen_width}x${bar_size}+0+0"
        ;;
    bottom)
        crop_y=$((screen_height - bar_size))
        crop="${screen_width}x${bar_size}+0+${crop_y}"
        ;;
    left)
        crop="${bar_size}x${screen_height}+0+0"
        ;;
    right)
        crop_x=$((screen_width - bar_size))
        crop="${bar_size}x${screen_height}+${crop_x}+0"
        ;;
esac

# Selecting frame zero keeps a video wallpaper bounded to one decode frame.
# Instead of collapsing the bar strip to one 1x1 average (which hides
# high-variance regions such as a black/white checkerboard), measure the
# darkest and brightest WCAG relative-luminance regions across the strip.
# Rec.709 luminance is the exact WCAG relative luminance, so the two
# endpoints bound the worst case for any candidate foreground. A transparent
# image is matted against a neutral mid-grey before measurement so it cannot
# be silently read as black or white.
luminance_range="$(/usr/bin/magick "${background_path}[0]" -auto-orient \
    -resize "${screen_width}x${screen_height}^" \
    -gravity center -extent "${screen_width}x${screen_height}" \
    -gravity NorthWest -crop "$crop" +repage \
    -colorspace sRGB -background '#808080' -alpha remove \
    -grayscale Rec709Luminance \
    -format '%[fx:minima] %[fx:maxima]' info:-  || true)"
[[ "$luminance_range" =~ ^([0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?)[[:space:]]+([0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?)$ ]] ||
    fallback sample-failed

sample_min="${BASH_REMATCH[1]}"
sample_max="${BASH_REMATCH[3]}"

# WCAG AA normal text requires a 4.5:1 contrast ratio. The helper still
# reports when the best available foreground cannot reach it, but it never
# substitutes an unreadable colour: the resident bar strengthens its
# bar-strip scrim in response to the signal.
minimum_contrast='4.5'

# Pick the candidate with the maximum worst-case contrast. The scrim that the
# resident bar draws behind the strip is composited over the sampled range
# first, so the foreground is chosen for the background that will actually be
# rendered. Compositing an opaque scrim over a luminance range is affine, so
# the darkest and brightest regions remain the endpoints after compositing.
selection="$(/usr/bin/awk \
    -v text="$text_color" -v background="$background_color" \
    -v lo="$sample_min" -v hi="$sample_max" \
    -v scrim="$scrim_color" -v alpha="$scrim_alpha" '
        function channel(hex, start) {
            return strtonum("0x" substr(hex, start, 2)) / 255
        }
        function linear(value) {
            return value <= 0.03928 ? value / 12.92 : ((value + 0.055) / 1.055) ^ 2.4
        }
        function luminance(hex, red, green, blue) {
            red = linear(channel(hex, 2))
            green = linear(channel(hex, 4))
            blue = linear(channel(hex, 6))
            return 0.2126 * red + 0.7152 * green + 0.0722 * blue
        }
        function ratio(first, second, swap) {
            if (first < second) {
                swap = first
                first = second
                second = swap
            }
            return (first + 0.05) / (second + 0.05)
        }
        function worst(candidate, candidate_luminance, low_ratio, high_ratio) {
            candidate_luminance = luminance(candidate)
            low_ratio = ratio(candidate_luminance, effective_low)
            high_ratio = ratio(candidate_luminance, effective_high)
            return low_ratio < high_ratio ? low_ratio : high_ratio
        }
        BEGIN {
            if (alpha + 0 < 0) alpha = 0
            if (alpha + 0 > 1) alpha = 1
            scrim_luminance = luminance(scrim)
            effective_low = alpha * scrim_luminance + (1 - alpha) * (lo + 0)
            effective_high = alpha * scrim_luminance + (1 - alpha) * (hi + 0)
            text_worst = worst(text)
            background_worst = worst(background)
            if (text_worst >= background_worst) {
                printf "%s\t%.6f\n", text, text_worst
            } else {
                printf "%s\t%.6f\n", background, background_worst
            }
        }
')"
[[ "$selection" == *$'\t'* ]] || fallback sample-failed
best_color="${selection%%$'\t'*}"
best_worst="${selection##*$'\t'}"

if '/usr/bin/awk' -v value="$best_worst" -v minimum="$minimum_contrast" \
    'BEGIN { exit !(value + 0 < minimum + 0) }'; then
    '/usr/bin/awk' -v worst="$best_worst" -v minimum="$minimum_contrast" '
        BEGIN {
            printf "[AURELIA-BAR-TEXT] fallback reason=insufficient-contrast worst=%.2f required=%s action=opaque\n", worst, minimum
        }
    ' >&2
fi

printf '%s\n' "$best_color"
