#!/usr/bin/env bash
# aurelia-restart-shell — restart only the selected Aurelia Quickshell config.

set -Eeuo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
source_shell_root="$(cd -- "$script_dir/.." && pwd -P)"
launcher="$script_dir/aurelia-launch-shell"

if [[ -f "$source_shell_root/shell.qml" && "${AURELIA_USE_INSTALLED_SHELL:-0}" != "1" ]]; then
    shell_root="$source_shell_root"
    development=1
else
    shell_root="${AURELIA_SHELL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/aurelia}"
    development="${AURELIA_DEVELOPMENT_MODE:-0}"
fi

[[ "$shell_root" == /* && "$shell_root" != "/" ]] || {
    printf 'Error: Aurelia shell path is not absolute: %s\n' "$shell_root" >&2
    exit 1
}
shell_root="$(readlink -f -- "$shell_root")" || {
    printf 'Error: Could not resolve Aurelia Shell path.\n' >&2
    exit 1
}
[[ -f "$shell_root/shell.qml" ]] || {
    printf 'Error: Aurelia Shell configuration not found: %s/shell.qml\n' "$shell_root" >&2
    exit 1
}
[[ -x "$launcher" ]] || {
    printf 'Error: Aurelia Shell launcher not found: %s\n' "$launcher" >&2
    exit 1
}

if [[ -n "${QUICKSHELL_BIN:-}" ]]; then
    qs_bin="$QUICKSHELL_BIN"
elif [[ -x /usr/bin/qs ]]; then
    qs_bin=/usr/bin/qs
elif qs_bin="$(command -v qs 2>/dev/null || true)"; [[ -n "$qs_bin" ]]; then
    :
else
    printf 'Error: Quickshell runtime binary was not found.\n' >&2
    exit 1
fi
[[ -x "$qs_bin" ]] || {
    printf 'Error: Quickshell runtime is not executable: %s\n' "$qs_bin" >&2
    exit 1
}

list_output="$($qs_bin list --path "$shell_root/shell.qml" 2>&1)" || {
    printf 'Error: Could not inspect the Aurelia Quickshell instance.\n%s\n' "$list_output" >&2
    exit 1
}
active_pid="$(printf '%s\n' "$list_output" | sed -n 's/^  Process ID: \([0-9][0-9]*\)$/\1/p' | head -n1)"
instance_id="$(printf '%s\n' "$list_output" | sed -n 's/^Instance \([^:][^:]*\):$/\1/p' | head -n1)"
shell_id="$(printf '%s\n' "$list_output" | sed -n 's/^  Shell ID: \([^[:space:]][^[:space:]]*\)$/\1/p' | head -n1)"
if [[ -n "$active_pid" ]] && ! kill -0 "$active_pid" 2>/dev/null; then
    # Quickshell can leave an instance record behind after a crash. An absent
    # PID is already stopped; do not turn a harmless stale record into a
    # restart failure or attempt to signal an unrelated recycled PID. Remove
    # only the exact runtime record returned by Quickshell, after validating
    # every path component and the symlink targets.
    runtime_dir="${XDG_RUNTIME_DIR:-}"
    [[ "$runtime_dir" =~ ^/run/user/[0-9]+$ ]] || {
        printf 'Error: Cannot safely recover a stale Quickshell instance without a standard runtime directory.\n' >&2
        exit 1
    }
    [[ "$instance_id" =~ ^[A-Za-z0-9_-]+$ && "$shell_id" =~ ^[A-Za-z0-9_-]+$ ]] || {
        printf 'Error: Cannot safely recover a stale Quickshell instance with invalid runtime identifiers.\n' >&2
        exit 1
    }
    stale_instance_dir="$runtime_dir/quickshell/by-id/$instance_id"
    stale_shell_link="$runtime_dir/quickshell/by-shell/$shell_id/$instance_id"
    stale_pid_link="$runtime_dir/quickshell/by-pid/$active_pid"
    [[ -d "$stale_instance_dir" && ! -L "$stale_instance_dir" ]] || {
        printf 'Error: Cannot safely recover the stale Quickshell instance directory.\n' >&2
        exit 1
    }
    if [[ -L "$stale_shell_link" ]]; then
        [[ "$(readlink -- "$stale_shell_link")" == "$stale_instance_dir" ]] || {
            printf 'Error: Stale Quickshell shell link does not resolve to the reported instance.\n' >&2
            exit 1
        }
    elif [[ -e "$stale_shell_link" ]]; then
        printf 'Error: Stale Quickshell shell link is not a symlink.\n' >&2
        exit 1
    fi
    if [[ -L "$stale_pid_link" ]]; then
        [[ "$(readlink -- "$stale_pid_link")" == "$stale_instance_dir" ]] || {
            printf 'Error: Stale Quickshell PID link does not resolve to the reported instance.\n' >&2
            exit 1
        }
    elif [[ -e "$stale_pid_link" ]]; then
        printf 'Error: Stale Quickshell PID link is not a symlink.\n' >&2
        exit 1
    fi
    rm -f -- "$stale_shell_link" "$stale_pid_link"
    rm -rf -- "$stale_instance_dir"
    active_pid=""
fi
if [[ -n "$active_pid" ]]; then
    "$qs_bin" kill --pid "$active_pid" >/dev/null || {
        printf 'Error: Could not stop the existing Aurelia Shell instance (pid %s).\n' "$active_pid" >&2
        exit 1
    }
    for _ in 1 2 3 4 5; do
        if ! kill -0 "$active_pid" 2>/dev/null; then
            break
        fi
        sleep 0.2
    done
    if kill -0 "$active_pid" 2>/dev/null; then
        printf 'Error: Aurelia Shell instance (pid %s) did not stop in time.\n' "$active_pid" >&2
        exit 1
    fi
fi

printf 'Restarting Aurelia Shell: %s\n' "$shell_root"
if [[ "$development" == "1" || "$shell_root" == "$source_shell_root" ]]; then
    exec env AURELIA_DEVELOPMENT_MODE=1 AURELIA_SHELL_ROOT="$shell_root" QUICKSHELL_BIN="$qs_bin" "$launcher"
fi
exec env AURELIA_USE_INSTALLED_SHELL=1 QUICKSHELL_BIN="$qs_bin" "$launcher"
