#!/usr/bin/env python3
"""Compatibility shim: Herdr notification "Open" -> the single focus owner.

The one owner of "focus the origin" is ``workstation-notification-focus``.
This file only translates the historical ``workstation-herdr-focus [N]``
invocation into a ``navigate --origin`` call.  It contains no focus logic of
its own.
"""

from __future__ import annotations

import json
import os
import shutil
import sys

HELPER_NAME = "workstation-notification-focus"


def helper_path() -> str:
    here = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(here, HELPER_NAME)
    if os.path.exists(candidate):
        return candidate
    found = shutil.which(HELPER_NAME)
    return found or candidate


def build_origin(workspace: str) -> dict:
    return {
        "originVersion": 1,
        "captureQuality": "identity",
        "captureSource": "identity",
        "notify": {"appName": "Herdr", "desktopEntry": "Herdr"},
        "sender": {"ancestry": [], "focusEnv": {}},
        "compositor": {"matched": False, "matchConfidence": "none", "candidates": []},
        "tab": {
            "kind": "herdr",
            "workspaceId": workspace or None,
            "tabId": None,
            "paneId": None,
        },
    }


def main() -> int:
    workspace = ""
    dry_run = False
    for arg in sys.argv[1:]:
        if arg == "--dry-run":
            dry_run = True
        elif arg.startswith("-"):
            continue
        else:
            workspace = arg

    helper = helper_path()
    argv = [helper, "navigate", "--origin", json.dumps(build_origin(workspace))]
    if dry_run:
        argv.append("--dry-run")
    try:
        os.execv(helper, argv)
    except Exception:
        sys.stdout.write(
            json.dumps(
                {
                    "action": "navigate",
                    "outcome": "unavailable",
                    "confidence": "none",
                    "reason": "workstation-notification-focus unavailable",
                }
            )
            + "\n"
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
