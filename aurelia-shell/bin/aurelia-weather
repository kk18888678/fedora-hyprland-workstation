#!/usr/bin/env bash
# aurelia-weather — bounded Omarchy-compatible weather location flow.

set -Eeuo pipefail
umask 077

usage() {
    cat <<'USAGE'
Usage: aurelia-weather fetch [location options] [--units metric|imperial]

Location options:
  --auto                         Detect city from the public IP via wttr.in (default)
  --location <city>              Resolve a pinned city through Open-Meteo geocoding
  --latitude <degrees> --longitude <degrees>
                                 Use exact coordinates

Automatic mode is compatible with Omarchy's default behavior. It is not GPS;
the weather service receives the request's public IP. Pin a city or coordinates
to avoid IP-based location inference.
USAGE
}

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

command_name="${1:-}"
[[ "$command_name" == "fetch" ]] || {
    usage
    [[ "$command_name" == "" || "$command_name" == "--help" || "$command_name" == "-h" ]] && exit 0
    exit 1
}
shift

latitude=""
longitude=""
location=""
location_mode="auto"
units="metric"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --auto)
            [[ "$location_mode" == "auto" ]] || fail "location options are mutually exclusive"
            location_mode="auto"
            shift
            ;;
        --location)
            [[ $# -ge 2 ]] || fail "--location requires a value"
            [[ "$location_mode" == "auto" || "$location_mode" == "location" ]] || fail "location options are mutually exclusive"
            location="$2"
            location_mode="location"
            shift 2
            ;;
        --latitude)
            [[ $# -ge 2 ]] || fail "--latitude requires a value"
            [[ "$location_mode" == "auto" || "$location_mode" == "coordinates" ]] || fail "location options are mutually exclusive"
            latitude="$2"
            location_mode="coordinates"
            shift 2
            ;;
        --longitude)
            [[ $# -ge 2 ]] || fail "--longitude requires a value"
            [[ "$location_mode" == "auto" || "$location_mode" == "coordinates" ]] || fail "location options are mutually exclusive"
            longitude="$2"
            location_mode="coordinates"
            shift 2
            ;;
        --units)
            [[ $# -ge 2 ]] || fail "--units requires a value"
            units="$2"
            shift 2
            ;;
        *)
            fail "Unknown argument: $1"
            ;;
    esac
done

[[ "$units" == "metric" || "$units" == "imperial" ]] || fail "units must be metric or imperial"
[[ "$location" == "" || "${#location}" -le 100 ]] || fail "location is limited to 100 characters"

if [[ "$location_mode" == "coordinates" ]]; then
    [[ "$latitude" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || fail "latitude must be numeric"
    [[ "$longitude" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || fail "longitude must be numeric"
    awk -v value="$latitude" 'BEGIN { exit !(value >= -90 && value <= 90) }' || fail "latitude is outside -90..90"
    awk -v value="$longitude" 'BEGIN { exit !(value >= -180 && value <= 180) }' || fail "longitude is outside -180..180"
fi

if [[ "$location_mode" == "coordinates" && ( -z "$latitude" || -z "$longitude" ) ]]; then
    fail "both latitude and longitude are required"
fi

curl_bin="$(command -v curl 2>/dev/null || true)"
jq_bin="$(command -v jq 2>/dev/null || true)"
[[ -x "$curl_bin" ]] || fail "curl is required"
[[ -x "$jq_bin" ]] || fail "jq is required"

request_json() {
    local endpoint="$1"
    shift
    "$curl_bin" \
        --silent --show-error --fail --location \
        --proto '=https' --tlsv1.2 \
        --connect-timeout 3 --max-time 5 --max-filesize 1048576 \
        --get "$endpoint" "$@"
}

temperature_unit="celsius"
[[ "$units" == "imperial" ]] && temperature_unit="fahrenheit"

resolved_location=""
if [[ "$location_mode" == "auto" ]]; then
    response="$(request_json 'https://wttr.in/' --data-urlencode 'format=j1')" || fail "automatic weather location request failed"
    location_data="$(printf '%s' "$response" | "$jq_bin" -ce '
        .nearest_area[0]
        | select((.latitude | type) == "string")
        | select((.longitude | type) == "string")
        | {
            latitude: (.latitude | tonumber),
            longitude: (.longitude | tonumber),
            area: (.areaName[0].value // ""),
            region: (.region[0].value // "")
          }
        | . as $location
        | $location + {
            city: (
                if ($location.region != "" and ($location.area | startswith($location.region)))
                then $location.region
                else $location.area
                end
            )
          }
    ')" || fail "automatic weather location response was invalid"
    latitude="$(printf '%s' "$location_data" | "$jq_bin" -r '.latitude')"
    longitude="$(printf '%s' "$location_data" | "$jq_bin" -r '.longitude')"
    resolved_location="$(printf '%s' "$location_data" | "$jq_bin" -r '.city // empty')"
    location_mode="coordinates"
fi

if [[ "$location_mode" == "location" ]]; then
    geocode_response="$(request_json 'https://geocoding-api.open-meteo.com/v1/search' \
        --data-urlencode "name=$location" \
        --data-urlencode 'count=1' \
        --data-urlencode 'language=en' \
        --data-urlencode 'format=json')" || fail "weather location lookup failed"
    geocode="$(printf '%s' "$geocode_response" | "$jq_bin" -ce '
        .results[0]
        | select((.latitude | type) == "number")
        | select((.longitude | type) == "number")
        | {latitude, longitude, name}
    ')" || fail "weather location was not found"
    latitude="$(printf '%s' "$geocode" | "$jq_bin" -r '.latitude')"
    longitude="$(printf '%s' "$geocode" | "$jq_bin" -r '.longitude')"
    resolved_location="$(printf '%s' "$geocode" | "$jq_bin" -r '.name // empty')"
fi

response="$(request_json 'https://api.open-meteo.com/v1/forecast' \
    --data-urlencode "latitude=$latitude" \
    --data-urlencode "longitude=$longitude" \
    --data-urlencode 'current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,weather_code,is_day' \
    --data-urlencode 'daily=weather_code,temperature_2m_max,temperature_2m_min,wind_speed_10m_max' \
    --data-urlencode 'forecast_days=3' \
    --data-urlencode "temperature_unit=$temperature_unit" \
    --data-urlencode "wind_speed_unit=$([[ "$units" == "imperial" ]] && echo mph || echo kmh)" \
    --data-urlencode 'timezone=auto')" || fail "weather forecast request failed"

printf '%s' "$response" | "$jq_bin" -ce --arg location "${resolved_location:-$location}" '
    . as $root
    | .current
    | select((.temperature_2m | type) == "number")
    | select((.apparent_temperature | type) == "number")
    | select((.relative_humidity_2m | type) == "number")
    | select((.wind_speed_10m | type) == "number")
    | select((.weather_code | type) == "number")
    | select((.is_day | type) == "number")
    as $current
    | {
        temperature: $current.temperature_2m,
        apparentTemperature: $current.apparent_temperature,
        humidity: $current.relative_humidity_2m,
        windSpeed: $current.wind_speed_10m,
        weatherCode: $current.weather_code,
        isDay: $current.is_day,
        condition: "",
        location: $location,
        forecast: [range(0; ($root.daily.time | length)) | {
            date: $root.daily.time[.],
            weatherCode: $root.daily.weather_code[.],
            max: $root.daily.temperature_2m_max[.],
            min: $root.daily.temperature_2m_min[.],
            windSpeed: $root.daily.wind_speed_10m_max[.]
        }]
      }
' || fail "weather forecast response was invalid"
