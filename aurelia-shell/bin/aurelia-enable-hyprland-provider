#!/usr/bin/env bash
# aurelia-enable-hyprland-provider — explicit Hyprland provider registration.

set -Eeuo pipefail

usage() {
    cat <<'USAGE'
Usage: aurelia-enable-hyprland-provider <enable|disable|status>

enable   Install the user-owned Aurelia provider bridge.
disable  Remove only the provider file created by this command.
status   Report whether the provider is installed.

After enable, reload Hyprland explicitly:
  hyprctl reload
USAGE
}

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

command_name="${1:-}"
case "$command_name" in
    enable|disable|status) ;;
    -h|--help|"")
        usage
        exit 0
        ;;
    *) fail "Unknown command: $command_name" ;;
esac

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
shell_root="$(cd -- "$script_dir/.." && pwd -P)"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
[[ "$config_home" == /* && "$config_home" != "/" ]] || fail "XDG_CONFIG_HOME must be absolute."
config_dir="$config_home/aurelia"
provider_path="$config_dir/hyprland-provider.lua"
marker="AURELIA_HYPRLAND_PROVIDER_MANAGED_V1"

if [[ "$command_name" == "status" ]]; then
    if [[ -f "$provider_path" ]] && grep -q "$marker" "$provider_path"; then
        printf '%s\n' "enabled: $provider_path"
    else
        printf '%s\n' "disabled: $provider_path"
    fi
    exit 0
fi

if [[ "$command_name" == "disable" ]]; then
    [[ -e "$provider_path" ]] || {
        printf '%s\n' "Already disabled: $provider_path"
        exit 0
    }
    [[ ! -L "$provider_path" ]] || fail "Refusing to remove symlink provider: $provider_path"
    grep -q "$marker" "$provider_path" ||
        fail "Refusing to remove an unmanaged provider file: $provider_path"
    rm -f -- "$provider_path"
    printf '%s\n' "Disabled Aurelia Hyprland provider."
    exit 0
fi

if [[ -L "$config_dir" ]]; then
    fail "Aurelia config directory is a symlink: $config_dir"
fi
mkdir -p -m 0700 -- "$config_dir"

if [[ -e "$provider_path" ]]; then
    [[ -f "$provider_path" ]] || fail "Provider target is not a regular file: $provider_path"
    grep -q "$marker" "$provider_path" ||
        fail "Refusing to overwrite unmanaged provider file: $provider_path"
fi

[[ "$shell_root" != *'"'* && "$shell_root" != *'\'* && "$shell_root" != *$'\n'* ]] ||
    fail "Aurelia source path contains unsupported characters."

provider_tmp="$(mktemp "$config_dir/.hyprland-provider.lua.XXXXXX")" ||
    fail "Could not create provider staging file."
cleanup() {
    rm -f -- "$provider_tmp"
}
trap cleanup EXIT

cat >"$provider_tmp" <<EOF_PROVIDER
-- $marker
-- Generated by aurelia-enable-hyprland-provider.
local aurelia_shell_root = "$shell_root"
package.path = aurelia_shell_root .. "/dotfiles/hypr/?.lua;" .. package.path
return dofile(aurelia_shell_root .. "/dotfiles/hypr/keybind.lua")
EOF_PROVIDER

chmod 0600 -- "$provider_tmp"
mv -f -- "$provider_tmp" "$provider_path"
trap - EXIT

printf '%s\n' "Enabled Aurelia Hyprland provider: $provider_path"
printf '%s\n' "Run: hyprctl reload"
