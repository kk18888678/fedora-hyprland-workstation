#!/usr/bin/env bash
# aurelia-bar — Aurelia Shell bar layout and widget settings CLI.

set -Eeuo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
export AURELIA_PLUGIN_BIN_DIR="$script_dir"
lib_dir="$script_dir/lib/aurelia-plugin"
if [[ ! -d "$lib_dir" && -d "$script_dir/../lib/aurelia-plugin" ]]; then
    lib_dir="$script_dir/../lib/aurelia-plugin"
fi

for module in common placement bar; do
    module_path="$lib_dir/$module.sh"
    if [[ ! -f "$module_path" ]]; then
        printf 'Error: Missing Aurelia bar module: %s\n' "$module_path" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$module_path"
done

aurelia_bar_main "$@"
