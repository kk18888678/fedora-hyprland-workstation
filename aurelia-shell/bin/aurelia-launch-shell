#!/usr/bin/env bash
# aurelia-launch-shell — start the single resident Aurelia Shell host.

set -Eeuo pipefail

shell_root="${XDG_CONFIG_HOME:-$HOME/.config}/aurelia"
if [[ "${AURELIA_DEVELOPMENT_MODE:-0}" == "1" || "${WORKSTATION_TEST_MODE:-0}" == "1" ]] &&
   [[ -n "${AURELIA_SHELL_ROOT:-}" ]]; then
    shell_root="$AURELIA_SHELL_ROOT"
fi
[[ "$shell_root" == /* && "$shell_root" != "/" ]] || {
    printf 'Error: Aurelia shell path is not absolute.\n' >&2
    exit 1
}
[[ -f "$shell_root/shell.qml" ]] || {
    printf 'Error: Aurelia Shell configuration not found: %s/shell.qml\n' "$shell_root" >&2
    exit 1
}

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
[[ "$config_home" == /* && "$config_home" != "/" ]] || {
    printf 'Error: Aurelia config directory is not an absolute path.\n' >&2
    exit 1
}
config_dir="$config_home/aurelia"
config_file="$config_dir/shell.json"
if [[ -L "$config_dir" ]]; then
    printf 'Error: Aurelia config directory is a symlink; migrate it to a real directory: %s\n' "$config_dir" >&2
    exit 1
fi
mkdir -p -m 0700 "$config_dir"
if [[ ! -e "$config_file" ]]; then
    [[ ! -L "$config_file" ]] || {
        printf 'Error: Aurelia shell state file is a symlink: %s\n' "$config_file" >&2
        exit 1
    }
    config_tmp="$(mktemp "$config_dir/.shell.json.XXXXXX")" || {
        printf 'Error: Could not initialize Aurelia shell state.\n' >&2
        exit 1
    }
    trap 'rm -f -- "${config_tmp:-}"' EXIT
    umask 077
    printf '%s\n' '{"version":1,"plugins":[],"disabledPlugins":[]}' >"$config_tmp"
    chmod 0600 "$config_tmp"
    mv -f -- "$config_tmp" "$config_file"
    trap - EXIT
    config_tmp=""
fi
shell_root="$(readlink -f -- "$shell_root")" || {
    printf 'Error: Could not resolve Aurelia Shell path: %s\n' "$shell_root" >&2
    exit 1
}
[[ -f "$shell_root/shell.qml" ]] || {
    printf 'Error: Resolved Aurelia Shell configuration is missing: %s/shell.qml\n' "$shell_root" >&2
    exit 1
}

# A source checkout may be linked into ~/.config/aurelia during development.
# Pass its sibling backend explicitly so the QML plugin does not fall through
# to the production-only /usr/local/bin path.
development_backend="$shell_root/bin/workstation-keybindings"
if [[ -x "$development_backend" && -z "${AURELIA_SHELL_KEYBINDINGS_BIN:-}" ]]; then
    export AURELIA_DEVELOPMENT_MODE=1
    export AURELIA_SHELL_KEYBINDINGS_BIN="$development_backend"
fi

qs_bin=""
if [[ "${AURELIA_DEVELOPMENT_MODE:-0}" == "1" || "${WORKSTATION_TEST_MODE:-0}" == "1" ]] &&
   [[ -n "${QUICKSHELL_BIN:-}" && -x "$QUICKSHELL_BIN" ]]; then
    qs_bin="$QUICKSHELL_BIN"
elif [[ "${WORKSTATION_TEST_MODE:-0}" == "1" ]] && command -v qs >/dev/null 2>&1; then
    qs_bin="$(command -v qs)"
elif [[ -x "/usr/bin/qs" ]]; then
    qs_bin="/usr/bin/qs"
elif [[ -x "/usr/bin/quickshell" ]]; then
    qs_bin="/usr/bin/quickshell"
else
    printf 'Error: Quickshell runtime binary not found.\n' >&2
    exit 1
fi

exec "$qs_bin" --no-duplicate --path "$shell_root/shell.qml"
