#!/usr/bin/env bash
# aurelia-shell-keybindings — canonical Keybindings command
#
# The entrypoint is intentionally small. It wires the bounded modules together
# and leaves data, mutation, diagnostics, and IPC ownership in one module each.

set -Eeuo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
export AURELIA_KEYBINDINGS_BIN_DIR="$script_dir"

lib_dir=""
if [[ -d "$script_dir/lib/aurelia-keybindings" ]]; then
    lib_dir="$script_dir/lib/aurelia-keybindings"
elif [[ -d "$script_dir/../lib/aurelia-keybindings" ]]; then
    lib_dir="$script_dir/../lib/aurelia-keybindings"
else
    printf '%s\n' "Error: Aurelia Keybindings runtime modules are not installed." >&2
    exit 1
fi
export AURELIA_KEYBINDINGS_LIB_DIR="$(cd -- "$lib_dir" && pwd -P)"

for module in common queries actions mutations runtime toggle main; do
    module_path="$AURELIA_KEYBINDINGS_LIB_DIR/$module.sh"
    if [[ ! -f "$module_path" ]]; then
        printf 'Error: Missing Aurelia Keybindings module: %s\n' "$module_path" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$module_path"
done

main "$@"
